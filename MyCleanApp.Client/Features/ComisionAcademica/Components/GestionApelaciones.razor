@using MyCleanApp.Client.DTOs
@using System.Text.Json
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using MudBlazor
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudPaper Elevation="1" Class="pa-6">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" />
                Sistema de Apelaciones
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Gestión de apelaciones según Art. 11 del Reglamento UTA - Plazos de 3 días hábiles
            </MudText>
        </div>
    </div>

    <!-- Alertas de Plazos Críticos -->
    @if (apelacionesVenciendo.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-6">
            <div class="d-flex align-center mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
                <MudText Typo="Typo.h6">Apelaciones con Plazos Críticos</MudText>
            </div>
            <div class="d-flex flex-column gap-2">
                @foreach (var apelacion in apelacionesVenciendo)
                {
                    <MudText Typo="Typo.body2">
                        • <strong>@apelacion.DocenteNombre</strong> - Plazo vence en @apelacion.HorasRestantes horas
                    </MudText>
                }
            </div>
        </MudAlert>
    }

    @if (loading)
    {
        <div class="d-flex justify-center align-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Class="ml-3">Cargando apelaciones...</MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @errorMessage
        </MudAlert>
    }
    else
    {
        <!-- Pestañas del Sistema de Apelaciones -->
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="Apelaciones Recibidas" Icon="@Icons.Material.Filled.Mail">
                <ChildContent>
                    @if (apelacionesRecibidas.Count > 0)
                    {
                        <MudBadge Content="@apelacionesRecibidas.Count" Color="Color.Error" Overlap="true" Class="mx-16 my-4">
                            @RenderApelacionesRecibidas()
                        </MudBadge>
                    }
                    else
                    {
                        @RenderApelacionesRecibidas()
                    }
                </ChildContent>
            </MudTabPanel>
            
            <MudTabPanel Text="En Proceso" Icon="@Icons.Material.Filled.HourglassEmpty">
                <ChildContent>
                    @if (apelacionesEnProceso.Count > 0)
                    {
                        <MudBadge Content="@apelacionesEnProceso.Count" Color="Color.Warning" Overlap="true" Class="mx-16 my-4">
                            @RenderApelacionesEnProceso()
                        </MudBadge>
                    }
                    else
                    {
                        @RenderApelacionesEnProceso()
                    }
                </ChildContent>
            </MudTabPanel>
            
          
        </MudTabs>
    }
</MudPaper>

<!-- Modal de Proceso de Apelación usando MudBlazor -->
@if (mostrarModalProcesamiento && apelacionSeleccionada != null)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudCard Style="max-width: 900px; margin: auto; margin-top: 20px; max-height: 90vh; overflow-y: auto;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" />
                        Procesamiento de Apelación
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton StartIcon="@Icons.Material.Filled.Close" 
                             Color="Color.Secondary" 
                             OnClick="CerrarModalProcesamiento">
                        Cerrar
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            
            <MudCardContent>
                <MudStack Spacing="6">
                    <!-- Información de la Apelación -->
                    <MudCard Elevation="1" Class="pa-4" Style="background-color: #e3f2fd;">
                        <MudText Typo="Typo.h6" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" />
                            Información de la Apelación
                        </MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudText Typo="Typo.body2"><strong>Docente:</strong> @apelacionSeleccionada.DocenteNombre</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.body2"><strong>Promoción Solicitada:</strong> @apelacionSeleccionada.PromocionSolicitada</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.body2"><strong>Fecha Presentación:</strong> @apelacionSeleccionada.FechaPresentacion.ToString("dd/MM/yyyy HH:mm")</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.body2">
                                    <strong>Plazo Límite:</strong> 
                                    <span style="@(apelacionSeleccionada.HorasRestantes <= 24 ? "color: red; font-weight: bold;" : "")">
                                        @apelacionSeleccionada.FechaLimite.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.body2"><strong>Motivo Principal:</strong> @apelacionSeleccionada.MotivoApelacion</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.body2">
                                    <strong>Estado:</strong> 
                                    <MudChip T="string" Color="@GetEstadoColorMud(apelacionSeleccionada.Estado)" Size="Size.Small">
                                        @apelacionSeleccionada.Estado
                                    </MudChip>
                                </MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCard>

                    <!-- Documentos de la Apelación -->
                    <MudExpansionPanels Elevation="1">
                        <MudExpansionPanel Text="Documentos Adjuntos" Icon="@Icons.Material.Filled.Attachment">
                            @if (apelacionSeleccionada.DocumentosAdjuntos.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No hay documentos adjuntos.</MudText>
                            }
                            else
                            {
                                <MudStack Spacing="2">
                                    @foreach (var documento in apelacionSeleccionada.DocumentosAdjuntos)
                                    {
                                        <MudCard Elevation="0" Class="pa-2" Style="background-color: #f5f5f5;">
                                            <div class="d-flex justify-space-between align-center">
                                                <div class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Primary" Class="mr-2" />
                                                    <MudText Typo="Typo.body2">@documento.Nombre</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">(@documento.Tamano)</MudText>
                                                </div>
                                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">Ver</MudButton>
                                            </div>
                                        </MudCard>
                                    }
                                </MudStack>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    <!-- Fundamentos de la Apelación -->
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Article" Class="mr-2" />
                            Fundamentos de la Apelación
                        </MudText>
                        <MudPaper Elevation="0" Class="pa-3" Style="background-color: #f5f5f5;">
                            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@apelacionSeleccionada.Fundamentos</MudText>
                        </MudPaper>
                    </MudCard>

                    <!-- Decisión de la Apelación -->
                    <MudCard Elevation="1" Class="pa-4" Style="background-color: #fff3e0;">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" />
                            Decisión de la Comisión
                        </MudText>
                        <MudStack Spacing="3">
                            <!-- Decisión -->
                            <MudSelect T="string" @bind-Value="decisionComision" Label="Decisión" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("")">-- Seleccione --</MudSelectItem>
                                <MudSelectItem T="string" Value="@("APELACION_ACEPTADA")">APROBAR - Revisar evaluación</MudSelectItem>
                                <MudSelectItem T="string" Value="@("APELACION_RECHAZADA")">RECHAZAR - Mantener decisión</MudSelectItem>
                            </MudSelect>

                            <!-- Observaciones -->
                            <MudTextField @bind-Value="fundamentosDecision"
                                        Label="Observaciones de la Decisión"
                                        Variant="Variant.Outlined"
                                        Lines="3"
                                        Placeholder="Escriba las observaciones de la decisión..." />
                        </MudStack>
                    </MudCard>
                </MudStack>
            </MudCardContent>

            <MudCardActions Class="pa-6" Style="background-color: #f5f5f5;">
                <div class="d-flex justify-space-between align-center w-100">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-1" />
                        Tiempo restante: @apelacionSeleccionada.HorasRestantes horas
                    </MudText>
                    <MudStack Direction="Row" Spacing="3">
                        <MudButton OnClick="CerrarModalProcesamiento" 
                                 Color="Color.Secondary">
                            Cancelar
                        </MudButton>
                        <MudButton OnClick="GuardarBorrador" 
                                 StartIcon="@Icons.Material.Filled.Save"
                                 Color="Color.Warning"
                                 Variant="Variant.Filled">
                            Guardar Borrador
                        </MudButton>
                        <MudButton OnClick="FinalizarApelacion" 
                                 StartIcon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success"
                                 Variant="Variant.Filled"
                                 Disabled="@(string.IsNullOrEmpty(decisionComision) || string.IsNullOrEmpty(fundamentosDecision))">
                            Finalizar Apelación
                        </MudButton>
                    </MudStack>
                </div>
            </MudCardActions>
        </MudCard>
    </MudOverlay>
}

@code {
    private string activeTab = "recibidas";
    private bool loading = false;
    private string? errorMessage;
    
    // Datos de apelaciones
    private List<ApelacionDto> apelacionesRecibidas = new();
    private List<ApelacionDto> apelacionesEnProceso = new();
    private List<ApelacionDto> apelacionesResueltas = new();
    private List<ApelacionDto> apelacionesVenciendo = new();
    
    // Modal de procesamiento
    private bool mostrarModalProcesamiento = false;
    private ApelacionDto? apelacionSeleccionada;
    private string decisionComision = "";
    private string fundamentosDecision = "";
    private List<VerificacionProcedimientoDto> verificacionesProcedimiento = new();

    public class ApelacionDto
    {
        public int Id { get; set; }
        public string DocenteNombre { get; set; } = "";
        public string PromocionSolicitada { get; set; } = "";
        public DateTime FechaPresentacion { get; set; }
        public DateTime FechaLimite { get; set; }
        public string MotivoApelacion { get; set; } = "";
        public string Fundamentos { get; set; } = "";
        public string Estado { get; set; } = "";
        public List<DocumentoDto> DocumentosAdjuntos { get; set; } = new();
        public string? DecisionFinal { get; set; }
        public string? FundamentosDecision { get; set; }
        public DateTime? FechaResolucion { get; set; }
        
        public int HorasRestantes => Math.Max(0, (int)(FechaLimite - DateTime.Now).TotalHours);
        public bool EsCritico => HorasRestantes <= 24;
    }

    public class DocumentoDto
    {
        public string Nombre { get; set; } = "";
        public string Tamano { get; set; } = "";
        public string Tipo { get; set; } = "";
    }

    public class VerificacionProcedimientoDto
    {
        public string Descripcion { get; set; } = "";
        public bool Verificado { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarApelaciones();
    }

    private string MapearEstadoApelacion(string estadoSolicitud)
    {
        return estadoSolicitud switch
        {
            "EN_APELACION" => "RECIBIDA",
            "APELACION_RECHAZADA" => "RESUELTA",
            _ => "RECIBIDA"
        };
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    private async Task CargarApelaciones()
    {
        loading = true;
        try
        {
            // Cargar solicitudes en estado de apelación desde el endpoint real
            var response = await Http.GetAsync("http://localhost:5015/api/SolicitudAvanceRango");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var todasLasSolicitudes = JsonSerializer.Deserialize<List<dynamic>>(json, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<dynamic>();

                // Convertir solicitudes a formato de apelaciones
                var apelaciones = new List<ApelacionDto>();
                
                foreach (var s in todasLasSolicitudes)
                {
                    var elemento = JsonSerializer.Deserialize<JsonElement>(s.ToString());
                    var estado = elemento.GetProperty("estado").GetString() ?? "";
                    
                    if (estado == "EN_APELACION" || estado == "APELACION_RECHAZADA")
                    {
                        // Determinar fecha de resolución si existe
                        DateTime? fechaResolucion = null;
                        if (estado == "APELACION_RECHAZADA")
                        {
                            if (elemento.TryGetProperty("fechaRespuesta", out JsonElement fechaRespElement) &&
                                fechaRespElement.ValueKind != JsonValueKind.Null)
                            {
                                fechaResolucion = fechaRespElement.GetDateTime();
                            }
                        }

                        var apelacion = new ApelacionDto
                        {
                            Id = elemento.GetProperty("id").GetInt32(),
                            DocenteNombre = elemento.GetProperty("docenteNombre").GetString() ?? "Docente Desconocido",
                            PromocionSolicitada = $"De {elemento.GetProperty("nivelActual").GetString()} a {elemento.GetProperty("nuevoNivel").GetString()}",
                            FechaPresentacion = elemento.GetProperty("fechaSolicitud").GetDateTime(),
                            FechaLimite = elemento.GetProperty("fechaSolicitud").GetDateTime().AddDays(3),
                            MotivoApelacion = "Desacuerdo con la decisión de la comisión",
                            Fundamentos = elemento.GetProperty("observaciones").GetString() ?? "Sin fundamentos especificados",
                            Estado = MapearEstadoApelacion(estado),
                            DecisionFinal = estado == "APELACION_RECHAZADA" ? "RECHAZADA" : null,
                            FechaResolucion = fechaResolucion,
                            DocumentosAdjuntos = new List<DocumentoDto>()
                        };
                        apelaciones.Add(apelacion);
                    }
                }

                // Filtrar por estado mapeado
                apelacionesRecibidas = apelaciones.Where(a => a.Estado == "RECIBIDA").ToList();
                apelacionesEnProceso = apelaciones.Where(a => a.Estado == "EN_PROCESO").ToList();
                apelacionesResueltas = apelaciones.Where(a => a.Estado == "RESUELTA").ToList();

                // Identificar apelaciones con plazos críticos
                apelacionesVenciendo = apelacionesRecibidas
                    .Concat(apelacionesEnProceso)
                    .Where(a => a.EsCritico)
                    .OrderBy(a => a.FechaLimite)
                    .ToList();
            }

            // Cargar verificaciones de procedimiento desde el backend
            var verificacionesResponse = await Http.GetAsync("http://localhost:5015/api/Apelaciones/verificaciones-procedimiento");
            if (verificacionesResponse.IsSuccessStatusCode)
            {
                var verificacionesJson = await verificacionesResponse.Content.ReadAsStringAsync();
                verificacionesProcedimiento = JsonSerializer.Deserialize<List<VerificacionProcedimientoDto>>(verificacionesJson,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<VerificacionProcedimientoDto>
                {
                    new() { Descripcion = "Apelación presentada dentro del plazo de 3 días hábiles", Verificado = false },
                    new() { Descripcion = "Documentos de respaldo adjuntos y completos", Verificado = false },
                    new() { Descripcion = "Fundamentos claramente expresados", Verificado = false },
                    new() { Descripcion = "Firma del docente y fecha de presentación", Verificado = false },
                    new() { Descripcion = "Competencia de la Comisión Académica confirmada", Verificado = false }
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar apelaciones: {ex.Message}";
            // En caso de error, inicializar listas vacías
            apelacionesRecibidas = new List<ApelacionDto>();
            apelacionesEnProceso = new List<ApelacionDto>();
            apelacionesResueltas = new List<ApelacionDto>();
            apelacionesVenciendo = new List<ApelacionDto>();
            verificacionesProcedimiento = new List<VerificacionProcedimientoDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private RenderFragment RenderApelacionesRecibidas() => __builder =>
    {
        <MudStack Spacing="4">
            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Mail" Class="mr-2" />
                    Apelaciones Recibidas - Pendientes de Procesamiento
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Plazo máximo de resolución: 3 días hábiles</MudText>
            </div>
            
            @if (apelacionesRecibidas.Count == 0)
            {
                <MudPaper Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">
                        No hay apelaciones recibidas pendientes.
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="3">
                    @foreach (var apelacion in apelacionesRecibidas.OrderBy(a => a.FechaLimite))
                    {
                        <MudCard Elevation="2" Class="@(apelacion.EsCritico ? "border-solid border-2 mud-border-error" : "")">
                            <MudCardContent Class="pa-4">
                                <div class="d-flex justify-space-between align-start">
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.h6">@apelacion.DocenteNombre</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@apelacion.PromocionSolicitada</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Motivo: @apelacion.MotivoApelacion</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                            Presentada: @apelacion.FechaPresentacion.ToString("dd/MM/yyyy HH:mm")
                                            | Límite: @apelacion.FechaLimite.ToString("dd/MM/yyyy HH:mm")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="@(apelacion.EsCritico ? Color.Error : Color.Secondary)" Class="mt-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                                            @apelacion.HorasRestantes horas restantes
                                            @if (apelacion.EsCritico)
                                            {
                                                <strong> - ¡CRÍTICO!</strong>
                                            }
                                        </MudText>
                                    </div>
                                    <MudStack Direction="Row" Spacing="2">
                                        <MudButton OnClick="@(() => ProcesarApelacion(apelacion))"
                                                 StartIcon="@Icons.Material.Filled.Gavel"
                                                 Color="@(apelacion.EsCritico ? Color.Error : Color.Primary)"
                                                 Variant="Variant.Filled"
                                                 Size="Size.Small">
                                            Procesar
                                        </MudButton>
                                        <MudButton StartIcon="@Icons.Material.Filled.Visibility"
                                                 Color="Color.Secondary"
                                                 Variant="Variant.Outlined"
                                                 Size="Size.Small">
                                            Ver Documentos
                                        </MudButton>
                                    </MudStack>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }
                </MudStack>
            }
        </MudStack>
    };

    private RenderFragment RenderApelacionesEnProceso() => __builder =>
    {
        <MudStack Spacing="4">
            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Class="mr-2" />
                    Apelaciones en Proceso de Evaluación
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Evaluaciones en curso</MudText>
            </div>
            
            @if (apelacionesEnProceso.Count == 0)
            {
                <MudPaper Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">
                        No hay apelaciones en proceso.
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="3">
                    @foreach (var apelacion in apelacionesEnProceso)
                    {
                        <MudCard Elevation="2" Style="border-left: 4px solid #ff9800;">
                            <MudCardContent Class="pa-4" Style="background-color: #fff8e1;">
                                <div class="d-flex justify-space-between align-start">
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.h6">@apelacion.DocenteNombre</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@apelacion.PromocionSolicitada</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Motivo: @apelacion.MotivoApelacion</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                                            @apelacion.HorasRestantes horas para resolución
                                        </MudText>
                                    </div>
                                    <MudButton OnClick="@(() => ProcesarApelacion(apelacion))"
                                             StartIcon="@Icons.Material.Filled.Edit"
                                             Color="Color.Warning"
                                             Variant="Variant.Filled"
                                             Size="Size.Small">
                                        Continuar
                                    </MudButton>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }
                </MudStack>
            }
        </MudStack>
    };

    private RenderFragment RenderApelacionesResueltas() => __builder =>
    {
        <MudStack Spacing="4">
            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" />
                    Apelaciones Resueltas
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Decisiones finalizadas</MudText>
            </div>
            
            @if (apelacionesResueltas.Count == 0)
            {
                <MudPaper Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">
                        No hay apelaciones resueltas.
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="3">
                    @foreach (var apelacion in apelacionesResueltas.OrderByDescending(a => a.FechaResolucion))
                    {
                        <MudCard Elevation="2" Style="border-left: 4px solid #4caf50;">
                            <MudCardContent Class="pa-4" Style="background-color: #e8f5e8;">
                                <div class="d-flex justify-space-between align-start">
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.h6">@apelacion.DocenteNombre</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@apelacion.PromocionSolicitada</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Motivo: @apelacion.MotivoApelacion</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-1">
