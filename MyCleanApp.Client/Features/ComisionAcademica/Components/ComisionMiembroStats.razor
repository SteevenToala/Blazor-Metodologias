<MudCard>
    <MudCardContent>
        <div class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h6">Estadísticas del Miembro</MudText>
        </div>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudCard Class="mud-theme-secondary">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center">
                            <div>
                                <MudText Typo="Typo.h4" Style="background:#1565c0;color:white;padding:8px 20px;border-radius:8px;min-width:48px;text-align:center;display:inline-block;">@TotalSolicitudes</MudText>
                                <MudText Typo="Typo.body2">Total Solicitudes</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Primary" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Class="mud-theme-info">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center">
                            <div>
                                <MudText Typo="Typo.h4" Style="background:#ff9800;color:white;padding:8px 20px;border-radius:8px;min-width:48px;text-align:center;display:inline-block;">@SolicitudesPendientes</MudText>
                                <MudText Typo="Typo.body2">Pendientes</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Pending" Size="Size.Large" Color="Color.Info" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Class="mud-theme-success">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center">
                            <div>
                                <MudText Typo="Typo.h4" Style="background:#43a047;color:white;padding:8px 20px;border-radius:8px;min-width:48px;text-align:center;display:inline-block;">@SolicitudesRevisadas</MudText>
                                <MudText Typo="Typo.body2">Revisadas</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@inject HttpClient Http

@code {
    private int TotalSolicitudes { get; set; }
    private int SolicitudesPendientes { get; set; }
    private int SolicitudesRevisadas { get; set; }

    private List<SolicitudAvanceRangoDto> solicitudes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            solicitudes = await Http.GetFromJsonAsync<List<SolicitudAvanceRangoDto>>("http://localhost:5015/api/SolicitudAvanceRango");
        }
        catch
        {
            solicitudes = new();
        }
        TotalSolicitudes = solicitudes.Count;
        SolicitudesPendientes = solicitudes.Count(s => s.Estado == "APROBADA_COMICION");
        SolicitudesRevisadas = solicitudes.Count(s => s.Estado == "PROMOVIDA");
    }
}
