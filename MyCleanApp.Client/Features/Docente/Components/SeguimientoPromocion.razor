    private List<EtapaProceso> GetEtapasProceso(string estadoActual)
    {
        var etapas = new List<EtapaProceso>
        {
            new("Solicitud Presentada", true),
            new("Verificación de Documentos", EstadoCompletado(estadoActual, "EN_VERIFICACION")),
            new("Documentos Verificados", EstadoCompletado(estadoActual, "VERIFICADA")),
            new("Enviada a Comisión", EstadoCompletado(estadoActual, "ENVIADA_COMISION")),
            new("Análisis de Comisión", EstadoCompletado(estadoActual, "EN_ANALISIS_COMISION")),
            new("Decisión Final", EstadoCompletado(estadoActual, "DECIDIDO_APROBADA") || EstadoCompletado(estadoActual, "DECIDIDO_RECHAZADA"))
        };

        if (estadoActual == "EFECTIVA")
        {
            etapas.Add(new("Promoción Efectiva", true));
        }

        return etapas;
    }

    private bool EstadoCompletado(string estadoActual, string estadoComparar)
    {
        var ordenEstados = new Dictionary<string, int>
        {
            ["PENDIENTE"] = 1,
            ["EN_VERIFICACION"] = 2,
            ["VERIFICADA"] = 3,
            ["ENVIADA_COMISION"] = 4,
            ["EN_ANALISIS_COMISION"] = 5,
            ["DECIDIDO_APROBADA"] = 6,
            ["DECIDIDO_RECHAZADA"] = 6,
            ["APROBADA"] = 7,
            ["RECHAZADA"] = 7,
            ["EFECTIVA"] = 8
        };

        return ordenEstados.GetValueOrDefault(estadoActual, 0) >= ordenEstados.GetValueOrDefault(estadoComparar, 0);
    }

    private void VerDetalle(SolicitudAvanceRangoDto solicitud)
    {
        solicitudSeleccionada = solicitud;
        mostrarModalDetalle = true;
    }

    private void CerrarModalDetalle()
    {
        mostrarModalDetalle = false;
        solicitudSeleccionada = null;
    }

    private bool PuedeApelar(SolicitudAvanceRangoDto solicitud)
    {
        // Verificar si han pasado menos de 30 días desde la respuesta
        if (solicitud.FechaRespuesta.HasValue)
        {
            var diasTranscurridos = (DateTime.Now - solicitud.FechaRespuesta.Value).Days;
            return diasTranscurridos <= 30;
        }
        return false;
    }

    // Métodos para manejar apelaciones y decisiones
    private bool PuedeResponderDecision(SolicitudAvanceRangoDto solicitud)
    {
        // El docente puede responder a decisiones de la comisión por 3 días
        if ((solicitud.Estado == "DECIDIDO_APROBADA" || solicitud.Estado == "DECIDIDO_RECHAZADA") && 
            solicitud.FechaRespuesta.HasValue)
        {
            var diasTranscurridos = (DateTime.Now - solicitud.FechaRespuesta.Value).Days;
            return diasTranscurridos <= 3;
        }
        return false;
    }

    private int ObtenerDiasRestantesParaResponder(SolicitudAvanceRangoDto solicitud)
    {
        if (solicitud.FechaRespuesta.HasValue)
        {
            var diasTranscurridos = (DateTime.Now - solicitud.FechaRespuesta.Value).Days;
            return Math.Max(0, 3 - diasTranscurridos);
        }
        return 0;
    }

    private async Task AceptarDecision(SolicitudAvanceRangoDto solicitud)
    {
        try
        {
            var exito = await DocenteService.AceptarDecisionPromocionAsync(solicitud.Id);
            
            if (exito)
            {
                Snackbar.Add("Decisión aceptada correctamente. Tu solicitud regresa a la Comisión para elaborar los informes finales de promoción académica.", Severity.Success);
                
                // Recargar las solicitudes para obtener el estado actualizado desde la base de datos
                await CargarSolicitudes();
                CerrarModalDetalle();
            }
            else
            {
                Snackbar.Add("Error al aceptar la decisión. Por favor, intenta nuevamente.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al aceptar la decisión: {ex.Message}", Severity.Error);
        }
    }

    private void AbrirModalApelacion(SolicitudAvanceRangoDto solicitud)
    {
        solicitudParaApelar = solicitud;
        motivosApelacion = "";
        mostrarModalApelacion = true;
        CerrarModalDetalle();
    }

    private void CerrarModalApelacion()
    {
        mostrarModalApelacion = false;
        solicitudParaApelar = null;
        motivosApelacion = "";
    }

    private async Task ConfirmarApelacion()
    {
        if (solicitudParaApelar == null || string.IsNullOrWhiteSpace(motivosApelacion))
        {
            Snackbar.Add("Por favor, ingresa los motivos de la apelación", Severity.Warning);
            return;
        }

        try
        {
            var exito = await DocenteService.PresentarApelacionAsync(solicitudParaApelar.Id, motivosApelacion);
            
            if (exito)
            {
                Snackbar.Add("Apelación presentada correctamente. La Comisión resolverá en 3 días.", Severity.Success);
                
                // Recargar las solicitudes para obtener el estado actualizado desde la base de datos
                await CargarSolicitudes();
                CerrarModalApelacion();
            }
            else
            {
                Snackbar.Add("Error al presentar la apelación. Por favor, intenta nuevamente.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al presentar la apelación: {ex.Message}", Severity.Error);
        }
    }

