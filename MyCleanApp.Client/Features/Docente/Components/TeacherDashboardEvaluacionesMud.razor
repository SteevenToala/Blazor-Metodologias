    private async Task GuardarCambiosEvaluacion()
    {
        if (evaluacionEditando == null || !FormularioValido()) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            // Actualizar los campos básicos desde las variables de edición
            evaluacionEditando.TipoEvaluacion = editTipoEvaluacion.Trim();
            evaluacionEditando.Periodo = editPeriodo.Trim();
            evaluacionEditando.Puntaje = editPuntaje;
            evaluacionEditando.FechaEvaluacion = editFechaEvaluacion ?? DateTime.Now;
            evaluacionEditando.Observaciones = editObservaciones?.Trim() ?? string.Empty;

            // Convertir archivo de certificado a byte[] si se seleccionó un nuevo archivo
            if (editArchivoFile != null)
            {
                Console.WriteLine($"[DEBUG] Convirtiendo archivo de certificado: {editArchivoFile.Name} ({editArchivoFile.Size} bytes)");
                
                // Validar que sea un archivo PDF
                if (!editArchivoFile.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase))
                {
                    modalMessageImportar = "❌ Error: Solo se permiten archivos PDF para el certificado.";
                    showModalImportar = true;
                    return;
                }
                
                // Validar tamaño del archivo (máximo 10MB)
                const int maxSizeInBytes = 10 * 1024 * 1024; // 10MB
                if (editArchivoFile.Size > maxSizeInBytes)
                {
                    modalMessageImportar = "❌ Error: El archivo es demasiado grande. Máximo permitido: 10MB.";
                    showModalImportar = true;
                    return;
                }
                
                try
                {
                    // Leer el archivo y convertirlo a byte[]
                    using var stream = editArchivoFile.OpenReadStream(maxSizeInBytes);
                    using var memoryStream = new MemoryStream();
                    await stream.CopyToAsync(memoryStream);
                    evaluacionEditando.Certificado = memoryStream.ToArray();
                    
                    Console.WriteLine($"[DEBUG] Certificado convertido exitosamente: {evaluacionEditando.Certificado.Length} bytes");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[ERROR] Error al convertir certificado: {ex.Message}");
                    modalMessageImportar = $"❌ Error al procesar el certificado: {ex.Message}";
                    showModalImportar = true;
                    return;
                }
            }

            Console.WriteLine($"[DEBUG] Guardando evaluación: {evaluacionEditando.TipoEvaluacion}");
            Console.WriteLine($"[DEBUG] Archivo presente: {evaluacionEditando.Certificado != null}");
            Console.WriteLine($"[DEBUG] Nuevo archivo: {editArchivoFile?.Name ?? "Ninguno"}");

            var response = await DocenteService.EditarEvaluacionAsync(evaluacionEditando);
            
            if (response)
            {
                modalMessageImportar = "✅ Evaluación editada exitosamente.";
                showModalImportar = true;
                showEditModal = false;
                
                // Limpiar el estado de edición
                evaluacionEditando = null;
                editArchivoFile = null;
                
                // Notificar al componente padre para actualizar la lista
                if (OnImportarCompletado.HasDelegate)
                    await OnImportarCompletado.InvokeAsync();
                    
                // Recargar evaluaciones
                await CargarEvaluaciones();
                
                Console.WriteLine("[DEBUG] Evaluación guardada exitosamente");
            }
            else
            {
                modalMessageImportar = "❌ Error: No se pudo editar la evaluación. Verifica los datos e intenta nuevamente.";
                showModalImportar = true;
                Console.WriteLine("[ERROR] Error al guardar evaluación en el servidor");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Excepción al guardar: {ex.Message}");
            modalMessageImportar = $"❌ Error inesperado: {ex.Message}";
            showModalImportar = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task EliminarEvaluacion(int evaluacionId)
    {
        try
        {
            var evaluacion = EvaluacionesDocentes.FirstOrDefault(e => e.Id == evaluacionId);
            string descripcion = evaluacion?.TipoEvaluacion ?? "la evaluación seleccionada";
            
            bool? result = await DialogService.ShowMessageBox(
                "⚠️ Confirmar eliminación",
                $"¿Estás seguro de que deseas eliminar '{descripcion}'?\n\nEsta acción es irreversible y no se puede deshacer.",
                yesText: "Sí, eliminar", 
                cancelText: "Cancelar",
                options: new DialogOptions { MaxWidth = MaxWidth.Small });
            
            if (result == true)
            {
                isLoading = true;
                StateHasChanged();
                
                var response = await DocenteService.EliminarEvaluacionDocenteAsync(evaluacionId);
                if (response)
                {
                    modalMessageImportar = $"✅ '{descripcion}' ha sido eliminada exitosamente.";
                    showModalImportar = true;
                    
                    // Recargar evaluaciones
                    await CargarEvaluaciones();
                    
                    if (OnImportarCompletado.HasDelegate)
                        await OnImportarCompletado.InvokeAsync();
                }
                else
                {
                    modalMessageImportar = "❌ Error: No se pudo eliminar la evaluación. Verifica tu conexión e intenta nuevamente.";
                    showModalImportar = true;
                }
            }
        }
        catch (Exception ex)
        {
            modalMessageImportar = $"❌ Error inesperado al eliminar: {ex.Message}";
            showModalImportar = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private bool FormularioValido()
    {
        return !string.IsNullOrWhiteSpace(editTipoEvaluacion) &&
               !string.IsNullOrWhiteSpace(editPeriodo) &&
               editPuntaje >= 0 && editPuntaje <= 100 &&
               editFechaEvaluacion.HasValue;
    }

