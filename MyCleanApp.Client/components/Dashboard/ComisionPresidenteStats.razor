@* Componente de estadísticas para la Presidencia de la Comisión *@
<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="3" Class="pa-4 text-center">
            <MudCardContent>
                <MudText Typo="Typo.h4" Color="Color.Primary">25</MudText>
                <MudText Typo="Typo.body2">Expedientes Pendientes</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="3" Class="pa-4 text-center">
            <MudCardContent>
                <MudText Typo="Typo.h4" Color="Color.Success">12</MudText>
                <MudText Typo="Typo.body2">Aprobados</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="3" Class="pa-4 text-center">
            <MudCardContent>
                <MudText Typo="Typo.h4" Color="Color.Warning">8</MudText>
                <MudText Typo="Typo.body2">En Revisión</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="3" Class="pa-4 text-center">
            <MudCardContent>
                <MudText Typo="Typo.h4" Color="Color.Error">3</MudText>
                <MudText Typo="Typo.body2">Rechazados</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
