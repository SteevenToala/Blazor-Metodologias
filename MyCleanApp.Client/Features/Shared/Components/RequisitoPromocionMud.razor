@using MyCleanApp.Client.Features.Docente.Services
@using MyCleanApp.Client.DTOs
@using MudBlazor
@inject DocenteService DocenteService
@inject IJSRuntime JSRuntime

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.h5" Class="mb-2" Style="color: #8B1538;">
        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="me-2" /> Requisitos para Promoción
    </MudText>

    @if (isLoading)
    {
        <div class="d-flex justify-center my-6">
            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (requisitosPromocion == null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense>
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="me-2" /> No se pudieron cargar los requisitos de promoción.
        </MudAlert>
    }
    else if (!string.IsNullOrEmpty(requisitosPromocion.ProximoNivel) && requisitosPromocion.ProximoNivel != "N/A")
    {
        <MudPaper Class="pa-3 mb-4" Style="background-color: #f8f9fa; border-left: 4px solid #8B1538;">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText><b>Nivel Actual:</b> @requisitosPromocion.NivelActual</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText><b>Próximo Nivel:</b> @requisitosPromocion.ProximoNivel</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-3 mb-4" Style="border: 1px solid #dee2e6;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <MudText Typo="Typo.subtitle1"><b>Progreso General</b></MudText>
                <MudChip T="string" Color="@(requisitosPromocion.PuedePromoverse ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                    @requisitosPromocion.ResumenCumplimiento.RequisitosCumplidos/@requisitosPromocion.ResumenCumplimiento.TotalRequisitos
                </MudChip>
            </div>
            <MudProgressLinear Color="@(requisitosPromocion.PuedePromoverse ? Color.Success : Color.Primary)" Value="@requisitosPromocion.ResumenCumplimiento.PorcentajeGeneral" Rounded Height="16">
            </MudProgressLinear>
            <MudText Typo="Typo.caption" Align="Align.Center" Class="w-100 mt-1">
                @requisitosPromocion.ResumenCumplimiento.PorcentajeGeneral.ToString("F1")%
            </MudText>
        </MudPaper>

        <MudGrid Class="mb-4">
            @foreach (var requisito in requisitosPromocion.Requisitos)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudPaper Class="pa-3 mb-3" Style="background-color: #f8f9fa; border: 1px solid #dee2e6;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <MudText Class="requirement-name">
                                <MudIcon Icon="@GetMudIcon(requisito.TipoRequisito)" Class="me-2" />
                                @requisito.TipoRequisito
                            </MudText>
                            <MudChip T="string" Color="@(requisito.Cumple ? Color.Success : Color.Error)" Variant="Variant.Filled">
                                @requisito.ValorActual.ToString("F1")/@requisito.ValorRequerido.ToString("F1")
                            </MudChip>
                        </div>
                        <MudProgressLinear Color="@(requisito.Cumple ? Color.Success : Color.Warning)" Value="@Math.Min(requisito.Porcentaje, 100)" Height="8" Rounded Class="mb-1" />
                        <MudText Typo="Typo.caption">
                            @requisito.Porcentaje.ToString("F1")% completado
                        </MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @if (requisitosPromocion.PuedePromoverse)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="me-2" /> ¡Felicitaciones! Cumples con todos los requisitos para la promoción.
            </MudAlert>
            <div class="d-flex justify-center">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" OnClick="SolicitarPromocion" Disabled="@isSoliciting">
                    @if (isSoliciting)
                    {
                        <MudProgressCircular Indeterminate Color="Color.Inherit" Size="Size.Small" Class="me-2" />
                    }
                    <MudIcon Icon="fas fa-paper-plane" Class="me-2" /> Solicitar Promoción
                </MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense>
                @* <MudIcon Icon="@Icons.Material.Filled.Info" Class="me-2" /> *@
                Aún no cumples con todos los requisitos. Continúa trabajando en las áreas pendientes.
            </MudAlert>
        }
    }
    else
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense>
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="me-2" />
            Has alcanzado el nivel académico máximo. ¡Felicitaciones!
        </MudAlert>
    }
</MudPaper>

@code {
    private RequisitoPromocionResponse? requisitosPromocion;
    private bool isLoading = true;
    private bool isSoliciting = false;
    private DateTime? fechaInicioNivelActual;

    protected override async Task OnInitializedAsync()
    {
        await CargarFechaInicioNivelActual();
        await CargarRequisitos();
    }

    private async Task CargarFechaInicioNivelActual()
    {
        try
        {
            var loginResponse = await DocenteService.GetLoginResponseAsync();
            if (loginResponse?.usuario != null)
            {
                var docenteId = await DocenteService.ObtenerDocenteIdPorUsuarioId(loginResponse.usuario.Id);
                if (docenteId.HasValue)
                {
                    fechaInicioNivelActual = await DocenteService.ObtenerFechaInicioNivelActualAsync(docenteId.Value);
                    Console.WriteLine($"[REQUISITOS] Fecha inicio nivel actual: {fechaInicioNivelActual}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar fecha inicio nivel actual: {ex.Message}");
        }
    }

    private async Task CargarRequisitos()
    {
        isLoading = true;
        try
        {
            // Si tenemos fecha de inicio del nivel, calcular requisitos con datos filtrados
            if (fechaInicioNivelActual.HasValue)
            {
                Console.WriteLine($"[REQUISITOS] Calculando requisitos desde fecha: {fechaInicioNivelActual.Value:yyyy-MM-dd}");
                
                var loginResponse = await DocenteService.GetLoginResponseAsync();
                if (loginResponse?.usuario != null)
                {
                    var docenteId = await DocenteService.ObtenerDocenteIdPorUsuarioId(loginResponse.usuario.Id);
                    if (docenteId.HasValue)
                    {
                        Console.WriteLine($"[REQUISITOS] Usuario ID: {loginResponse.usuario.Id}, Docente ID: {docenteId.Value}");
                        // Obtener el nivel actual del docente para calcular requisitos del siguiente nivel
                        var dashboardData = await DocenteService.getDataDashBoard();
                        if (dashboardData != null)
                        {
                            var nivelActual = dashboardData.NivelAcademico;
                            var nivelActualId = await DocenteService.ObtenerNivelAcademicoIdPorNombreAsync(nivelActual);
                            
                            if (nivelActualId.HasValue)
                            {
                                Console.WriteLine($"[REQUISITOS] Nivel actual: {nivelActual} (ID: {nivelActualId.Value})");
                                
                                // Calcular el próximo nivel
                                var prefijo = nivelActual.Substring(0, nivelActual.Length - 1);
                                var numero = int.TryParse(nivelActual.Substring(nivelActual.Length - 1), out var n) ? n : 1;
                                var proximoNivel = numero < 5 ? $"{prefijo}{numero + 1}" : nivelActual;
                                var proximoNivelId = await DocenteService.ObtenerNivelAcademicoIdPorNombreAsync(proximoNivel);
                                
                                Console.WriteLine($"[REQUISITOS] Próximo nivel: {proximoNivel} (ID: {proximoNivelId})");
                                // Obtener requisitos del próximo nivel
                                var requisitosNivel = await DocenteService.GetRequisitosPorNivelAsync(proximoNivelId.Value);
                                var requirements = new List<RequisitoEvaluacion>();

                                if (requisitosNivel != null && requisitosNivel.Any())
                                {
                                    Console.WriteLine($"[REQUISITOS] Calculando {requisitosNivel.Count} requisitos con datos filtrados desde {fechaInicioNivelActual.Value:yyyy-MM-dd}");

                                    foreach (var requisito in requisitosNivel)
                                    {
                                        float valorActual = 0;

                                        switch (requisito.TipoRequisitoNombre.ToLower())
                                        {
                                            case "investigaciones":
                                            case "meses de investigación":
                                            case "meses investigación":
                                                var proyectosFiltrados = await DocenteService.ObtenerProyectosDesdeAsync(docenteId.Value, fechaInicioNivelActual.Value);
                                                foreach (var proyecto in proyectosFiltrados)
                                                {
                                                    var meses = (proyecto.FechaFin.Year - proyecto.FechaInicio.Year) * 12 + (proyecto.FechaFin.Month - proyecto.FechaInicio.Month);
                                                    valorActual += Math.Max(0, meses);
                                                }
                                                Console.WriteLine($"[REQUISITOS] Meses de investigación filtrados: {valorActual}");
                                                break;

                                            case "papers":
                                            case "publicaciones":
                                            case "publicaciones académicas":
                                                var publicacionesFiltradas = await DocenteService.ObtenerPublicacionesDesdeAsync(docenteId.Value, fechaInicioNivelActual.Value);
                                                valorActual = publicacionesFiltradas.Count;
                                                Console.WriteLine($"[REQUISITOS] Publicaciones filtradas: {valorActual}");
                                                break;

                                            case "horas capacitación":
                                            case "cursos capacitación":
                                            case "cursos de capacitación":
                                                var capacitacionesFiltradas = await DocenteService.ObtenerCapacitacionesDesdeAsync(docenteId.Value, fechaInicioNivelActual.Value);
                                                valorActual = capacitacionesFiltradas.Sum(c => c.Horas);
                                                Console.WriteLine($"[REQUISITOS] Horas de capacitación filtradas: {valorActual}");
                                                break;

                                            case "años en el rango":
                                                var añosEnRango = (DateTime.Now - fechaInicioNivelActual.Value).TotalDays / 365.25;
                                                valorActual = (float)Math.Max(0, añosEnRango);
                                                Console.WriteLine($"[REQUISITOS] Años en el rango desde {fechaInicioNivelActual.Value:yyyy-MM-dd}: {valorActual}");
                                                break;

                                            case "puntaje evaluación":
                                            case "puntaje docencia":
                                                var puntajeEvaluacion = await DocenteService.ObtenerPuntajeEvaluacionDesdeAsync(docenteId.Value, fechaInicioNivelActual.Value);
                                                valorActual = (float)puntajeEvaluacion;
                                                Console.WriteLine($"[REQUISITOS] Puntaje evaluación filtrado: {valorActual}");
                                                break;

                                            default:
                                                Console.WriteLine($"[REQUISITOS] Tipo de requisito no reconocido: {requisito.TipoRequisitoNombre}");
                                                break;
                                        }

                                        var requirement = new RequisitoEvaluacion
                                        {
                                            TipoRequisito = requisito.TipoRequisitoNombre,
                                            ValorRequerido = (float)requisito.ValorRequerido,
                                            ValorActual = valorActual,
                                            Cumple = valorActual >= (float)requisito.ValorRequerido,
                                            Porcentaje = (float)requisito.ValorRequerido > 0 ? (valorActual * 100.0f / (float)requisito.ValorRequerido) : 0
                                        };

                                        requirements.Add(requirement);
                                    }
                                }
                                
                                // Crear la respuesta con los datos filtrados
                                requisitosPromocion = new RequisitoPromocionResponse
                                {
                                    NivelActual = nivelActual,
                                    ProximoNivel = proximoNivel,
                                    Requisitos = requirements,
                                    PuedePromoverse = requirements.All(r => r.Cumple),
                                    ResumenCumplimiento = new ResumenCumplimiento
                                    {
                                        RequisitosCumplidos = requirements.Count(r => r.Cumple),
                                        TotalRequisitos = requirements.Count,
                                        PorcentajeGeneral = requirements.Count > 0 ? 
                                            (requirements.Count(r => r.Cumple) * 100.0f / requirements.Count) : 0
                                    }
                                };
                                
                                Console.WriteLine($"[REQUISITOS] Requisitos calculados con datos filtrados: {requirements.Count}");
                                Console.WriteLine($"[REQUISITOS] Puede promocionarse: {requisitosPromocion.PuedePromoverse}");
                            }
                            else
                            {
                                // Ya está en el nivel máximo
                                requisitosPromocion = new RequisitoPromocionResponse
                                {
                                    NivelActual = nivelActual,
                                    ProximoNivel = "N/A",
                                    PuedePromoverse = false,
                                    Requisitos = new List<RequisitoEvaluacion>(),
                                    ResumenCumplimiento = new ResumenCumplimiento()
                                };
                            }
                        }
                    }
                }
            }
            else
            {
                // Fallback al método original si no hay fecha de inicio
                Console.WriteLine("[REQUISITOS] No hay fecha de inicio del nivel, usando método original");
                requisitosPromocion = await DocenteService.ObtenerRequisitosPromocionAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar requisitos: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Error al cargar los requisitos de promoción");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SolicitarPromocion()
    {
        isSoliciting = true;
        try
        {
            var success = await DocenteService.SolicitarPromocionAsync();
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Solicitud de promoción enviada exitosamente");
                await CargarRequisitos();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al enviar la solicitud de promoción");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al solicitar promoción: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Error al procesar la solicitud");
        }
        finally
        {
            isSoliciting = false;
            StateHasChanged();
        }
    }

    private string GetMudIcon(string tipoRequisito)
    {
        return tipoRequisito switch
        {
            "Años en el rango" => Icons.Material.Filled.CalendarToday,
            "Papers" => Icons.Material.Filled.Description,
            "Puntaje Evaluación" => Icons.Material.Filled.Star,
            "Horas Capacitación" => Icons.Material.Filled.School,
            "Investigaciones" => Icons.Material.Filled.Science,
            _ => Icons.Material.Filled.CheckCircle
        };
    }
}
