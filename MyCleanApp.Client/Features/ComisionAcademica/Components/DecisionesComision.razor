@using MyCleanApp.Client.DTOs
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudPaper Elevation="1" Class="pa-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">Decisiones de Comisión</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" 
                   Color="Color.Primary" 
                   OnClick="CargarSolicitudesAnalisis">
            Actualizar
        </MudButton>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (solicitudesAnalisis.Any())
    {
        <MudTable Items="@solicitudesAnalisis" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Docente</MudTh>
                <MudTh>Nivel Solicitado</MudTh>
                <MudTh>Fecha Análisis</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Docente">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                        @context.DocenteNombre @context.DocenteApellido
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Nivel Solicitado">@context.NivelSolicitado</MudTd>
                <MudTd DataLabel="Fecha Análisis">
                    @(context.FechaAnalisis?.ToString("dd/MM/yyyy") ?? "N/A")
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Color="@GetEstadoColor(context.Estado)" Size="Size.Small">
                        @context.Estado
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    @if (context.Estado == "EN_EVALUACION")
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Gavel"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="@(() => AbrirModalDecision(context))">
                            Emitir Decisión
                        </MudButton>
                    }
                    else if (context.Estado == "DECIDIDA" || context.Estado == "DECISION_EMITIDA")
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">
                            Decisión Emitida
                        </MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            No hay solicitudes en análisis para emitir decisión en este momento.
        </MudAlert>
    }
</MudPaper>

<!-- Modal de Decisión -->
@if (mostrarModalDecision && solicitudParaDecision != null)
{
    <div class="modal" style="display: block; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5);">
        <div class="modal-content" style="background-color: white; margin: 10% auto; padding: 20px; border-radius: 8px; width: 90%; max-width: 600px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #ddd; padding-bottom: 15px;">
                <h3 style="margin: 0; color: #8B1538;">
                    ⚖️ Emitir Decisión de Comisión
                </h3>
                <button @onclick="CerrarModalDecision" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #666;">×</button>
            </div>
            
            <!-- Información de la Solicitud -->
            <div style="background-color: #f8f9fa; padding: 20px; border-radius: 6px; margin-bottom: 20px;">
                <h4 style="margin-top: 0; color: #495057;">Información de la Solicitud</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div><strong>Docente:</strong> @solicitudParaDecision.DocenteNombre @solicitudParaDecision.DocenteApellido</div>
                    <div><strong>Nivel Solicitado:</strong> @solicitudParaDecision.NivelSolicitado</div>
                    <div><strong>Fecha Análisis:</strong> @(solicitudParaDecision.FechaAnalisis?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                    <div><strong>Estado Actual:</strong> @solicitudParaDecision.Estado</div>
                </div>
            </div>

            <!-- Formulario de Decisión -->
            <div style="background-color: white; border: 1px solid #ddd; border-radius: 6px; padding: 20px; margin-bottom: 20px;">
                <h4 style="margin-top: 0;">Decisión de la Comisión</h4>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: bold;">Decisión:</label>
                    <select @bind="decisionSeleccionada" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
                        <option value="">Seleccione una decisión...</option>
                        <option value="APROBADA">Aprobar Promoción</option>
                        <option value="RECHAZADA">Rechazar Promoción</option>
                        <option value="OBSERVACIONES">Solicitar Observaciones</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: bold;">Observaciones de la Comisión:</label>
                    <textarea @bind="observacionesDecision" 
                             placeholder="Escriba las observaciones y fundamentos de la decisión..."
                             style="width: 100%; height: 120px; padding: 10px; border: 1px solid #ddd; border-radius: 4px; resize: vertical;"></textarea>
                </div>
            </div>
            
            <!-- Botones de acción -->
            <div style="display: flex; gap: 10px; justify-content: flex-end; padding-top: 15px; border-top: 1px solid #ddd;">
                <button @onclick="CerrarModalDecision" 
                        style="padding: 10px 20px; border: 1px solid #ddd; background-color: white; border-radius: 4px; cursor: pointer;">
                    Cancelar
                </button>
                <button @onclick="GuardarDecision" disabled="@(procesandoDecision || string.IsNullOrEmpty(decisionSeleccionada))"
                        style="padding: 10px 20px; border: 1px solid #4caf50; background-color: #4caf50; color: white; border-radius: 4px; cursor: pointer;">
                    @if (procesandoDecision) { <span>Procesando...</span> } else { <span>Emitir Decisión</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<SolicitudComisionDto> solicitudesAnalisis = new();
    
    // Variables para el modal de decisión
    private bool mostrarModalDecision = false;
    private SolicitudComisionDto? solicitudParaDecision = null;
    private string decisionSeleccionada = string.Empty;
    private string observacionesDecision = string.Empty;
    private bool procesandoDecision = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudesAnalisis();
    }

    private async Task CargarSolicitudesAnalisis()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Filtramos las solicitudes que están en análisis o ya tienen decisión emitida
            var response = await Http.GetAsync("http://localhost:5015/api/comision-academica/solicitudes-pendientes");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var todasSolicitudes = System.Text.Json.JsonSerializer.Deserialize<List<SolicitudComisionDto>>(json, options) ?? new();
                solicitudesAnalisis = todasSolicitudes
                    .Where(s => s.Estado == "EN_EVALUACION" || s.Estado == "DECIDIDA" || s.Estado == "DECISION_EMITIDA")
                    .ToList();
            }
            else
            {
                Snackbar.Add("Error al cargar las solicitudes en análisis", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void AbrirModalDecision(SolicitudComisionDto solicitud)
    {
        solicitudParaDecision = solicitud;
        decisionSeleccionada = string.Empty;
        observacionesDecision = string.Empty;
        mostrarModalDecision = true;
        StateHasChanged();
    }

    private void CerrarModalDecision()
    {
        mostrarModalDecision = false;
        solicitudParaDecision = null;
        decisionSeleccionada = string.Empty;
        observacionesDecision = string.Empty;
        procesandoDecision = false;
    }

    private async Task GuardarDecision()
    {
        if (solicitudParaDecision == null || string.IsNullOrEmpty(decisionSeleccionada))
        {
            Snackbar.Add("Debe seleccionar una decisión", Severity.Warning);
            return;
        }

        try
        {
            procesandoDecision = true;
            StateHasChanged();

            var request = new
            {
                decision = decisionSeleccionada,
                observaciones = observacionesDecision
            };

            var json = System.Text.Json.JsonSerializer.Serialize(request);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await Http.PostAsync($"http://localhost:5015/api/comision-academica/solicitud/{solicitudParaDecision.Id}/emitir-decision", content);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Decisión emitida exitosamente", Severity.Success);
                CerrarModalDecision();
                await CargarSolicitudesAnalisis(); // Refrescar la lista
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al emitir la decisión: {errorContent}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            procesandoDecision = false;
            StateHasChanged();
        }
    }

    private Color GetEstadoColor(string estado)
    {
        return estado switch
        {
            "EN_EVALUACION" => Color.Warning,
            "DECIDIDA" => Color.Success,
            "DECISION_EMITIDA" => Color.Success,
            _ => Color.Default
        };
    }
}
