@page "/"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@inject LocalStorageService LocalStorageService

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <!-- Header Section -->
    <MudGrid Justify="Justify.Center" Class="mb-8">
        <MudItem xs="12" Class="text-center">
            <MudText Typo="Typo.h3" Style="color: #8B1538;" Class="mb-4 font-weight-bold">
                Sistema de Gestión de Docentes
            </MudText>
            <MudText Typo="Typo.subtitle1" Style="color: #2d2d2d;" Class="mb-6">
                Plataforma integral para la gestión, evaluación y promoción de personal docente
            </MudText>
        </MudItem>
    </MudGrid>

    <!-- Login Section -->
    @if (loginResponse?.usuario == null)
    {
        <MudGrid Justify="Justify.Center" Class="mb-8">
            <MudItem xs="12" md="8" lg="6">
                <MudPaper Elevation="2" Class="pa-6" Style="border-left: 4px solid #8B1538;">
                    <MudText Typo="Typo.h6" Style="color: #8B1538;" Class="mb-4 text-center">
                        Acceso al Sistema
                    </MudText>
                    <div class="text-center">
                        <MudButton Href="/login" 
                                  Variant="Variant.Filled" 
                                  Style="background-color: #8B1538; color: white;"
                                  StartIcon="@Icons.Material.Filled.Login"
                                  Size="Size.Large"
                                  Class="pa-4">
                            Iniciar Sesión
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mt-3" Style="color: #666;">
                            Para docentes y administradores
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <!-- Welcome message for logged in users -->
        <MudGrid Justify="Justify.Center" Class="mb-8">
            <MudItem xs="12" md="8" lg="6">
                <MudPaper Elevation="2" Class="pa-6" Style="border-left: 4px solid #8B1538;">
                    <MudText Typo="Typo.h6" Style="color: #8B1538;" Class="mb-3 text-center">
                        ¡Bienvenido, @(loginResponse?.usuario?.Nombre ?? "Usuario")!
                    </MudText>
                    <MudText Typo="Typo.body1" Class="text-center mb-4">
                        Ya tienes una sesión activa en el sistema.
                    </MudText>
                    <div class="text-center">
                        @if (loginResponse?.usuario?.Rol == "ADMINISTRADOR")
                        {
                            <MudButton Href="/admin-dashboard" 
                                      Variant="Variant.Filled" 
                                      Style="background-color: #8B1538; color: white;"
                                      StartIcon="@Icons.Material.Filled.Dashboard"
                                      Size="Size.Large"
                                      Class="ma-2">
                                Ir al Panel de Administración
                            </MudButton>
                        }
                        else if (loginResponse?.usuario?.Rol == "DOCENTE")
                        {
                            <MudButton Href="/teacher-dashboard" 
                                      Variant="Variant.Filled" 
                                      Style="background-color: #8B1538; color: white;"
                                      StartIcon="@Icons.Material.Filled.Dashboard"
                                      Size="Size.Large"
                                      Class="ma-2">
                                Ir al Dashboard Docente
                            </MudButton>
                        }
                        else if (loginResponse?.usuario?.Rol == "TALENTO_HUMANO")
                        {
                            <MudButton Href="/talento-humano-dashboard" 
                                      Variant="Variant.Filled" 
                                      Style="background-color: #8B1538; color: white;"
                                      StartIcon="@Icons.Material.Filled.Dashboard"
                                      Size="Size.Large"
                                      Class="ma-2">
                                Ir al Panel de Talento Humano
                            </MudButton>
                        }
                        else if (loginResponse?.usuario?.Rol == "COMISION_PRESIDENTE")
                        {
                            <MudButton Href="/comision-presidente-dashboard" 
                                      Variant="Variant.Filled" 
                                      Style="background-color: #8B1538; color: white;"
                                      StartIcon="@Icons.Material.Filled.Dashboard"
                                      Size="Size.Large"
                                      Class="ma-2">
                                Ir al Panel de Presidencia
                            </MudButton>
                        }
                        else if (loginResponse?.usuario?.Rol == "COMISION_MIEMBRO")
                        {
                            <MudButton Href="/comision-miembro-dashboard" 
                                      Variant="Variant.Filled" 
                                      Style="background-color: #8B1538; color: white;"
                                      StartIcon="@Icons.Material.Filled.Dashboard"
                                      Size="Size.Large"
                                      Class="ma-2">
                                Ir al Panel de Comisión
                            </MudButton>
                        }
                        else if (loginResponse?.usuario?.Rol == "CONSEJO_UNIVERSITARIO")
                        {
                            <MudButton Href="/consejo-universitario-dashboard" 
                                      Variant="Variant.Filled" 
                                      Style="background-color: #8B1538; color: white;"
                                      StartIcon="@Icons.Material.Filled.Dashboard"
                                      Size="Size.Large"
                                      Class="ma-2">
                                Ir al Panel del Consejo
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <!-- Features Section -->
    <MudGrid Spacing="4" Class="mt-8">
        @foreach (var feature in GetFeatures())
        {
            <MudItem xs="12" md="4">
                <MudPaper Elevation="3" Class="pa-6 text-center mud-height-full hover-shadow" Style="border-top: 3px solid #8B1538;">
                    <MudIcon Icon="@feature.Icon" 
                            Style="color: #8B1538;" 
                            Size="Size.Large" 
                            Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="color: #8B1538;" Class="mb-3">
                        @feature.Title
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: #2d2d2d;">
                        @feature.Description
                    </MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <!-- Stats Section -->
    <MudGrid Justify="Justify.Center" Class="mt-8">
        <MudItem xs="12">
            <MudPaper Elevation="1" Class="pa-6" Style="border-left: 4px solid #8B1538;">
                <MudText Typo="Typo.h6" Style="color: #8B1538;" Class="mb-4 text-center">
                    Características del Sistema
                </MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="3" Class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Style="color: #8B1538;" Size="Size.Medium" />
                        <MudText Typo="Typo.body2" Class="mt-2">Sistema Seguro</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3" Class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" Style="color: #8B1538;" Size="Size.Medium" />
                        <MudText Typo="Typo.body2" Class="mt-2">Rápido y Eficiente</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3" Class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.CloudSync" Style="color: #8B1538;" Size="Size.Medium" />
                        <MudText Typo="Typo.body2" Class="mt-2">Sincronización en Tiempo Real</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3" Class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Style="color: #8B1538;" Size="Size.Medium" />
                        <MudText Typo="Typo.body2" Class="mt-2">Soporte 24/7</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .hover-shadow {
        transition: all 0.3s ease-in-out;
    }
    
    .hover-shadow:hover {
        box-shadow: 0 8px 25px rgba(139, 21, 56, 0.2) !important;
        transform: translateY(-2px);
    }

    .mud-button:hover {
        transform: translateY(-1px);
        transition: all 0.2s ease-in-out;
    }
</style>

@code {
    private record FeatureInfo(string Icon, string Title, string Description);

    private LoginResponse? loginResponse;

    private List<FeatureInfo> GetFeatures()
    {
        return new List<FeatureInfo>
        {
            new FeatureInfo(
                Icon: Icons.Material.Filled.Group,
                Title: "Gestión de Perfiles",
                Description: "Administración completa de perfiles docentes, con información académica y profesional detallada."
            ),
            new FeatureInfo(
                Icon: Icons.Material.Filled.Assessment,
                Title: "Evaluación y Seguimiento",
                Description: "Seguimiento de requisitos para promociones entre niveles con indicadores visuales de progreso."
            ),
            new FeatureInfo(
                Icon: Icons.Material.Filled.MenuBook,
                Title: "Desarrollo Profesional",
                Description: "Registro de publicaciones académicas, capacitaciones y participación en proyectos de investigación."
            )
        };
    }
    
    protected override async Task OnInitializedAsync()
    {
        loginResponse = await LocalStorageService.ObtenerObjetoAsync<LoginResponse>("loginResponse");
    }
}