@using MyCleanApp.Client.DTOs
@inject DocenteService DocenteService
@inject IJSRuntime JS

<div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
    <h3 class="text-lg font-medium mb-4">Gestión de Apelaciones</h3>
    
    @if (_showApelacionModal)
    {
        <div class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg p-6 w-full max-w-md">
                <h3 class="text-lg font-medium mb-4">Presentar Apelación</h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Motivo de la Apelación
                        </label>
                        <textarea 
                            @bind="_nuevaApelacion.MotivoApelacion"
                            rows="4"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="Describa detalladamente los motivos de su apelación...">
                        </textarea>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Documentos de Respaldo
                        </label>
                        <textarea 
                            @bind="_nuevaApelacion.DocumentosRespaldo"
                            rows="2"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="Liste los documentos que adjunta como respaldo...">
                        </textarea>
                    </div>
                </div>
                
                <div class="flex gap-2 mt-6">
                    <button 
                        @onclick="PresentarApelacion"
                        disabled="_enviandoApelacion"
                        class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors disabled:opacity-50">
                        @if (_enviandoApelacion)
                        {
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <span>Presentar Apelación</span>
                        }
                    </button>
                    <button 
                        @onclick="CerrarModalApelacion"
                        disabled="_enviandoApelacion"
                        class="flex-1 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-md transition-colors">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    }
    
    @if (_solicitudRechazada != null)
    {
        <div class="border border-red-200 bg-red-50 rounded-lg p-4 mb-4">
            <div class="flex items-start justify-between">
                <div>
                    <h4 class="font-medium text-red-800">Solicitud Rechazada</h4>
                    <p class="text-sm text-red-600 mt-1">
                        Su solicitud de promoción a <strong>@_solicitudRechazada.NivelSolicitado</strong> fue rechazada.
                    </p>
                    <p class="text-xs text-red-500 mt-1">
                        Fecha de notificación: @_solicitudRechazada.FechaRespuesta?.ToString("dd/MM/yyyy")
                    </p>
                    @if (!string.IsNullOrEmpty(_solicitudRechazada.Observaciones))
                    {
                        <p class="text-sm text-red-600 mt-2">
                            <strong>Observaciones:</strong> @_solicitudRechazada.Observaciones
                        </p>
                    }
                </div>
                <button 
                    @onclick="() => AbrirModalApelacion(_solicitudRechazada.Id)"
                    class="bg-red-600 hover:bg-red-700 text-white font-medium py-1 px-3 rounded text-sm">
                    Apelar
                </button>
            </div>
        </div>
    }
    
    @if (_apelacionesPresentadas.Any())
    {
        <div class="space-y-3">
            <h4 class="font-medium">Apelaciones Presentadas</h4>
            @foreach (var apelacion in _apelacionesPresentadas)
            {
                <div class="border border-gray-200 rounded-lg p-4">
                    <div class="flex items-start justify-between">
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium">Apelación</span>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetEstadoApelacionClasses(apelacion.Estado)">
                                    @apelacion.Estado
                                </span>
                            </div>
                            <p class="text-sm text-gray-600 mt-1">
                                Solicitud de promoción a <strong>@apelacion.NivelSolicitado</strong>
                            </p>
                            <p class="text-xs text-gray-500">
                                Presentada el @apelacion.FechaApelacion.ToString("dd/MM/yyyy")
                            </p>
                            
                            @if (!string.IsNullOrEmpty(apelacion.RespuestaComision))
                            {
                                <div class="mt-3 p-3 bg-gray-50 rounded">
                                    <p class="text-sm font-medium text-gray-700">Respuesta de la Comisión:</p>
                                    <p class="text-sm text-gray-600 mt-1">@apelacion.RespuestaComision</p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        @apelacion.FechaRespuesta?.ToString("dd/MM/yyyy")
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_solicitudRechazada == null)
    {
        <div class="text-center py-8">
            <svg class="h-12 w-12 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-gray-500 mt-2">No hay apelaciones para presentar en este momento.</p>
        </div>
    }
</div>

@code {
    [Parameter] public int DocenteId { get; set; }
    
    private SolicitudAvanceRangoDto? _solicitudRechazada;
    private List<ApelacionPromocionDto> _apelacionesPresentadas = new();
    private bool _showApelacionModal = false;
    private bool _enviandoApelacion = false;
    private CrearApelacionDto _nuevaApelacion = new();
    
    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }
    
    private async Task CargarDatos()
    {
        // Buscar solicitudes rechazadas que permitan apelación
        var solicitudes = await DocenteService.GetSolicitudesAvanceRangoDocente(DocenteId);
        _solicitudRechazada = solicitudes.FirstOrDefault(s => s.Estado == "RECHAZADA" && 
            (DateTime.Now - s.FechaRespuesta.GetValueOrDefault()).TotalDays <= 3);
        
        // Cargar apelaciones ya presentadas
        // Note: Este método debería agregarse al DocenteService
        // _apelacionesPresentadas = await DocenteService.GetApelacionesDocente(DocenteId);
    }
    
    private void AbrirModalApelacion(int solicitudId)
    {
        _nuevaApelacion = new CrearApelacionDto { SolicitudId = solicitudId };
        _showApelacionModal = true;
    }
    
    private void CerrarModalApelacion()
    {
        _showApelacionModal = false;
        _nuevaApelacion = new();
    }
    
    private async Task PresentarApelacion()
    {
        if (string.IsNullOrWhiteSpace(_nuevaApelacion.MotivoApelacion))
        {
            await JS.InvokeVoidAsync("alert", "Debe especificar el motivo de la apelación.");
            return;
        }
        
        _enviandoApelacion = true;
        
        try
        {
            var exito = await DocenteService.CrearApelacion(_nuevaApelacion);
            
            if (exito)
            {
                await JS.InvokeVoidAsync("alert", "Apelación presentada exitosamente.");
                CerrarModalApelacion();
                await CargarDatos();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Error al presentar la apelación. Inténtelo nuevamente.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            _enviandoApelacion = false;
        }
    }
    
    private string GetEstadoApelacionClasses(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => "bg-amber-100 text-amber-800",
            "APROBADA" => "bg-green-100 text-green-800",
            "RECHAZADA" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
}
