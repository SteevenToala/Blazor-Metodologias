@page "/subir-evaluacion"
@using MyCleanApp.Client.DTOs
@inject DocenteService DocenteService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="max-w-xl mx-auto mt-10">
    <div class="bg-white border border-gray-200 rounded-lg shadow-lg p-8">
        <div class="flex justify-end mb-4">
            <button
                class="flex items-center gap-2 bg-gray-100 hover:bg-blue-100 text-blue-700 font-medium py-1.5 px-4 rounded transition-colors border border-gray-200 shadow-sm"
                @onclick="VolverAlDashboard">
                <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Volver al Dashboard
            </button>
        </div>
        <h2 class="text-2xl font-bold text-blue-700 mb-2 flex items-center gap-2">
            <svg class="h-7 w-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nueva Evaluación Docente
        </h2>
        <p class="text-gray-600 mb-6">Completa el formulario para registrar una nueva evaluación en el sistema.</p>

        <EditForm Model="@evaluacion" OnValidSubmit="SubirEvaluacion" class="space-y-5">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Evaluación *</label>
                <InputSelect @bind-Value="evaluacion.TipoEvaluacion" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Selecciona un tipo</option>
                    <option value="ESTUDIANTES">Evaluación por Estudiantes</option>
                    <option value="PARES">Evaluación por Pares</option>
                    <option value="AUTOEVALUACION">Autoevaluación</option>
                    <option value="DIRECTIVOS">Evaluación por Directivos</option>
                </InputSelect>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Período *</label>
                <InputText @bind-Value="evaluacion.Periodo"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="Ej: 2024A, 2024B" />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Puntaje (%) *</label>
                <InputNumber @bind-Value="evaluacion.Puntaje"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    min="0" max="100" step="0.1" />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Fecha de Evaluación *</label>
                <InputDate @bind-Value="evaluacion.FechaEvaluacion"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Observaciones</label>
                <InputTextArea @bind-Value="evaluacion.Observaciones"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    rows="3"
                    placeholder="Comentarios adicionales sobre la evaluación..." />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Certificado PDF</label>
                <InputFile OnChange="OnFileChange" class="w-full text-gray-700" accept=".pdf" />
                <p class="text-sm text-gray-500 mt-1">Solo archivos PDF son permitidos. Tamaño máximo: 10MB.</p>
            </div>
            
            <div class="flex justify-end">
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-md shadow transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500">
                    Guardar Evaluación
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    EvaluacionDocenteRequest evaluacion = new() { 
        DocenteId = 1,
        FechaEvaluacion = DateTime.Now,
        Puntaje = 0.0
    };

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        
        // Validar que sea un archivo PDF
        if (!file.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase))
        {
            await JS.InvokeVoidAsync("alert", "❌ Error: Solo se permiten archivos PDF para el certificado.");
            return;
        }
        
        // Validar tamaño del archivo (máximo 10MB)
        const int maxSizeInBytes = 10 * 1024 * 1024; // 10MB
        if (file.Size > maxSizeInBytes)
        {
            await JS.InvokeVoidAsync("alert", "❌ Error: El archivo es demasiado grande. Máximo permitido: 10MB.");
            return;
        }
        
        try
        {
            using var stream = file.OpenReadStream(maxSizeInBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            evaluacion.Certificado = ms.ToArray();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Error al procesar el archivo: {ex.Message}");
        }
    }

    private async Task SubirEvaluacion()
    {
        // Validaciones básicas
        if (string.IsNullOrWhiteSpace(evaluacion.TipoEvaluacion))
        {
            await JS.InvokeVoidAsync("alert", "❌ Error: El tipo de evaluación es requerido.");
            return;
        }
        
        if (string.IsNullOrWhiteSpace(evaluacion.Periodo))
        {
            await JS.InvokeVoidAsync("alert", "❌ Error: El período es requerido.");
            return;
        }
        
        if (evaluacion.Puntaje < 0 || evaluacion.Puntaje > 100)
        {
            await JS.InvokeVoidAsync("alert", "❌ Error: El puntaje debe estar entre 0 y 100.");
            return;
        }
        
        if (evaluacion.FechaEvaluacion == DateTime.MinValue)
        {
            await JS.InvokeVoidAsync("alert", "❌ Error: La fecha de evaluación es requerida.");
            return;
        }
        
        try
        {
            var ok = await DocenteService.SubirEvaluacionDocenteAsync(evaluacion);
            if (ok)
            {
                await JS.InvokeVoidAsync("alert", "✅ Evaluación subida con éxito.");
                VolverAlDashboard();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ Error al subir la evaluación.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Error inesperado: {ex.Message}");
        }
    }
    
    private void VolverAlDashboard()
    {
        Navigation.NavigateTo("/teacher-dashboard");
    }
}
