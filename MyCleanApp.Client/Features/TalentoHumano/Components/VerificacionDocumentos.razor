@using MyCleanApp.Client.DTOs
@using System.Text.Json
@using MudBlazor
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject DocenteService DocenteService
@inject IDialogService DialogService

<MudPaper Elevation="1" Class="pa-4">
    <div class="d-flex align-center mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Assignment" Style="color: #8B1538;" Class="me-2" />
        <MudText Typo="Typo.h5" Style="color: #8B1538;">Verificación de Documentos</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CargarSolicitudes">
            Actualizar
        </MudButton>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-center pa-4">
            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            @errorMessage
        </MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <!-- Panel de Solicitudes Pendientes -->
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" Class="me-2" />
                                <MudText Typo="Typo.h6">Solicitudes Pendientes de Verificación</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (!solicitudesPendientes.Any())
                        {
                            <MudAlert Severity="Severity.Info">
                                No hay solicitudes pendientes de verificación.
                            </MudAlert>
                        }
                        else
                        {
                            @foreach (var solicitud in solicitudesPendientes)
                            {
                                <MudCard Outlined="true" Class="mb-3">
                                    <MudCardContent>
                                        <div class="d-flex justify-space-between align-center">
                                            <div>
                                                <MudText Typo="Typo.subtitle1"><strong>@solicitud.DocenteNombre</strong></MudText>
                                                <MudText Typo="Typo.body2">@solicitud.NivelActual → @solicitud.NuevoNivel</MudText>
                                                <MudText Typo="Typo.caption">Fecha: @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</MudText>
                                            </div>
                                            <div>
                                                <MudButton Size="Size.Small" 
                                                         Variant="Variant.Filled" 
                                                         Color="Color.Primary"
                                                         OnClick="@(() => IniciarVerificacion(solicitud))">
                                                    Verificar
                                                </MudButton>
                                            </div>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <!-- Panel de Solicitudes en Proceso -->
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" Class="me-2" />
                                <MudText Typo="Typo.h6">Solicitudes en Verificación</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (!solicitudesEnProceso.Any())
                        {
                            <MudAlert Severity="Severity.Info">
                                No hay solicitudes en proceso de verificación.
                            </MudAlert>
                        }
                        else
                        {
                            @foreach (var solicitud in solicitudesEnProceso)
                            {
                                <MudCard Outlined="true" Class="mb-3">
                                    <MudCardContent>
                                        <div class="d-flex justify-space-between align-center">
                                            <div>
                                                <MudText Typo="Typo.subtitle1"><strong>@solicitud.DocenteNombre</strong></MudText>
                                                <MudText Typo="Typo.body2">@solicitud.NivelActual → @solicitud.NuevoNivel</MudText>
                                                <MudText Typo="Typo.caption">En verificación</MudText>
                                            </div>
                                            <div>
                                                <MudButton Size="Size.Small" 
                                                         Variant="Variant.Outlined" 
                                                         Color="Color.Info"
                                                         OnClick="() => ContinuarVerificacion(solicitud)">
                                                    Continuar
                                                </MudButton>
                                            </div>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Resumen de Estados -->
        <MudCard Elevation="1" Class="mt-4">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="3">
                        <MudPaper Class="pa-4 text-center" Style="background-color: #fff3cd;">
                            <MudText Typo="Typo.h4" Color="Color.Warning">@solicitudesPendientes.Count</MudText>
                            <MudText Typo="Typo.body2">Pendientes</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="3">
                        <MudPaper Class="pa-4 text-center" Style="background-color: #d1ecf1;">
                            <MudText Typo="Typo.h4" Color="Color.Info">@solicitudesEnProceso.Count</MudText>
                            <MudText Typo="Typo.body2">En Proceso</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="3">
                        <MudPaper Class="pa-4 text-center" Style="background-color: #d4edda;">
                            <MudText Typo="Typo.h4" Color="Color.Success">@solicitudesVerificadas.Count</MudText>
                            <MudText Typo="Typo.body2">Verificadas</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="3">
                        <MudPaper Class="pa-4 text-center" Style="background-color: #f8d7da;">
                            <MudText Typo="Typo.h4" Color="Color.Error">@solicitudesRechazadas.Count</MudText>
                            <MudText Typo="Typo.body2">Rechazadas</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }
</MudPaper>

<!-- Modal de Verificación Detallada -->
@if (mostrarModalVerificacion && solicitudEnVerificacion != null)
{
    <div class="modal" style="display: block; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5);">
        <div class="modal-content" style="background-color: white; margin: 5% auto; padding: 20px; border-radius: 8px; width: 90%; max-width: 1200px; max-height: 80vh; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #ddd; padding-bottom: 15px;">
                <h3 style="margin: 0; color: #8B1538;">
                    📋 Verificación de Documentos - @solicitudEnVerificacion.DocenteNombre
                </h3>
                <button @onclick="CerrarModalVerificacion" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #666;">×</button>
            </div>
            
            <!-- Información de la Solicitud -->
            <div style="background-color: #f8f9fa; padding: 20px; border-radius: 6px; margin-bottom: 20px;">
                <h4 style="margin-top: 0; color: #495057;">Información de la Solicitud</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div><strong>Docente:</strong> @solicitudEnVerificacion.DocenteNombre</div>
                    <div><strong>Fecha Solicitud:</strong> @solicitudEnVerificacion.FechaSolicitud.ToString("dd/MM/yyyy")</div>
                    <div><strong>Nivel Actual:</strong> @solicitudEnVerificacion.NivelActual</div>
                    <div><strong>Nivel Solicitado:</strong> @solicitudEnVerificacion.NuevoNivel</div>
                    <div style="grid-column: span 2;"><strong>Estado:</strong> @solicitudEnVerificacion.Estado</div>
                </div>
                
                <!-- Resumen de documentos disponibles -->
                <hr style="margin: 20px 0;">
                <h5 style="margin-bottom: 15px;">Resumen de Documentos en el Sistema</h5>
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px;">
                    <div style="background-color: #e3f2fd; padding: 15px; border-radius: 6px; text-align: center;">
                        <div style="font-size: 24px; font-weight: bold; color: #1976d2;">@evaluacionesDocente.Count</div>
                        <div style="font-size: 12px; color: #666;">Evaluaciones</div>
                    </div>
                    <div style="background-color: #f3e5f5; padding: 15px; border-radius: 6px; text-align: center;">
                        <div style="font-size: 24px; font-weight: bold; color: #7b1fa2;">@capacitacionesDocente.Count</div>
                        <div style="font-size: 12px; color: #666;">Capacitaciones</div>
                    </div>
                    <div style="background-color: #e8f5e8; padding: 15px; border-radius: 6px; text-align: center;">
                        <div style="font-size: 24px; font-weight: bold; color: #388e3c;">@publicacionesDocente.Count</div>
                        <div style="font-size: 12px; color: #666;">Publicaciones</div>
                    </div>
                    <div style="background-color: #fff3e0; padding: 15px; border-radius: 6px; text-align: center;">
                        <div style="font-size: 24px; font-weight: bold; color: #f57c00;">@proyectosDocente.Count</div>
                        <div style="font-size: 12px; color: #666;">Proyectos</div>
                    </div>
                </div>
                
                @if (capacitacionesDocente.Any())
                {
                    <div style="margin-top: 15px;">
                        <strong>Total horas de capacitación:</strong> @capacitacionesDocente.Sum(c => c.Horas) horas
                    </div>
                }
                
                @if (evaluacionesDocente.Any())
                {
                    var promedioEvaluacion = evaluacionesDocente.Average(e => e.Puntaje);
                    <div style="margin-top: 10px;">
                        <strong>Promedio evaluaciones:</strong> 
                        <span style="background-color: @(promedioEvaluacion >= 75 ? "#4caf50" : "#ff9800"); color: white; padding: 4px 8px; border-radius: 12px; font-size: 12px;">
                            @promedioEvaluacion.ToString("F1") pts
                        </span>
                    </div>
                }
            </div>

            <!-- Lista de Verificación Documental -->
            <div style="background-color: white; border: 1px solid #ddd; border-radius: 6px; padding: 20px; margin-bottom: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h4 style="margin: 0;">Lista de Verificación Documental</h4>
                    <span style="background-color: @(GetColorProgresoHex()); color: white; padding: 4px 8px; border-radius: 12px; font-size: 12px;">
                        @documentosVerificados/@documentosRequeridos.Count verificados
                    </span>
                </div>
                
                @foreach (var documento in documentosRequeridos)
                {
                    <div style="border-bottom: 1px solid #eee; padding: 15px 0;">
                        <div style="display: flex; align-items: flex-start; gap: 15px;">
                            <input type="checkbox" @bind="documento.Verificado" @bind:after="ActualizarContador" 
                                   style="margin-top: 4px; transform: scale(1.2);" />
                            <div style="flex-grow: 1;">
                                <div style="font-weight: bold; margin-bottom: 5px;">@documento.Nombre</div>
                                @if (!string.IsNullOrEmpty(documento.Descripcion))
                                {
                                    <div style="font-size: 14px; color: #666; margin-bottom: 10px;">@documento.Descripcion</div>
                                }
                                
                                <!-- Mostrar datos reales del docente para este documento -->
                                @if (documentosDatosReales.ContainsKey(documento.Nombre))
                                {
                                    <details style="margin-top: 10px;">
                                        <summary style="cursor: pointer; padding: 8px; background-color: #f8f9fa; border-radius: 4px;">
                                            👁️ Ver documentos del docente (@documentosDatosReales[documento.Nombre].Count elemento(s))
                                        </summary>
                                        <div style="margin-top: 10px; padding: 15px; background-color: #f8f9fa; border-radius: 4px;">
                                            @RenderDocumentosRealesSimple(documento.Nombre)
                                        </div>
                                    </details>
                                }
                            </div>
                            <div>
                                @if (!documento.Verificado)
                                {
                                    <span style="background-color: #ff9800; color: white; padding: 4px 8px; border-radius: 12px; font-size: 12px;">Pendiente</span>
                                }
                                else
                                {
                                    <span style="background-color: #4caf50; color: white; padding: 4px 8px; border-radius: 12px; font-size: 12px;">Verificado</span>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Progreso de verificación -->
                <div style="margin-top: 20px;">
                    <div style="margin-bottom: 10px;"><strong>Progreso de Verificación</strong></div>
                    <div style="background-color: #e0e0e0; border-radius: 10px; height: 20px; position: relative;">
                        <div style="background-color: @(GetColorProgresoHex()); height: 100%; border-radius: 10px; width: @(porcentajeVerificacion)%; transition: width 0.3s ease;"></div>
                    </div>
                    <div style="font-size: 12px; color: #666; margin-top: 5px;">@porcentajeVerificacion.ToString("F0")% completado</div>
                </div>
                
                <!-- Instrucciones para verificación -->
                <div style="background-color: #e3f2fd; padding: 15px; border-radius: 6px; margin-top: 20px;">
                    <strong>Instrucciones:</strong> Para cada documento requerido, expanda la sección "Ver documentos del docente" 
                    para revisar la información registrada en el sistema. Marque como verificado solo si cumple con los requisitos.
                    Los documentos mostrados son los que el docente ha registrado en su perfil del sistema.
                </div>
            </div>

            <!-- Observaciones Generales -->
            <div style="background-color: white; border: 1px solid #ddd; border-radius: 6px; padding: 20px; margin-bottom: 20px;">
                <h4 style="margin-top: 0;">Observaciones de Talento Humano</h4>
                <textarea @bind="observacionesGenerales" 
                         placeholder="Escriba sus observaciones sobre la verificación documental..."
                         style="width: 100%; height: 100px; padding: 10px; border: 1px solid #ddd; border-radius: 4px; resize: vertical;"></textarea>
            </div>
            
            <!-- Botones de acción -->
            <div style="display: flex; gap: 10px; justify-content: flex-end; padding-top: 15px; border-top: 1px solid #ddd;">
                <button @onclick="CerrarModalVerificacion" 
                        style="padding: 10px 20px; border: 1px solid #ddd; background-color: white; border-radius: 4px; cursor: pointer;">
                    Cancelar
                </button>
                <button @onclick="GuardarProgreso" disabled="@procesando"
                        style="padding: 10px 20px; border: 1px solid #2196f3; background-color: #2196f3; color: white; border-radius: 4px; cursor: pointer;">
                    @if (procesando) { <span>Procesando...</span> } else { <span>Guardar Progreso</span> }
                </button>
                <button @onclick="RechazarSolicitud" disabled="@procesando"
                        style="padding: 10px 20px; border: 1px solid #f44336; background-color: #f44336; color: white; border-radius: 4px; cursor: pointer;">
                    @if (procesando) { <span>Procesando...</span> } else { <span>Rechazar</span> }
                </button>
                <button @onclick="CompletarVerificacion" disabled="@(procesando || !TodosDocumentosVerificados())"
                        style="padding: 10px 20px; border: 1px solid #4caf50; background-color: #4caf50; color: white; border-radius: 4px; cursor: pointer;">
                    @if (procesando) { <span>Procesando...</span> } else { <span>Completar Verificación</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private string errorMessage = string.Empty;
    private List<SolicitudWorkflowDto> todasLasSolicitudes = new List<SolicitudWorkflowDto>();
    private bool mostrarModalVerificacion = false;
    private SolicitudWorkflowDto? solicitudEnVerificacion = null;
    private string observacionesGenerales = string.Empty;
    private bool procesando = false;
    private int documentosVerificados = 0;
    private double porcentajeVerificacion = 0;

    private List<DocumentoVerificacion> documentosRequeridos = new List<DocumentoVerificacion>();
    
    // Datos reales del docente para verificación
    private Dictionary<string, List<object>> documentosDatosReales = new Dictionary<string, List<object>>();
    private List<EvaluacionDocenteDto> evaluacionesDocente = new List<EvaluacionDocenteDto>();
    private List<CursoCapacitacionDto> capacitacionesDocente = new List<CursoCapacitacionDto>();
    private List<PublicacionAcademicaDto> publicacionesDocente = new List<PublicacionAcademicaDto>();
    private List<ProyectoInvestigacionDto> proyectosDocente = new List<ProyectoInvestigacionDto>();

    private DialogOptions dialogOptions = new DialogOptions() 
    { 
        MaxWidth = MaxWidth.ExtraLarge, 
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    // Listas filtradas
    private List<SolicitudWorkflowDto> solicitudesPendientes => 
        todasLasSolicitudes.Where(s => s.Estado == "PENDIENTE").ToList();

    private List<SolicitudWorkflowDto> solicitudesEnProceso => 
        todasLasSolicitudes.Where(s => s.Estado == "EN_VERIFICACION").ToList();

    private List<SolicitudWorkflowDto> solicitudesVerificadas => 
        todasLasSolicitudes.Where(s => s.Estado == "VERIFICADA").ToList();

    private List<SolicitudWorkflowDto> solicitudesRechazadas => 
        todasLasSolicitudes.Where(s => s.Estado == "RECHAZADA").ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }

    private async Task CargarSolicitudes()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            var response = await Http.GetAsync("http://localhost:5015/api/SolicitudAvanceRango");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                todasLasSolicitudes = JsonSerializer.Deserialize<List<SolicitudWorkflowDto>>(json, options) ?? new List<SolicitudWorkflowDto>();
            }
            else
            {
                errorMessage = "Error al cargar las solicitudes";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task IniciarVerificacion(SolicitudWorkflowDto solicitud)
    {
        try
        {
            Snackbar.Add($"Iniciando verificación para {solicitud.DocenteNombre}", Severity.Info);
            
            solicitudEnVerificacion = solicitud;
            observacionesGenerales = string.Empty;
            
            // Cargar documentos requeridos según el nivel solicitado
            CargarDocumentosRequeridos(solicitud.NuevoNivel);
            
            // Cargar datos reales del docente
            await CargarDatosRealesDocente(solicitud.DocenteId);
            
            ActualizarContador();
            mostrarModalVerificacion = true;
            
            StateHasChanged(); // Forzar actualización de la UI
            
            Snackbar.Add("Modal de verificación abierto", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al iniciar verificación: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarDatosRealesDocente(int docenteId)
    {
        try
        {
            // Limpiar datos anteriores
            documentosDatosReales.Clear();
            
            // Cargar evaluaciones del docente
            evaluacionesDocente = await DocenteService.ObtenerEvaluacionesPorDocenteAsync(docenteId);
            if (evaluacionesDocente.Any())
            {
                documentosDatosReales["Evaluaciones docentes"] = evaluacionesDocente.Cast<object>().ToList();
            }
            
            // Cargar capacitaciones
            capacitacionesDocente = await DocenteService.ObtenerCapacitacionesPorDocenteAsync(docenteId);
            if (capacitacionesDocente.Any())
            {
                documentosDatosReales["Certificados de capacitación"] = capacitacionesDocente.Cast<object>().ToList();
            }
            
            // Cargar publicaciones
            publicacionesDocente = await DocenteService.ObtenerPublicacionesPorDocenteAsync(docenteId);
            if (publicacionesDocente.Any())
            {
                documentosDatosReales["Publicaciones académicas"] = publicacionesDocente.Cast<object>().ToList();
            }
            
            // Cargar proyectos de investigación
            proyectosDocente = await DocenteService.ObtenerProyectosPorDocenteAsync(docenteId);
            if (proyectosDocente.Any())
            {
                documentosDatosReales["Proyectos de investigación"] = proyectosDocente.Cast<object>().ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos del docente: {ex.Message}", Severity.Warning);
        }
    }

    private RenderFragment RenderDocumentosReales(string tipoDocumento)
    {
        return @<div>
            @if (documentosDatosReales.ContainsKey(tipoDocumento))
            {
                var documentos = documentosDatosReales[tipoDocumento];
                
                @switch (tipoDocumento)
                {
                    case "Evaluaciones docentes":
                        <MudTable Items="@evaluacionesDocente" Dense="true" Hover="true" Class="mt-2">
                            <HeaderContent>
                                <MudTh>Período</MudTh>
                                <MudTh>Puntaje</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Fecha</MudTh>
                                <MudTh>Estado</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Periodo</MudTd>
                                <MudTd>
                                    <MudChip T="string" Color="@(context.Puntaje >= 75 ? Color.Success : Color.Warning)" Size="Size.Small">
                                        @context.Puntaje pts
                                    </MudChip>
                                </MudTd>
                                <MudTd>@context.TipoEvaluacion</MudTd>
                                <MudTd>@context.FechaEvaluacion.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd>
                                    <MudChip T="string" Color="@(context.Puntaje >= 75 ? Color.Success : Color.Error)" Size="Size.Small">
                                        @(context.Puntaje >= 75 ? "Cumple" : "No Cumple")
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        break;
                        
                    case "Certificados de capacitación":
                        <MudTable Items="@capacitacionesDocente" Dense="true" Hover="true" Class="mt-2">
                            <HeaderContent>
                                <MudTh>Curso</MudTh>
                                <MudTh>Horas</MudTh>
                                <MudTh>Fecha Inicio</MudTh>
                                <MudTh>Fecha Fin</MudTh>
                                <MudTh>Externo</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Nombre</MudTd>
                                <MudTd>
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                        @context.Horas h
                                    </MudChip>
                                </MudTd>
                                <MudTd>@context.FechaInicio.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd>@context.FechaFin.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd>
                                    <MudChip T="string" Color="@(context.Externo ? Color.Warning : Color.Info)" Size="Size.Small">
                                        @(context.Externo ? "Externo" : "Interno")
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        <MudText Typo="Typo.caption" Class="mt-2">
                            <strong>Total horas:</strong> @capacitacionesDocente.Sum(c => c.Horas) horas
                        </MudText>
                        break;
                        
                    case "Publicaciones académicas":
                        <MudTable Items="@publicacionesDocente" Dense="true" Hover="true" Class="mt-2">
                            <HeaderContent>
                                <MudTh>Título</MudTh>
                                <MudTh>Revista/Editorial</MudTh>
                                <MudTh>Año</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Estado</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                                        @context.Titulo
                                    </MudText>
                                </MudTd>
                                <MudTd>@context.Revista</MudTd>
                                <MudTd>@context.Anio</MudTd>
                                <MudTd>
                                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small">
                                        @context.Tipo
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                        Publicado
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        break;
                        
                    case "Proyectos de investigación":
                        <MudTable Items="@proyectosDocente" Dense="true" Hover="true" Class="mt-2">
                            <HeaderContent>
                                <MudTh>Título</MudTh>
                                <MudTh>Período</MudTh>
                                <MudTh>Duración</MudTh>
                                <MudTh>Estado</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                                        @context.Titulo
                                    </MudText>
                                </MudTd>
                                <MudTd>@context.FechaInicio.ToString("MM/yyyy") - @context.FechaFin.ToString("MM/yyyy")</MudTd>
                                <MudTd>
                                    @{
                                        var meses = (context.FechaFin.Year - context.FechaInicio.Year) * 12 + (context.FechaFin.Month - context.FechaInicio.Month);
                                    }
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                        @meses meses
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Color="@(context.FechaFin > DateTime.Now ? Color.Warning : Color.Success)" Size="Size.Small">
                                        @(context.FechaFin > DateTime.Now ? "En curso" : "Completado")
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        break;
                        
                    default:
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            No hay documentos específicos disponibles para mostrar.
                        </MudAlert>
                        break;
                }
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2">
                    El docente no ha registrado documentos de este tipo en el sistema.
                </MudAlert>
            }
        </div>;
    }

    private async Task ContinuarVerificacion(SolicitudWorkflowDto solicitud)
    {
        // Para solicitudes en proceso, cargar el progreso existente y datos del docente
        await IniciarVerificacion(solicitud);
    }

    private void CargarDocumentosRequeridos(string nivelSolicitado)
    {
        // Lista base de documentos requeridos
        documentosRequeridos = new List<DocumentoVerificacion>
        {
            new DocumentoVerificacion 
            { 
                Nombre = "Solicitud formal de promoción", 
                Descripcion = "Solicitud debidamente firmada por el docente",
                Verificado = false, 
                Obligatorio = true 
            },
            new DocumentoVerificacion 
            { 
                Nombre = "Hoja de vida actualizada", 
                Descripcion = "CV actualizado con toda la información académica y profesional",
                Verificado = false, 
                Obligatorio = true 
            },
            new DocumentoVerificacion 
            { 
                Nombre = "Cédula de identidad", 
                Descripcion = "Copia certificada de la cédula de identidad vigente",
                Verificado = false, 
                Obligatorio = true 
            },
            new DocumentoVerificacion 
            { 
                Nombre = "Título de tercer nivel", 
                Descripcion = "Copia certificada del título de grado registrado en SENESCYT",
                Verificado = false, 
                Obligatorio = true 
            },
            new DocumentoVerificacion 
            { 
                Nombre = "Certificado de tiempo de servicio", 
                Descripcion = "Certificado que acredite el tiempo mínimo requerido en el nivel actual",
                Verificado = false, 
                Obligatorio = true 
            },
            new DocumentoVerificacion 
            { 
                Nombre = "Evaluaciones docentes", 
                Descripcion = "Certificados de evaluación docente con puntaje ≥75%",
                Verificado = false, 
                Obligatorio = true 
            },
            new DocumentoVerificacion 
            { 
                Nombre = "Certificados de capacitación", 
                Descripcion = "Certificados de cursos de capacitación que cumplan las horas requeridas",
                Verificado = false, 
                Obligatorio = true 
            },
            new DocumentoVerificacion 
            { 
                Nombre = "Publicaciones académicas", 
                Descripcion = "Certificados de publicaciones académicas según requisitos del nivel",
                Verificado = false, 
                Obligatorio = true 
            }
        };

        // Agregar documentos específicos según el nivel
        switch (nivelSolicitado)
        {
            case "DT3":
            case "DT4":
            case "DT5":
                documentosRequeridos.Add(new DocumentoVerificacion 
                { 
                    Nombre = "Proyectos de investigación", 
                    Descripcion = "Certificados de participación en proyectos de investigación",
                    Verificado = false, 
                    Obligatorio = true 
                });
                break;
        }

        if (nivelSolicitado == "DT4" || nivelSolicitado == "DT5")
        {
            documentosRequeridos.Add(new DocumentoVerificacion 
            { 
                Nombre = "Título de cuarto nivel", 
                Descripcion = "Copia certificada de título de posgrado (si aplica)",
                Verificado = false, 
                Obligatorio = false 
            });
        }
    }

    private void ActualizarContador()
    {
        documentosVerificados = documentosRequeridos.Count(d => d.Verificado);
        porcentajeVerificacion = documentosRequeridos.Any() ? 
            (double)documentosVerificados / documentosRequeridos.Count * 100 : 0;
        StateHasChanged();
    }

    private Color GetColorProgreso()
    {
        return porcentajeVerificacion switch
        {
            >= 100 => Color.Success,
            >= 75 => Color.Info,
            >= 50 => Color.Warning,
            _ => Color.Error
        };
    }

    private string GetColorProgresoHex()
    {
        return porcentajeVerificacion switch
        {
            >= 100 => "#4caf50",
            >= 75 => "#2196f3",
            >= 50 => "#ff9800",
            _ => "#f44336"
        };
    }

