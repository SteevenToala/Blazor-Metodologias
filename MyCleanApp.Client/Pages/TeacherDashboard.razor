@page "/teacher-dashboard"

@using MyCleanApp.Client.Components
@using MyCleanApp.Client.DTOs
@using MudBlazor

@inject LocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject EvaluacionService EvaluacionService
@inject DocenteService DocenteService

@if (dashBoardDocente == null)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-16">
        <div class="d-flex justify-center">
            <MudProgressCircular style="color: #8B1538;" Size="Size.Large" Indeterminate="true" />
        </div>
        <MudText Align="Align.Center" Class="mt-4" Color="Color.Secondary">Cargando datos del dashboard...</MudText>
    </MudContainer>
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Style="background-color: #8B1538;">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            <MudText Typo="Typo.h6">Panel del Docente</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="@LogoutHandler" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
            <MudNavMenu Class="pt-4">
                 @foreach (var item in SideMenu)
                 {
                     <MudNavLink OnClick="@(() => CambiarSeccion(item.id))"
                                 Icon="@item.icon"
                                 Style="@GetNavLinkStyle(item.id)"
                                 IconColor="@(selectedSection == item.id ? Color.Primary : Color.Inherit)">
                         @item.label
                     </MudNavLink>
                 }
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 pt-6">
                @switch (selectedSection)
                {
                    case "overview":
                        <MudPaper Elevation="2" Class="pa-6 mb-6" Style="background: linear-gradient(135deg, #8B1538 0%, #A61E4D 100%); color: white;">
                            <div class="d-flex flex-column flex-md-row align-start justify-space-between gap-4">
                                <div>
                                    <MudText Typo="Typo.h3" Class="mb-2 font-weight-bold">
                                        Bienvenido, @(loginResponse?.usuario?.Nombre ?? "Usuario")
                                    </MudText>
                                    <div class="d-flex align-center">
                                        <MudText Typo="Typo.body1" Class="mr-2">Nivel actual:</MudText>
                                        <MudChip T="string" Color="Color.Surface" Label="true" Size="Size.Small" Style="background-color: rgba(255, 255, 255, 0.9); color: #8B1538; font-weight: bold;">
                                            @dashBoardDocente.NivelAcademico
                                        </MudChip>
                                    </div>
                                </div>
                            </div>
                        </MudPaper>
                        <MudGrid Spacing="4">
                            <MudItem xs="12">
                                @{
                                    var nivelActual = dashBoardDocente.NivelAcademico;
                                    var prefijo = nivelActual.Substring(0, nivelActual.Length - 1);
                                    var numero = int.TryParse(nivelActual.Substring(nivelActual.Length - 1), out var n) ? n : 1;
                                    var siguienteNivel = numero < 5 ? $"{prefijo}{numero + 1}" : nivelActual;
                                    var requisitosCumplidos = requirements.Count(r => r.Completed);
                                    var totalRequisitos = requirements.Count;
                                    var mensaje = requisitosCumplidos == totalRequisitos
                                        ? $"¡Felicidades! Cumples con todos los requisitos para avanzar a {siguienteNivel}"
                                        : $"Progreso hacia {siguienteNivel}";
                                }
                                <MudAlert Severity="@(progressPercentage == 100 ? Severity.Success : Severity.Info)" Variant="Variant.Filled" Style="@(progressPercentage == 100 ? "background-color: #2E7D32;" : "background-color: #8B1538;")">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@(progressPercentage == 100 ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.TrendingUp)" Class="mr-3" />
                                        <div>
                                            <MudText Typo="Typo.h6" Class="mb-1">@mensaje</MudText>
                                            <MudText Typo="Typo.body2">
                                                Has completado @requisitosCumplidos de @totalRequisitos requisitos necesarios.
                                            </MudText>
                                        </div>
                                    </div>
                                </MudAlert>
                            </MudItem>
                            @foreach (var requirement in requirements)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCard Elevation="3" Style="height: 100%; border-left: 4px solid #8B1538;">
                                        <MudCardContent Class="pa-4">
                                            <div class="d-flex align-center mb-3">
                                                <MudIcon Icon="@GetRequirementIcon(requirement.Name)" Style="color: #8B1538;" Class="mr-2" />
                                                <MudText Typo="Typo.body2" Style="color: #666; font-weight: 500;">
                                                    @requirement.Name
                                                </MudText>
                                            </div>
                                            <MudText Typo="Typo.h4" Class="mb-3" Style="font-weight: bold; color: #333;">
                                                @requirement.Current / @requirement.Required
                                            </MudText>
                                            @{
                                                var percentage = requirement.Required > 0 ? Math.Min((double)requirement.Current / requirement.Required * 100, 100) : 0;
                                            }
                                            <MudProgressLinear Color="@(requirement.Completed ? Color.Success : Color.Primary)" Value="@percentage" Size="Size.Medium" Rounded="true" Style="@(requirement.Completed ? "--mud-palette-success: #8B1538;" : "--mud-palette-primary: #8B1538;")" />
                                            @if (requirement.Completed)
                                            {
                                                <div class="d-flex align-center mt-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" style="color: #8B1538;" Size="Size.Small" Class="mr-1" />
                                                    <MudText Typo="Typo.caption" Style="color: #8B1538;">Completado</MudText>
                                                </div>
                                            }
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                        break;
                    case "requirements":
                        <MudPaper Elevation="1" Class="pa-4 mb-4">
                            @* <MudText Typo="Typo.h5" Class="mb-2" Style="color: #8B1538;">Requisitos de Promoción</MudText> *@
                            <RequisitoPromocionMud />
                        </MudPaper>
                        break;
                    case "evaluations":
                        <MudPaper Elevation="1" Class="pa-4 mb-4">
                            <TeacherDashboardEvaluacionesMud OnImportarCompletado="RecargarEvaluacionesDocentes" />
                        </MudPaper>
                        break;
                    case "papers":
                         <MudPaper Elevation="1" Class="pa-4 mb-4">
                            @* <MudText Typo="Typo.h5" Class="mb-2" Style="color: #8B1538;">Publicaciones Académicas</MudText> *@
                            <TeacherDashboardPapersMud PublicacionesAcademicas="publicacionesAcademicas" OnImportarCompletado="RecargarPublicacionesAcademicas" />
                        </MudPaper>
                        break;
                    case "training":
                        <MudPaper Elevation="1" Class="pa-4 mb-4">
                            @* <MudText Typo="Typo.h5" Class="mb-2" Style="color: #8B1538;">Capacitaciones</MudText> *@
                            <TeacherDashboardTraining TrainingHours="@dashBoardDocente.HorasCapacitacion" RequiredHours="@dashBoardDocente.GetValorRequerido("Horas Capacitación")" />
                        </MudPaper>
                        break;
                    case "research":
                         <MudPaper Elevation="1" Class="pa-4 mb-4">
                            @* <MudText Typo="Typo.h5" Class="mb-2" Style="color: #8B15_38;">Investigación</MudText> *@
                            <TeacherDashboardResearch ProyectosInvestigacion="proyectosInvestigacion" OnProyectosActualizados="RecargarProyectosInvestigacion" />
                        </MudPaper>
                        break;
                }
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}


@code {
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void IrASubirPublicacion()
    {
        Navigation.NavigateTo("/subir-publicacion");
    }

    private LoginResponse? loginResponse;
    private DashBoardDocente? dashBoardDocente;
    private List<PublicacionAcademicaDto> publicacionesAcademicas = new();
    private List<ProyectoInvestigacionDto> proyectosInvestigacion = new();
    private List<MyCleanApp.Client.DTOs.EvaluacionDocenteDto> evaluacionesDocentes = new();
    private double promedioEvaluaciones = 0;
    private List<Requirement> requirements = new();
    private string nextLevel = string.Empty;
    private string selectedSection = "overview";

    private List<(string id, string label, string icon)> SideMenu = new()
    {
        ("overview", "Resumen", Icons.Material.Filled.Dashboard),
        ("requirements", "Requisitos de Promoción", Icons.Material.Filled.AssignmentTurnedIn),
        ("evaluations", "Evaluaciones", Icons.Material.Filled.Assessment),
        ("papers", "Publicaciones", Icons.Material.Filled.Description),
        ("training", "Capacitaciones", Icons.Material.Filled.School),
        ("research", "Investigación", Icons.Material.Filled.Science)
    };
    private async Task RecargarPublicacionesAcademicas()
    {
        var publicaciones = await DocenteService.getPublicacionesAcademicas();
        if (publicaciones != null)
        {
            publicacionesAcademicas = publicaciones.ToList();
            StateHasChanged();
        }
    }

    private async Task RecargarProyectosInvestigacion()
    {
        var proyectos = await DocenteService.GetProyectosInvestigacionAsync();
        if (proyectos != null)
        {
            proyectosInvestigacion = proyectos;
            // Recargar requisitos desde el backend para obtener el cálculo correcto
            await CargarRequisitos();
            StateHasChanged();
        }
    }

    private async Task RecargarEvaluacionesDocentes()
    {
        try
        {
            var evaluaciones = await DocenteService.getEvaluacionesDocentes();
            if (evaluaciones != null)
            {
                // Crear una nueva lista convertida 
                evaluacionesDocentes = new List<MyCleanApp.Client.DTOs.EvaluacionDocenteDto>();
                foreach (var eval in evaluaciones)
                {
                    // Usar reflexión para copiar propiedades si es necesario, o simplemente convertir tipo
                    evaluacionesDocentes.Add((MyCleanApp.Client.DTOs.EvaluacionDocenteDto)(object)eval);
                }
            }

            var promedio = await DocenteService.ObtenerPromedioEvaluacionesAsync();
            promedioEvaluaciones = promedio;
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar evaluaciones: {ex.Message}");
            evaluacionesDocentes = new List<MyCleanApp.Client.DTOs.EvaluacionDocenteDto>();
            promedioEvaluaciones = 0;
        }
    }

    private async Task RecargarRequisitos()
    {
        // Recargar proyectos de investigación para tener datos actualizados
        var proyectosActualizados = await DocenteService.GetProyectosInvestigacionAsync();
        if (proyectosActualizados != null)
        {
            proyectosInvestigacion = proyectosActualizados;
        }
        
        await CargarRequisitos();
        StateHasChanged();
    }

    private async Task CargarRequisitos()
    {
        try
        {
            var requisitosResponse = await DocenteService.ObtenerRequisitosPromocionAsync();
            if (requisitosResponse != null && requisitosResponse.Requisitos != null)
            {
                requirements = requisitosResponse.Requisitos.Select(r => new Requirement
                {
                    Name = r.TipoRequisito,
                    Current = (int)r.ValorActual,
                    Required = (int)r.ValorRequerido,
                    Completed = r.Cumple
                }).ToList();

                Console.WriteLine($"Requisitos cargados del backend: {requirements.Count}");
                foreach (var req in requirements)
                {
                    Console.WriteLine($"Requisito: {req.Name}, Actual: {req.Current}, Requerido: {req.Required}, Cumplido: {req.Completed}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar requisitos: {ex.Message}");
            // Mantener los requisitos de fallback si hay error
        }
    }
    protected override async Task OnInitializedAsync()
    {
        loginResponse = await LocalStorage.ObtenerObjetoAsync<LoginResponse>("loginResponse");
        if (loginResponse != null && loginResponse.usuario != null)
        {
            var dashboard = await DocenteService.getDataDashBoard();
            var publicaciones = await DocenteService.getPublicacionesAcademicas();
            var proyectos = await DocenteService.GetProyectosInvestigacionAsync();
            
            // Cargar evaluaciones docentes
            await RecargarEvaluacionesDocentes();
            
            if (dashboard != null)
            {
                dashBoardDocente = dashboard;
                if (publicaciones != null)
                {
                    publicacionesAcademicas = publicaciones.ToList();
                }
                if (proyectos != null)
                {
                    proyectosInvestigacion = proyectos;
                }
                // Calcular el siguiente nivel para mostrar en la UI
                var nivelActual = dashBoardDocente.NivelAcademico;
                var prefijo = nivelActual.Substring(0, nivelActual.Length - 1);
                var numero = int.TryParse(nivelActual.Substring(nivelActual.Length - 1), out var n) ? n : 1;
                nextLevel = numero < 5 ? $"{prefijo}{numero + 1}" : nivelActual;
                
                // Cargar requisitos usando el nuevo método
                await CargarRequisitos();
                
                // Si no hay requisitos, crear algunos de fallback para testing
                if (requirements == null || requirements.Count == 0)
                {
                    Console.WriteLine("No se encontraron requisitos, creando fallback...");
                    
                    requirements = new List<Requirement>
                    {
                        new Requirement { Name = "Años en nivel actual", Current = dashBoardDocente.AniosEnNivel, Required = 3, Completed = dashBoardDocente.AniosEnNivel >= 3 },
                        new Requirement { Name = "Publicaciones académicas", Current = dashBoardDocente.PublicacionesAcademicas, Required = 2, Completed = dashBoardDocente.PublicacionesAcademicas >= 2 },
                        new Requirement { Name = "Puntaje de evaluación", Current = (int)dashBoardDocente.PuntajeEvaluacion, Required = 85, Completed = dashBoardDocente.PuntajeEvaluacion >= 85 },
                        new Requirement { Name = "Horas de capacitación", Current = dashBoardDocente.HorasCapacitacion, Required = 40, Completed = dashBoardDocente.HorasCapacitacion >= 40 },
                        new Requirement { Name = "Investigaciones", Current = proyectosInvestigacion?.Count ?? 0, Required = 2, Completed = (proyectosInvestigacion?.Count ?? 0) >= 2 }
                    };
                }
            }
            else
            {
                Console.WriteLine("No se pudo obtener el dashboard.");
            }
        }
        else
        {
            Console.WriteLine("No login, redirigiendo...");
            Navigation.NavigateTo("/login", true);
        }
    }

    private double progressPercentage => requirements.Count == 0 ? 0 : (requirements.Count(r => r.Completed) * 100.0 / requirements.Count);

    private string GetRequirementIcon(string requirementName)
    {
        return requirementName.ToLower() switch
        {
            "años en el rango" or "años en nivel actual" => Icons.Material.Filled.CalendarToday,
            "papers" or "publicaciones académicas" => Icons.Material.Filled.Description,
            "puntaje evaluación" or "puntaje de evaluación" => Icons.Material.Filled.Star,
            "horas capacitación" or "horas de capacitación" => Icons.Material.Filled.Schedule,
            "investigaciones" or "meses en investigación" => Icons.Material.Filled.Science,
            _ => Icons.Material.Filled.CheckCircle
        };
    }

    private string GetNavLinkStyle(string id)
    {
        if (selectedSection == id)
        {
            return "color: #8B1538; background-color: #F8F0F2; border-right: 3px solid #8B1538; font-weight: bold;";
        }
        return "color: #333; font-weight: normal;";
    }

    private void CambiarSeccion(string id)
    {
        selectedSection = id;
        StateHasChanged();
    }

    private async void LogoutHandler()
    {
        // Limpiar sesión y local storage
        await LocalStorage.EliminarAsync("loginResponse");
        loginResponse = null;
        dashBoardDocente = null;
        // Redirigir al login
        Navigation.NavigateTo("/login", true);
    }
}