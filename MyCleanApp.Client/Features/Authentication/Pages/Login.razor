@page "/login"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthService AuthService
@inject LocalStorageService LocalStorageService
@inherits LayoutComponentBase
@code {
    private LoginResponse? loginResponse;
protected override async Task OnInitializedAsync()
{
    loginResponse = await LocalStorageService.ObtenerObjetoAsync<LoginResponse>("loginResponse");
    if (loginResponse != null && loginResponse.usuario != null)
    {
        Console.WriteLine("Usuario logueado: " + loginResponse.usuario.Rol);
        switch (loginResponse.usuario.Rol)
        {
            case "ADMINISTRADOR":
                Navigation.NavigateTo("/admin-dashboard", true);
                break;
            case "DOCENTE":
                Navigation.NavigateTo("/teacher-dashboard", true);
                break;
            case "TALENTO_HUMANO":
                Navigation.NavigateTo("/talento-humano-dashboard", true);
                break;
            case "COMISION_PRESIDENTE":
                Navigation.NavigateTo("/comision-presidente-dashboard", true);
                break;
            case "COMISION_MIEMBRO":
                Navigation.NavigateTo("/comision-miembro-dashboard", true);
                break;
            case "CONSEJO_UNIVERSITARIO":
                Navigation.NavigateTo("/consejo-universitario-dashboard", true);
                break;
        }
    }
}
    public class LoginModel
    {
        public string EmailField { get; set; } = string.Empty;
        public string PasswordField { get; set; } = string.Empty;
    }

    private LoginModel Model = new();
    [Parameter]
    [SupplyParameterFromQuery]
    public string? RoleParam { get; set; } = "teacher";

    private string ErrorMsg { get; set; } = string.Empty;

    private async void HandleSubmit()
    {
        var loginData = new LoginRequest
        {
            correo = Model.EmailField,
            contraseña = Model.PasswordField
        };

        var result = await AuthService.LoginAsync(loginData);
        if (result != null)
        {
            if (result.usuario == null)
            {
                ErrorMsg = "Usuario inválido en la respuesta del servidor.";
                return;
            }
            
            // Permitir acceso a todos los roles del sistema
            var rolesPermitidos = new[] { "DOCENTE", "ADMINISTRADOR", "TALENTO_HUMANO", 
                                        "COMISION_PRESIDENTE", "COMISION_MIEMBRO", "CONSEJO_UNIVERSITARIO" };
            
            if (!rolesPermitidos.Contains(result.usuario.Rol))
            {
                ErrorMsg = "No tienes permisos para acceder al sistema.";
                return;
            }
            
            await LocalStorageService.GuardarObjetoAsync("loginResponse", result);
            
            // Redirigir según el rol
            switch (result.usuario.Rol)
            {
                case "ADMINISTRADOR":
                    Navigation.NavigateTo("/admin-dashboard", true);
                    break;
                case "DOCENTE":
                    Navigation.NavigateTo("/teacher-dashboard", true);
                    break;
                case "TALENTO_HUMANO":
                    Navigation.NavigateTo("/talento-humano-dashboard", true);
                    break;
                case "COMISION_PRESIDENTE":
                    Navigation.NavigateTo("/comision-presidente-dashboard", true);
                    break;
                case "COMISION_MIEMBRO":
                    Navigation.NavigateTo("/comision-miembro-dashboard", true);
                    break;
                case "CONSEJO_UNIVERSITARIO":
                    Navigation.NavigateTo("/consejo-universitario-dashboard", true);
                    break;
                default:
                    Navigation.NavigateTo("/", true);
                    break;
            }
        }
        else
        {
            ErrorMsg = "Credenciales inválidas o error en el servidor.";
        }
    }

    private bool ShowPassword { get; set; } = false;
    private string PasswordInputType => ShowPassword ? "text" : "password";
    private void TogglePasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }
}

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center min-vh-100">
    <MudPaper Elevation="8" Class="pa-8 ma-4" Style="border-radius: 16px; border: 2px solid #8B1538; background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%); box-shadow: 0 16px 48px rgba(139, 21, 56, 0.15);">
        
        <!-- Header Section -->
        <div class="text-center mb-6">
            <MudAvatar Size="Size.Large" Style="background: linear-gradient(135deg, #8B1538 0%, #A91B47 100%); margin: 0 auto 16px auto;">
                <MudIcon Icon="@Icons.Material.Filled.School" Style="color: #ffffff;" Size="Size.Large" />
            </MudAvatar>
            
            <MudText Typo="Typo.h4" Style="color: #8B1538;" Class="font-weight-bold mb-2">
                Acceso al Sistema
            </MudText>
            
            <MudText Typo="Typo.body2" Style="color: #2d2d2d;">
                Introduce tus credenciales para acceder
            </MudText>
            
            <!-- Botón para volver al home -->
            <div class="mt-3">
                <MudButton Variant="Variant.Text"
                           Style="color: #8B1538; text-transform: none;"
                           StartIcon="@Icons.Material.Filled.Home"
                           OnClick="@(() => Navigation.NavigateTo("/"))">
                    Volver al Inicio
                </MudButton>
            </div>
        </div>

        <!-- Login Form -->
        <EditForm Model="Model" OnValidSubmit="HandleSubmit">
            <MudGrid Spacing="3">
                
                <!-- Email Field -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.EmailField"
                                  Label="Correo electrónico"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Style="--mud-palette-primary: #8B1538; --mud-palette-primary-text: #8B1538;"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  IconSize="Size.Medium" />
                </MudItem>

                <!-- Password Field -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.PasswordField"
                                  Label="Contraseña"
                                  Variant="Variant.Outlined"
                                  InputType="@(ShowPassword ? InputType.Text : InputType.Password)"
                                  Required="true"
                                  Style="--mud-palette-primary: #8B1538; --mud-palette-primary-text: #8B1538;"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(ShowPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  AdornmentColor="Color.Secondary" />
                </MudItem>

                <!-- Forgot Password Link -->
                <MudItem xs="12" Class="text-right">
                    <MudLink Href="#" Style="color: #8B1538;" Typo="Typo.caption">
                        ¿Olvidaste tu contraseña?
                    </MudLink>
                </MudItem>

                <!-- Submit Button -->
                <MudItem xs="12">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Style="background: linear-gradient(135deg, #8B1538 0%, #A91B47 100%); color: white; text-transform: none; font-weight: bold;"
                               FullWidth="true"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Login"
                               Class="mt-3">
                        Iniciar Sesión
                    </MudButton>
                </MudItem>

                <!-- Error Message -->
                @if (!string.IsNullOrEmpty(ErrorMsg))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" 
                                  Style="background-color: rgba(244, 67, 54, 0.1); border: 1px solid #f44336;">
                            @ErrorMsg
                        </MudAlert>
                    </MudItem>
                }

            </MudGrid>
        </EditForm>

        <!-- Additional Info -->
        <MudDivider Class="my-6" Style="border-color: rgba(139, 21, 56, 0.2);" />
        
        <div class="text-center">
            <MudText Typo="Typo.caption" Style="color: #666;">
                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Style="color: #8B1538;" Class="mr-1" />
                Acceso seguro con autenticación verificada
            </MudText>
        </div>

    </MudPaper>
</MudContainer>

<style>
    /* Custom styles for the login page */
    .min-vh-100 {
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
    }

    /* Button hover effects */
    .mud-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(139, 21, 56, 0.3) !important;
        transition: all 0.3s ease;
    }

    /* TextField focus styling */
    .mud-input-control-input-container:focus-within {
        border-color: #8B1538 !important;
    }
</style>
