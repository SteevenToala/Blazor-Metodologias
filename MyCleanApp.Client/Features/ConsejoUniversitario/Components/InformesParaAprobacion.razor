@using MyCleanApp.Client.DTOs
@using System.Text.Json
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudPaper Elevation="1" Class="pa-4">
    <div class="d-flex align-center mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Description" Style="color: #8B1538;" Class="me-2" />
        <MudText Typo="Typo.h5" Style="color: #8B1538;">Informes para Aprobación</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CargarInformes">
            Actualizar
        </MudButton>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-center pa-4">
            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            @errorMessage
        </MudAlert>
    }
    else
    {
        <!-- Filtros y Estadísticas -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="8">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="6">
                                <div class="text-center">
                                    <MudText Typo="Typo.h4" Color="Color.Warning">@informesPendientes</MudText>
                                    <MudText Typo="Typo.caption">Listos para Aprobación</MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="6">
                                <div class="text-center">
                                    <MudText Typo="Typo.h6" Color="Color.Info">INFORMES_FINALES</MudText>
                                    <MudText Typo="Typo.caption">Estado Requerido</MudText>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="text-center">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Class="mt-2">Consejo Universitario</MudText>
                            <MudText Typo="Typo.caption">Aprobación Final de Promociones</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>                <!-- Lista de Informes -->
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Informes Finales de Promoción - Listos para Aprobación</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (informesFiltrados.Any())
                {
                    <MudTable Items="@informesFiltrados" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel SortBy="new Func<InformePromocion, object>(x => x.DocenteNombre)">Docente</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<InformePromocion, object>(x => x.NivelSolicitado)">Promoción</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<InformePromocion, object>(x => x.FechaSolicitud)">Fecha Solicitud</MudTableSortLabel></MudTh>
                            <MudTh>Estado</MudTh>
                            <MudTh>Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Docente">
                                <div class="d-flex align-center">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small" Class="me-2">
                                        @context.DocenteNombre.Substring(0, 1).ToUpper()
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body2"><strong>@context.DocenteNombre</strong></MudText>
                                        <MudText Typo="Typo.caption">ID: @context.Id</MudText>
                                    </div>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Promoción">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                    @context.NivelActual → @context.NivelSolicitado
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Fecha">@context.FechaSolicitud.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd DataLabel="Estado">
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">
                                    Pendiente Aprobación Final
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Acciones">
                                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                                    <MudButton Color="Color.Success" 
                                             OnClick="() => AprobarPromocionDirecta(context)"
                                             StartIcon="@Icons.Material.Filled.CheckCircle"
                                             Disabled="procesando">
                                        Aprobar Promoción
                                    </MudButton>
                                    <MudButton Color="Color.Error" 
                                             OnClick="() => RechazarPromocion(context)"
                                             StartIcon="@Icons.Material.Filled.Cancel"
                                             Disabled="procesando">
                                        Rechazar
                                    </MudButton>
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                                        <MudMenuItem OnClick="() => VerDetalleCompleto(context)">Ver Detalle</MudMenuItem>
                                        <MudMenuItem OnClick="() => DescargarInforme(context)">Descargar PDF</MudMenuItem>
                                    </MudMenu>
                                </MudButtonGroup>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                }
                else
                {
                    <div class="text-center pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Tertiary" />
                        <MudText Typo="Typo.h6" Color="Color.Tertiary" Class="mt-2">
                            No hay informes pendientes de aprobación
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">
                            Todos los informes han sido procesados o no hay solicitudes en estado "Informes Finales"
                        </MudText>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    }
</MudPaper>

@code {
    private bool loading = true;
    private string errorMessage = string.Empty;
    private List<InformePromocion> informes = new List<InformePromocion>();
    private List<InformePromocion> informesFiltrados = new List<InformePromocion>();
    
    private bool mostrarModalRevision = false;
    private InformePromocion? informeEnRevision = null;
    private bool procesando = false;

    // Filtros
    private string filtroEstado = string.Empty;

    // Estadísticas
    private int informesPendientes = 0;
    private int informesEnRevision = 0;
    private int informesAprobados = 0;
    private int informesRechazados = 0;

    private DialogOptions dialogOptionsLarge = new DialogOptions() { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await CargarInformes();
    }

    private async Task CargarInformes()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            var response = await Http.GetAsync("http://localhost:5015/api/consejo-universitario/informes-pendientes");
            if (response.IsSuccessStatusCode)
            {
                var solicitudes = await response.Content.ReadFromJsonAsync<List<SolicitudComisionDto>>() ?? new();
                
                // Convertir a formato del componente
                informes = solicitudes.Select(s => new InformePromocion
                {
                    Id = s.Id,
                    DocenteNombre = $"{s.DocenteNombre} {s.DocenteApellido}",
                    NivelActual = s.NivelActual,
                    NivelSolicitado = s.NivelSolicitado,
                    FechaSolicitud = s.FechaSolicitud,
                    Estado = s.Estado,
                    Observaciones = s.Observaciones ?? ""
                }).ToList();
                
                AplicarFiltros();
                CalcularEstadisticas();
            }
            else
            {
                errorMessage = "Error al cargar los informes";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // Nuevo método para aprobación directa
    private async Task AprobarPromocionDirecta(InformePromocion informe)
    {
        try
        {
            procesando = true;
            
            var response = await Http.PostAsync($"http://localhost:5015/api/consejo-universitario/solicitud/{informe.Id}/aprobar", null);
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"¡Promoción aprobada exitosamente! {informe.DocenteNombre} ha sido promovido a {informe.NivelSolicitado}.", 
                            Severity.Success);

                // Recargar la lista para reflejar los cambios
                await CargarInformes();
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al aprobar la promoción: {errorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            procesando = false;
        }
    }

    // Nuevo método para rechazar promoción
    private async Task RechazarPromocion(InformePromocion informe)
    {
        try
        {
            procesando = true;
            
            var response = await Http.PostAsJsonAsync($"http://localhost:5015/api/consejo-universitario/solicitud/{informe.Id}/rechazar", 
                                                    "Rechazado por el Consejo Universitario");
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Promoción de {informe.DocenteNombre} rechazada correctamente.", Severity.Warning);
                
                // Recargar la lista para reflejar los cambios
                await CargarInformes();
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al rechazar la promoción: {errorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            procesando = false;
        }
    }

    // Método para ver el detalle completo
    private void VerDetalleCompleto(InformePromocion informe)
    {
        informeEnRevision = informe;
        mostrarModalRevision = true;
    }

    private void AplicarFiltros()
    {
        informesFiltrados = informes.AsQueryable().ToList();

        if (!string.IsNullOrEmpty(filtroEstado))
        {
            informesFiltrados = informesFiltrados.Where(i => i.Estado == filtroEstado).ToList();
        }
    }

    private void CalcularEstadisticas()
    {
        informesPendientes = informes.Count(i => i.Estado == "INFORMES_FINALES");
        informesEnRevision = 0; // No usamos este estado
        informesAprobados = 0; // Se mostrarán en otro panel
        informesRechazados = 0; // Se mostrarán en otro panel
    }

    private Color GetColorResultado(string resultado)
    {
        return resultado switch
        {
            "Favorable" => Color.Success,
            "Favorable con observaciones" => Color.Warning,
            "Desfavorable" => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetColorEstado(string estado)
    {
        return estado switch
        {
            "INFORMES_FINALES" => Color.Warning,
            "APROBADO" => Color.Success,
            "RECHAZADO" => Color.Error,
            _ => Color.Default
        };
    }

    private string GetTextoEstado(string estado)
    {
        return estado switch
        {
            "INFORMES_FINALES" => "Pendiente Aprobación",
            "APROBADO" => "Aprobado",
            "RECHAZADO" => "Rechazado",
            _ => estado
        };
    }

    // Métodos placeholder simplificados
    private async Task DescargarInforme(InformePromocion informe)
    {
        await JS.InvokeVoidAsync("alert", $"Descargar informe de {informe.DocenteNombre} - Funcionalidad en desarrollo");
    }

    // Clase de modelo
    public class InformePromocion
    {
        public int Id { get; set; }
        public string DocenteNombre { get; set; } = string.Empty;
        public string Facultad { get; set; } = string.Empty;
        public string NivelActual { get; set; } = string.Empty;
        public string NivelSolicitado { get; set; } = string.Empty;
        public DateTime FechaInforme { get; set; }
        public DateTime FechaSolicitud { get; set; }
        public string ResultadoComision { get; set; } = string.Empty;
        public string Estado { get; set; } = string.Empty;
        public string Prioridad { get; set; } = string.Empty;
        public string ResumenEjecutivo { get; set; } = string.Empty;
        public string RecomendacionComision { get; set; } = string.Empty;
        public string Observaciones { get; set; } = string.Empty;
    }
}
