        Console.WriteLine($"[DEBUG] Estado limpiado - showEditModal: {showEditModal}");
        StateHasChanged();
    }

    private async Task OnArchivoFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.GetMultipleFiles().FirstOrDefault();
        if (file != null)
        {
            try
            {
                // Validar tipo de archivo
                if (!file.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase) && 
                    !file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                {
                    modalMessageImportar = "❌ Error: Solo se permiten archivos PDF.";
                    showModalImportar = true;
                    return;
                }

                // Validar tamaño (5MB máximo)
                if (file.Size > 5 * 1024 * 1024)
                {
                    modalMessageImportar = "❌ Error: El archivo no debe superar los 5MB.";
                    showModalImportar = true;
                    return;
                }

                editArchivoFile = file;
                
                if (publicacionEditando != null)
                {
                    using var stream = file.OpenReadStream(5 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    publicacionEditando.Archivo = ms.ToArray();
                    
                    Console.WriteLine($"[DEBUG] Archivo cargado: {file.Name}, Tamaño: {file.Size} bytes");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ERROR] Error al cargar archivo: {ex.Message}");
                modalMessageImportar = $"❌ Error al cargar el archivo: {ex.Message}";
                showModalImportar = true;
                editArchivoFile = null;
            }
        }
    }

    private void LimpiarArchivoSeleccionado()
    {
        editArchivoFile = null;
        // Restaurar el archivo original si existía
        if (publicacionEditando != null)
        {
            // El archivo original se mantiene en la base de datos
            // Solo limpiamos la selección del nuevo archivo
            Console.WriteLine("[DEBUG] Archivo nuevo cancelado, manteniendo el original");
        }
        StateHasChanged();
    }

    private void EliminarArchivoActual()
    {
        if (publicacionEditando != null)
        {
            publicacionEditando.Archivo = null;
            editArchivoFile = null;
            Console.WriteLine("[DEBUG] Archivo actual marcado para eliminación");
            StateHasChanged();
        }
    }

    private bool FormularioValido()
    {
        return !string.IsNullOrWhiteSpace(editTitulo) &&
               !string.IsNullOrWhiteSpace(editRevista) &&
               !string.IsNullOrWhiteSpace(editVolumen) &&
               !string.IsNullOrWhiteSpace(editTipo) &&
               editAnio >= 1900 && editAnio <= DateTime.Now.Year;
    }

    private async Task GuardarEdicionPublicacion()
    {
        if (publicacionEditando == null || !FormularioValido()) return;
        
        isLoading = true;
        StateHasChanged();
        
        try
        {
            // Actualizar los campos básicos
            publicacionEditando.Titulo = editTitulo.Trim();
            publicacionEditando.Revista = editRevista.Trim();
            publicacionEditando.Volumen = editVolumen.Trim();
            publicacionEditando.Anio = editAnio;
            publicacionEditando.Tipo = editTipo.Trim();
            
            // Si hay un nuevo archivo seleccionado, ya se cargó en OnArchivoFileChanged
            // Si se eliminó el archivo, ya se estableció como null en EliminarArchivoActual
            
            Console.WriteLine($"[DEBUG] Guardando publicación: {publicacionEditando.Titulo}");
            Console.WriteLine($"[DEBUG] Archivo presente: {publicacionEditando.Archivo != null}");
            Console.WriteLine($"[DEBUG] Nuevo archivo: {editArchivoFile?.Name ?? "Ninguno"}");
            
            var response = await DocenteService.EditarPublicacionAsync(publicacionEditando);
            
            if (response)
            {
                modalMessageImportar = "✅ Publicación editada exitosamente.";
