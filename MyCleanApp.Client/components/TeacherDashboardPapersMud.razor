                // Notificar al componente padre para actualizar la lista
                if (OnImportarCompletado.HasDelegate)
                    await OnImportarCompletado.InvokeAsync();
                    
                Console.WriteLine("[DEBUG] Publicación guardada exitosamente");
            }
            else
            {
                modalMessageImportar = "❌ Error: No se pudo editar la publicación. Verifica los datos e intenta nuevamente.";
                showModalImportar = true;
                Console.WriteLine("[ERROR] Error al guardar publicación en el servidor");
