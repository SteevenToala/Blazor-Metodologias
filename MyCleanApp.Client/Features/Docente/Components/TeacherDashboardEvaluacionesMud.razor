    private int ObtenerIdDesdePdfUrl()
    {
        if (string.IsNullOrEmpty(pdfUrl)) return 0;
        
        try
        {
            var segments = pdfUrl.Split('/');
            var idStr = segments.LastOrDefault();
            return int.TryParse(idStr, out var id) ? id : 0;
        }
        catch
        {
            return 0;
        }
    }

    // Métodos de lógica de negocio (CRUD)
    private async Task ImportarEvaluacionesExternas()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var http = new HttpClient();
            var evaluacionesExternas = await http.GetFromJsonAsync<List<EvaluacionClienteType>>("http://localhost:3000/EvaluacionDocente");
            var soloExternas = evaluacionesExternas?.Where(e => e.Externo).ToList() ?? new List<EvaluacionClienteType>();

            // Clave para evitar duplicados: periodo, puntaje, tipo, fecha
            var evaluacionesActuales = EvaluacionesDocentes
                .Select(e => (e.Periodo?.Trim().ToLower() ?? "", e.Puntaje, e.TipoEvaluacion?.Trim().ToLower() ?? "", e.FechaEvaluacion.Date))
                .ToHashSet();

            int importadas = 0;
            foreach (var eval in soloExternas)
            {
                var key = (eval.Periodo?.Trim().ToLower() ?? "", eval.Puntaje, eval.TipoEvaluacion?.Trim().ToLower() ?? "", eval.FechaEvaluacion.Date);
                if (!evaluacionesActuales.Contains(key))
                {
                    var response = await DocenteService.ImportarEvaluacionExternaAsync(eval);
                    if (response) importadas++;
                }
            }

            // Recargar evaluaciones tras importar
            await CargarEvaluaciones();

            if (OnImportarCompletado.HasDelegate)
                await OnImportarCompletado.InvokeAsync();

            if (importadas > 0)
            {
                modalMessageImportar = $"✅ Se importaron {importadas} evaluación(es) nueva(s).";
            }
            else
            {
                modalMessageImportar = "ℹ️ No se importaron evaluaciones nuevas porque ya existen en el sistema.";
            }
            showModalImportar = true;
            StateHasChanged(); // Forzar refresco de la UI tras mostrar el modal
        }
        catch (Exception ex)
        {
            modalMessageImportar = $"❌ Error al importar evaluaciones externas: {ex.Message}";
            showModalImportar = true;
            StateHasChanged();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async void VerCertificado(int evaluacionId)
    {
        try
        {
            Console.WriteLine($"[DEBUG] Intentando ver certificado de evaluación ID: {evaluacionId}");
            
            // Verificar que la evaluación existe y tiene certificado
            var evaluacion = EvaluacionesDocentes.FirstOrDefault(e => e.Id == evaluacionId);
            if (evaluacion == null)
            {
                Console.WriteLine($"[ERROR] No se encontró la evaluación con ID: {evaluacionId}");
                modalMessageImportar = "❌ Error: No se encontró la evaluación seleccionada.";
                showModalImportar = true;
                return;
            }

            if (evaluacion.Certificado == null || evaluacion.Certificado.Length == 0)
            {
                Console.WriteLine($"[ERROR] La evaluación {evaluacionId} no tiene certificado asociado");
                modalMessageImportar = "❌ Esta evaluación no tiene un certificado PDF asociado.";
                showModalImportar = true;
                return;
            }

            Console.WriteLine($"[DEBUG] Evaluación encontrada: {evaluacion.TipoEvaluacion}");
            Console.WriteLine($"[DEBUG] Certificado presente: {evaluacion.Certificado.Length} bytes");
            
            // Construir la URL del PDF
            pdfUrl = $"http://localhost:5015/api/EvaluacionDocente/archivo/{evaluacionId}";
            
            Console.WriteLine($"[DEBUG] URL construida: {pdfUrl}");
            
            // Probar la URL antes de mostrar el modal
            try
            {
                var http = new HttpClient();
                http.Timeout = TimeSpan.FromSeconds(5);
                var response = await http.GetAsync(pdfUrl, HttpCompletionOption.ResponseHeadersRead);
                
                Console.WriteLine($"[DEBUG] Response status: {response.StatusCode}");
                Console.WriteLine($"[DEBUG] Content-Type: {response.Content.Headers.ContentType}");
                
                if (!response.IsSuccessStatusCode)
                {
                    Console.WriteLine($"[ERROR] El servidor devolvió error: {response.StatusCode}");
                    modalMessageImportar = $"❌ Error del servidor: {response.StatusCode}. No se puede mostrar el certificado.";
                    showModalImportar = true;
                    return;
                }
            }
            catch (Exception httpEx)
            {
                Console.WriteLine($"[ERROR] Error al verificar la URL: {httpEx.Message}");
                modalMessageImportar = $"❌ Error de conexión: {httpEx.Message}";
                showModalImportar = true;
                return;
            }
            
            // Mostrar el modal
            showPdfModal = true;
            
            Console.WriteLine($"[DEBUG] Modal PDF abierto: {showPdfModal}");
            
            StateHasChanged(); // Forzar actualización de la UI
            
            // Pequeño delay para asegurar que el modal se renderice
            await Task.Delay(100);
            
            Console.WriteLine($"[DEBUG] Estado final - showPdfModal: {showPdfModal}, pdfUrl: {pdfUrl}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Error al abrir visor de PDF: {ex.Message}");
            Console.WriteLine($"[ERROR] Stack trace: {ex.StackTrace}");
            modalMessageImportar = $"❌ Error al abrir el certificado PDF: {ex.Message}";
            showModalImportar = true;
        }
    }

