    private string selectedAnio = "";

    // Propiedades computadas para filtros
    private IEnumerable<string> TiposDisponibles => PublicacionesAcademicas
        .Select(p => p.Tipo)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct()
        .OrderBy(t => t);

    private IEnumerable<string> AniosDisponibles => PublicacionesAcademicas
        .Select(p => p.Anio.ToString())
        .Distinct()
        .OrderByDescending(a => a);

    private IEnumerable<PublicacionAcademicaDto> Filtradas => PublicacionesAcademicas
        .Where(p =>
            (string.IsNullOrWhiteSpace(searchTerm) || (p.Titulo?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrWhiteSpace(selectedTipo) || p.Tipo == selectedTipo) &&
            (string.IsNullOrWhiteSpace(selectedAnio) || p.Anio.ToString() == selectedAnio)
        );

    // Estado para modales
    private bool showModalImportar = false;
    private string modalMessageImportar = string.Empty;
    private bool showPdfModal = false;
    private string? pdfUrl;
    private bool showEditModal = false;

    // Estado para la edición de publicaciones
    private PublicacionAcademicaDto? publicacionEditando;
    private string editTitulo = string.Empty;
    private string editRevista = string.Empty;
    private string editVolumen = string.Empty;
    private int editAnio;
    private string editTipo = string.Empty;
    private IBrowserFile? editArchivoFile;
    private bool isLoading = false;
    
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("TeacherDashboardPapersMud initialized");
        await base.OnInitializedAsync();
    }
    
    // Métodos de navegación y acciones de la UI
    private void IrASubirPublicacion()
    {
        Navigation.NavigateTo("/subir-publicacion");
    }

    private void LimpiarFiltros()
    {
        searchTerm = string.Empty;
        selectedTipo = "";
        selectedAnio = "";
    }

    private void CerrarModalImportar() => showModalImportar = false;
    private void CerrarPdfModal()
    {
        Console.WriteLine("[DEBUG] Cerrando modal PDF");
        showPdfModal = false;
        pdfUrl = null;
        StateHasChanged();
    }

    // Métodos de lógica de negocio (CRUD)
    private async Task ImportarPublicacionesExternas()
    {
        var http = new HttpClient();
        var publicacionesExternas = await http.GetFromJsonAsync<List<PublicacionAcademicaDto>>("http://localhost:3000/PublicacionAcademica");
        var soloExternas = publicacionesExternas?.Where(p => p.Externo).ToList() ?? new List<PublicacionAcademicaDto>();

        var publicacionesActuales = PublicacionesAcademicas
            .Select(p => (p.Titulo.Trim().ToLower(), p.Revista.Trim().ToLower(), p.Volumen.Trim().ToLower(), p.Anio, p.Tipo.Trim().ToLower()))
            .ToHashSet();

        int importadas = 0;
        foreach (var pub in soloExternas)
        {
            var key = (pub.Titulo.Trim().ToLower(), pub.Revista.Trim().ToLower(), pub.Volumen.Trim().ToLower(), pub.Anio, pub.Tipo.Trim().ToLower());
            if (!publicacionesActuales.Contains(key))
            {
                var response = await DocenteService.ImportarPublicacionExternaAsync(pub);
                if (response) importadas++;
            }
        }

        if (OnImportarCompletado.HasDelegate)
            await OnImportarCompletado.InvokeAsync();

        modalMessageImportar = importadas > 0
            ? $"Se importaron {importadas} publicación(es) nueva(s)."
            : "No se importaron publicaciones nuevas porque ya existen en el sistema.";
        showModalImportar = true;
    }

    private async void VerArchivo(int publicacionId)
    {
        try
        {
            Console.WriteLine($"[DEBUG] Intentando ver archivo de publicación ID: {publicacionId}");
            
            // Verificar que la publicación existe y tiene archivo
            var publicacion = PublicacionesAcademicas.FirstOrDefault(p => p.Id == publicacionId);
            if (publicacion == null)
            {
                Console.WriteLine($"[ERROR] No se encontró la publicación con ID: {publicacionId}");
                modalMessageImportar = "❌ Error: No se encontró la publicación seleccionada.";
                showModalImportar = true;
                return;
            }

            if (publicacion.Archivo == null || publicacion.Archivo.Length == 0)
            {
                Console.WriteLine($"[ERROR] La publicación {publicacionId} no tiene archivo asociado");
                modalMessageImportar = "❌ Esta publicación no tiene un archivo PDF asociado.";
                showModalImportar = true;
                return;
            }

            Console.WriteLine($"[DEBUG] Publicación encontrada: {publicacion.Titulo}");
            Console.WriteLine($"[DEBUG] Archivo presente: {publicacion.Archivo.Length} bytes");
            
            // Construir la URL del PDF
            pdfUrl = $"http://localhost:5015/api/PublicacionAcademica/archivo/{publicacionId}";
            
            Console.WriteLine($"[DEBUG] URL construida: {pdfUrl}");
            
            // Probar la URL antes de mostrar el modal
            try
            {
                var http = new HttpClient();
                http.Timeout = TimeSpan.FromSeconds(5);
                var response = await http.GetAsync(pdfUrl, HttpCompletionOption.ResponseHeadersRead);
                
                Console.WriteLine($"[DEBUG] Response status: {response.StatusCode}");
                Console.WriteLine($"[DEBUG] Content-Type: {response.Content.Headers.ContentType}");
                
                if (!response.IsSuccessStatusCode)
                {
                    Console.WriteLine($"[ERROR] El servidor devolvió error: {response.StatusCode}");
                    modalMessageImportar = $"❌ Error del servidor: {response.StatusCode}. No se puede mostrar el archivo.";
                    showModalImportar = true;
                    return;
                }
            }
            catch (Exception httpEx)
            {
                Console.WriteLine($"[ERROR] Error al verificar la URL: {httpEx.Message}");
                modalMessageImportar = $"❌ Error de conexión: {httpEx.Message}";
                showModalImportar = true;
                return;
            }
            
            // Mostrar el modal
            showPdfModal = true;
            
            Console.WriteLine($"[DEBUG] Modal PDF abierto: {showPdfModal}");
            
            StateHasChanged(); // Forzar actualización de la UI
            
            // Pequeño delay para asegurar que el modal se renderice
            await Task.Delay(100);
            
            Console.WriteLine($"[DEBUG] Estado final - showPdfModal: {showPdfModal}, pdfUrl: {pdfUrl}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Error al abrir visor de PDF: {ex.Message}");
            Console.WriteLine($"[ERROR] Stack trace: {ex.StackTrace}");
            modalMessageImportar = $"❌ Error al abrir el archivo PDF: {ex.Message}";
            showModalImportar = true;
        }
    }

    private void AbrirPdfEnNuevaPestana(int publicacionId)
    {
        try
        {
            var url = $"http://localhost:5015/api/PublicacionAcademica/archivo/{publicacionId}";
            Console.WriteLine($"[DEBUG] Abriendo PDF en nueva pestaña: {url}");
            Navigation.NavigateTo(url, true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Error al abrir PDF en nueva pestaña: {ex.Message}");
            modalMessageImportar = $"❌ Error al abrir el archivo: {ex.Message}";
            showModalImportar = true;
        }
    }

    private int ObtenerIdDesdePdfUrl()
    {
        if (string.IsNullOrEmpty(pdfUrl)) return 0;
        
        try
        {
            var segments = pdfUrl.Split('/');
            var idStr = segments.LastOrDefault();
            return int.TryParse(idStr, out var id) ? id : 0;
        }
        catch
        {
            return 0;
        }
    }

    private async Task EditarPublicacion(PublicacionAcademicaDto pub)
    {
        try
        {
            Console.WriteLine($"[DEBUG] Iniciando edición de publicación: {pub.Titulo}");
            Console.WriteLine($"[DEBUG] Estado inicial showEditModal: {showEditModal}");
            
            publicacionEditando = pub;
            editTitulo = pub.Titulo ?? string.Empty;
            editRevista = pub.Revista ?? string.Empty;
            editVolumen = pub.Volumen ?? string.Empty;
            editAnio = pub.Anio;
            editTipo = pub.Tipo ?? string.Empty;
            editArchivoFile = null;
            
            Console.WriteLine($"[DEBUG] Datos cargados - Título: {editTitulo}, Revista: {editRevista}");
            
            showEditModal = true;
            
            Console.WriteLine($"[DEBUG] showEditModal establecido a: {showEditModal}");
            
            StateHasChanged(); // Forzar actualización
            
            // Pequeño delay para asegurar que el estado se actualice
            await Task.Delay(100);
            
            Console.WriteLine($"[DEBUG] Estado final showEditModal: {showEditModal}");
            Console.WriteLine($"[DEBUG] publicacionEditando: {publicacionEditando?.Titulo}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Error al abrir editor: {ex.Message}");
