@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@using MyCleanApp.Client.components

@page "/admin-dashboard"

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <AdminDashboardHeader/>

    <AdminDashboardStats />

    @* Pestañas principales con MudBlazor *@
    <MudPaper Class="mt-6" Elevation="2">
        <MudTabs Elevation="0" 
                 Rounded="true" 
                 Color="Color.Primary"
                 SliderColor="Color.Secondary"
                 @bind-ActivePanelIndex="activeTabIndex"
                 PanelClass="pa-6">

            <MudTabPanel Text="Docentes" Icon="Icons.Material.Filled.People">
                <AdminDashboardTeachers />
            </MudTabPanel>

            <MudTabPanel Text="Promociones" Icon="Icons.Material.Filled.TrendingUp">
                <GestionSolicitudesPromocion />
            </MudTabPanel>

            <MudTabPanel Text="Evaluaciones" Icon="Icons.Material.Filled.Assessment">
                <AdminDashboardEvaluations />
            </MudTabPanel>

        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    private int activeTabIndex = 0;

    // Manejadores de eventos para el header
    private async Task HandleConfiguracion()
    {
        await JS.InvokeVoidAsync("alert", "Configuración - Funcionalidad en desarrollo");
    }

    private async Task HandleAñadirDocente()
    {
        await JS.InvokeVoidAsync("alert", "Añadir Docente - Funcionalidad en desarrollo");
    }
}
