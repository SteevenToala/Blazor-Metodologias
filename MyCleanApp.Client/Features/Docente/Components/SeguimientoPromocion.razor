    public class TimelineStep
    {
        public string Title { get; set; } = "";
        public bool IsCompleted { get; set; }
        public bool IsCurrent { get; set; }
        public string ResponsibleEntity { get; set; } = "";
        public string CompletedDate { get; set; } = "";
    }

    private List<TimelineStep> GetTimelineSteps(string estado)
    {
        var steps = new List<TimelineStep>();
        
        // Definir todas las etapas básicas del proceso
        var basicSteps = new[]
        {
            ("Solicitud Recibida", "PENDIENTE", "Secretaría Académica"),
            ("Verificación de Documentos", "EN_VERIFICACION", "Oficina de Verificación"),
            ("Documentos Verificados", "VERIFICADA", "Secretaría Académica"),
            ("Enviada a Comisión", "ENVIADA_COMISION", "Secretaría Académica"),
            ("Análisis de Comisión", "EN_ANALISIS_COMISION", "Comisión Académica"),
            ("Decisión de Comisión", "DECIDIDO_APROBADA,DECIDIDO_RECHAZADA", "Comisión Académica")
        };

        var currentStateOrder = GetStateOrder(estado);
        
        // Agregar etapas básicas
        foreach (var (title, stateCode, responsible) in basicSteps)
        {
            var stepStates = stateCode.Split(',');
            var stepOrder = stepStates.Select(GetStateOrder).Max();
            
            var isCompleted = currentStateOrder > stepOrder;
            var isCurrent = stepStates.Contains(estado);
            
            var step = new TimelineStep
            {
                Title = title,
                IsCompleted = isCompleted,
                IsCurrent = isCurrent,
                ResponsibleEntity = isCurrent ? responsible : "",
                CompletedDate = isCompleted ? "Completado" : ""
            };
            
            steps.Add(step);
        }

        // Agregar etapas específicas según el estado
        if (estado == "DECIDIDO_APROBADA" || estado == "DECIDIDO_RECHAZADA" || 
            GetStateOrder(estado) > GetStateOrder("DECIDIDO_APROBADA"))
        {
            var responseRequired = estado == "DECIDIDO_APROBADA" || estado == "DECIDIDO_RECHAZADA";
            steps.Add(new TimelineStep
            {
                Title = "Respuesta del Docente",
                IsCompleted = GetStateOrder(estado) > GetStateOrder("DECIDIDO_APROBADA"),
                IsCurrent = responseRequired,
                ResponsibleEntity = responseRequired ? "Docente (3 días para responder)" : "",
                CompletedDate = GetStateOrder(estado) > GetStateOrder("DECIDIDO_APROBADA") ? "Completado" : ""
            });
        }

        // Agregar etapa de apelación si corresponde
        if (estado == "EN_APELACION" || estado == "APELACION_APROBADA" || estado == "APELACION_RECHAZADA")
        {
            steps.Add(new TimelineStep
            {
                Title = "Proceso de Apelación",
                IsCompleted = estado == "APELACION_APROBADA" || estado == "APELACION_RECHAZADA",
                IsCurrent = estado == "EN_APELACION",
                ResponsibleEntity = estado == "EN_APELACION" ? "Comisión Académica (3 días)" : "",
                CompletedDate = (estado == "APELACION_APROBADA" || estado == "APELACION_RECHAZADA") ? "Completado" : ""
            });
        }

        // Agregar etapa de aprobación del docente y proceso posterior
        if (estado == "APROBADA_DOCENTE" || estado == "INFORMES_FINALES" || estado == "ENVIADA_CONSEJO" || estado == "EFECTIVA")
        {
            steps.Add(new TimelineStep
            {
                Title = "Elaboración de Informes Finales",
                IsCompleted = GetStateOrder(estado) > GetStateOrder("APROBADA_DOCENTE"),
                IsCurrent = estado == "INFORMES_FINALES",
                ResponsibleEntity = estado == "INFORMES_FINALES" ? "Comisión Académica" : "",
                CompletedDate = GetStateOrder(estado) > GetStateOrder("INFORMES_FINALES") ? "Completado" : ""
            });
            
            steps.Add(new TimelineStep
            {
                Title = "Enviada al Consejo Universitario",
                IsCompleted = GetStateOrder(estado) > GetStateOrder("ENVIADA_CONSEJO"),
                IsCurrent = estado == "ENVIADA_CONSEJO",
                ResponsibleEntity = estado == "ENVIADA_CONSEJO" ? "Consejo Universitario" : "",
                CompletedDate = GetStateOrder(estado) > GetStateOrder("ENVIADA_CONSEJO") ? "Completado" : ""
            });
        }

        // Agregar resultado final
        if (estado == "EFECTIVA" || estado == "APROBADA")
        {
            steps.Add(new TimelineStep
            {
                Title = estado == "EFECTIVA" ? "Promoción Efectiva" : "Promoción Aprobada",
                IsCompleted = true,
                IsCurrent = false,
                CompletedDate = "Completado"
            });
        }
        else if (estado == "RECHAZADA" || estado == "APELACION_RECHAZADA")
        {
            steps.Add(new TimelineStep
            {
                Title = estado == "APELACION_RECHAZADA" ? "Apelación Rechazada" : "Solicitud Rechazada",
                IsCompleted = true,
                IsCurrent = false,
                CompletedDate = "Completado"
            });
        }
        else if (estado == "SIN_EFECTO")
        {
            steps.Add(new TimelineStep
            {
                Title = "Solicitud Sin Efecto",
                IsCompleted = true,
                IsCurrent = false,
                CompletedDate = "Sin respuesta en tiempo"
            });
        }

        return steps;
    }

    private int GetStateOrder(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => 1,
            "EN_VERIFICACION" => 2,
            "VERIFICADA" => 3,
            "ENVIADA_COMISION" => 4,
            "EN_ANALISIS_COMISION" => 5,
            "DECIDIDO_APROBADA" => 6,
            "DECIDIDO_RECHAZADA" => 6,
            "APROBADA_DOCENTE" => 7,
            "INFORMES_FINALES" => 8,
            "ENVIADA_CONSEJO" => 9,
            "APROBADA" => 10,
            "RECHAZADA" => 7,
            "EN_APELACION" => 7,
            "APELACION_APROBADA" => 8,
            "APELACION_RECHAZADA" => 8,
            "EFECTIVA" => 11,
            "SIN_EFECTO" => 0,
            "DOCUMENTOS_INCOMPLETOS" => 1,
            _ => 0
        };
    }

    private string GetStepBorderColor(TimelineStep step)
    {
        if (step.IsCompleted) return "#4CAF50";
        if (step.IsCurrent) return "#2196F3";
        return "#E0E0E0";
    }

    private string GetStepTextStyle(TimelineStep step)
    {
        var baseStyle = "font-size: 0.75rem; line-height: 1.2;";
        if (step.IsCurrent) return baseStyle + " font-weight: 600; color: #2196F3;";
        if (step.IsCompleted) return baseStyle + " color: #4CAF50;";
        return baseStyle + " color: #9E9E9E;";
    }
