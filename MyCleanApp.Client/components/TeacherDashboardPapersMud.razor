@* SECCIÓN 1: DIRECTIVAS DE RAZOR *@
@using System
@using System.Collections.Generic
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MyCleanApp.Client.DTOs

@inject DocenteService DocenteService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<style>
    .publication-card {
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }
    
    .publication-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        border-left-color: #8B1538;
    }
    
    .edit-btn {
        background: linear-gradient(45deg, #ff9800, #f57c00) !important;
    }
    
    .delete-btn {
        background: linear-gradient(45deg, #f44336, #d32f2f) !important;
    }
    
    .edit-btn:hover, .delete-btn:hover {
        transform: scale(1.05);
        transition: transform 0.2s ease;
    }
</style>

<MudCard Elevation="1">
    
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Style="Color: #8B1538;">Publicaciones Académicas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Dark">Tus publicaciones registradas en el sistema</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudStack Direction="Row" Spacing="1">
                 <MudButton Variant="Variant.Filled" 
                           Style="background-color: #8B1538; color: white;"
                           OnClick="IrASubirPublicacion" 
                           StartIcon="@Icons.Material.Filled.Add">Añadir Nueva</MudButton>
                 <MudButton Variant="Variant.Outlined" 
                           Style="border-color: #8B1538; color: #8B1538;"
                           OnClick="ImportarPublicacionesExternas" 
                           StartIcon="@Icons.Material.Filled.CloudDownload">Importar Datos</MudButton>
            </MudStack>
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent>
        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Filtrar por Tipo" @bind-Value="selectedTipo" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value=null>Todos los tipos</MudSelectItem>
                    @foreach (var tipo in TiposDisponibles)
                    {
                        <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Filtrar por Año" @bind-Value="selectedAnio" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value=null>Todos los años</MudSelectItem>
                    @foreach (var anio in AniosDisponibles)
                    {
                        <MudSelectItem T="string" Value="@anio">@anio</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                 <MudTextField T="string" 
                              Label="Buscar publicación..." 
                              @bind-Value="searchTerm" 
                              Dense="true" 
                              Variant="Variant.Outlined"
                              Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton FullWidth="true" 
                           Variant="Variant.Text" 
                           Style="background-color: #8B1538; color: white;"
                           OnClick="LimpiarFiltros">Limpiar Filtros</MudButton>
            </MudItem>
        </MudGrid>
        
        <MudDivider />

        @if (isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        }
        else
        {
            <MudGrid Class="mt-4" Spacing="3">
                @if (Filtradas != null && Filtradas.Any())
                {
                    foreach (var pub in Filtradas)
                    {
                        <MudItem xs="12">
                            <MudCard Elevation="2" Class="publication-card">
                                <MudCardContent>
                                    <MudGrid AlignItems="AlignItems.Center">
                                        
                                        <MudItem xs="12" md="8">
                                            <MudStack Spacing="2">
                                                <MudStack Direction="Row" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.h6" Color="Color.Primary">@pub.Titulo</MudText>
                                                    @if (pub.Externo == true)
                                                    {
                                                        <MudChip T="string" Label="true" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Cloud">Externo</MudChip>
                                                    }
                                                    else
                                                    {
                                                        <MudChip T="string" Label="true" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Home">Local</MudChip>
                                                    }
                                                </MudStack>

                                                <MudText Typo="Typo.body2" Color="Color.Dark">
                                                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Class="mr-1" />
                                                    <strong>@pub.Revista</strong>, Vol. @pub.Volumen (@pub.Anio)
                                                </MudText>

                                                <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                                                    <MudChip T="string" Icon="@Icons.Material.Filled.Category" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">@pub.Tipo</MudChip>
                                                    @if (pub.Archivo != null)
                                                    {
                                                        <MudButtonGroup Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">
                                                            <MudButton OnClick="@(() => VerArchivo(pub.Id))" 
                                                                       StartIcon="@Icons.Material.Filled.PictureAsPdf">
                                                                Ver PDF
                                                            </MudButton>
                                                            <MudButton OnClick="@(() => AbrirPdfEnNuevaPestana(pub.Id))" 
                                                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                                                       Title="Abrir en nueva pestaña">
                                                            </MudButton>
                                                        </MudButtonGroup>
                                                    }
                                                </MudStack>
                                            </MudStack>
                                        </MudItem>

                                        <MudItem xs="12" md="4" Class="d-flex justify-end">
                                            @if (pub.Externo == false)
                                            {
                                                <MudStack Direction="Row" Spacing="1">
                                                    <MudButton Size="Size.Small" 
                                                               Color="Color.Warning"
                                                               Variant="Variant.Filled" 
                                                               OnClick="@(async () => await EditarPublicacion(pub))" 
                                                               StartIcon="@Icons.Material.Filled.Edit"
                                                               Class="edit-btn">
                                                        Editar
                                                    </MudButton>
                                                    <MudButton Size="Size.Small" 
                                                               Color="Color.Error"
                                                               Variant="Variant.Filled" 
                                                               OnClick="@(async () => await EliminarPublicacion(pub.Id))" 
                                                               StartIcon="@Icons.Material.Filled.Delete"
                                                               Class="delete-btn">
                                                        Eliminar
                                                    </MudButton>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Icon="@Icons.Material.Filled.Lock" Color="Color.Default" Variant="Variant.Text" Size="Size.Small">Solo lectura</MudChip>
                                            }
                                        </MudItem>

                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Class="mt-4">
                            <MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                                No tienes publicaciones registradas o no se encontraron resultados para los filtros aplicados.
                            </MudText>
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudCardContent>
</MudCard>

<MudDialog @bind-Open="showModalImportar" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small })">
    <DialogContent>
        <MudContainer Class="pa-6">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                @if (modalMessageImportar.StartsWith("✅"))
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                }
                else if (modalMessageImportar.StartsWith("❌"))
                {
                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Large" />
                }
                
                <MudText Typo="Typo.h6" Align="Align.Center">
                    @if (modalMessageImportar.StartsWith("✅"))
                    {
                        <span>¡Operación Exitosa!</span>
                    }
                    else if (modalMessageImportar.StartsWith("❌"))
                    {
                        <span>Error en la Operación</span>
                    }
                    else
                    {
                        <span>Información</span>
                    }
                </MudText>
                
                <MudText Align="Align.Center" Class="mb-4">@modalMessageImportar</MudText>
                
                <MudButton Variant="Variant.Filled" 
                           Color="@(modalMessageImportar.StartsWith("✅") ? Color.Success : modalMessageImportar.StartsWith("❌") ? Color.Error : Color.Primary)" 
                           OnClick="CerrarModalImportar"
                           StartIcon="@Icons.Material.Filled.Close">
                    Cerrar
                </MudButton>
            </MudStack>
        </MudContainer>
    </DialogContent>
</MudDialog>

@if (showPdfModal)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudCard Style="max-width: 70vw; width: 70vw; height: 90vh; margin: auto; margin-top: 20px;margin-left: 100px;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-2" />
                        Visualizar Archivo PDF
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Dark">
                        Documento PDF de la publicación académica
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0" Style="height: calc(90vh - 150px); overflow: hidden;">
                @if (pdfUrl != null)
                {
                    <div style="position: relative; width: 100%; height: 100%;">
                        <iframe 
                            src="@pdfUrl" 
                            style="width: 100%; height: 100%; border: none;"
                            title="Documento PDF"
                            frameborder="0"
                            loading="lazy">
                            <p>Tu navegador no soporta la visualización de PDFs. 
                               <a href="@pdfUrl" target="_blank">Haz clic aquí para descargar el archivo</a>
                            </p>
                        </iframe>
                    </div>
                }
                else
                {
                    <MudContainer Class="pa-4">
                        <MudAlert Severity="Severity.Error">
                            <MudText>No se pudo cargar el archivo PDF.</MudText>
                        </MudAlert>
                    </MudContainer>
                }
            </MudCardContent>
            <MudCardActions Class="d-flex justify-space-between pa-4">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           OnClick="@(() => AbrirPdfEnNuevaPestana(ObtenerIdDesdePdfUrl()))"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           Disabled="@(pdfUrl == null)">
                    Abrir en nueva pestaña
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           OnClick="CerrarPdfModal" 
                           StartIcon="@Icons.Material.Filled.Close">
                    Cerrar
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudOverlay>
}

@* Diálogo de edición temporal deshabilitado para debug
<MudDialog @bind-IsOpen="showEditModal" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h5" Color="Color.Primary">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Editar Publicación
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-4">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField T="string" 
                                  Label="Título *" 
                                  @bind-Value="editTitulo" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="El título es obligatorio"
                                  HelperText="Ingresa el título completo de la publicación" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" 
                                  Label="Revista *" 
                                  @bind-Value="editRevista" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="La revista es obligatoria"
                                  HelperText="Nombre de la revista" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string" 
                                  Label="Volumen *" 
                                  @bind-Value="editVolumen" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="El volumen es obligatorio" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField T="int" 
                                     Label="Año *" 
                                     @bind-Value="editAnio" 
                                     Variant="Variant.Outlined"
                                     Min="1900" 
                                     Max="@DateTime.Now.Year"
                                     Required="true"
                                     RequiredError="El año es obligatorio" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" 
                               Label="Tipo de Publicación *" 
                               @bind-Value="editTipo" 
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="El tipo es obligatorio">
                        <MudSelectItem T="string" Value="@("Artículo")">Artículo</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Libro")">Libro</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Capítulo")">Capítulo de Libro</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Conferencia")">Conferencia</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Ponencia")">Ponencia</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Otro")">Otro</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Archivo PDF (Opcional)</MudText>
                    <MudFileUpload T="IBrowserFile" 
                                   OnFilesChanged="OnArchivoFileChanged"
                                   Accept="application/pdf"
                                   MaximumFileCount="1"
                                   Class="flex-1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       FullWidth="true">
                                @if (editArchivoFile != null)
                                {
                                    <MudText>Archivo seleccionado: @editArchivoFile.Name</MudText>
                                }
                                else if (publicacionEditando?.Archivo != null)
                                {
                                    <MudText>Archivo actual cargado</MudText>
                                }
                                else
                                {
                                    <MudText>Seleccionar nuevo archivo PDF</MudText>
                                }
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (publicacionEditando?.Archivo != null && editArchivoFile == null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-1">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                            Archivo PDF ya existe en el sistema
                        </MudText>
                    }
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Default" 
                   OnClick="CancelarEdicionPublicacion" 
                   Disabled="@isLoading"
                   StartIcon="@Icons.Material.Filled.Cancel">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   OnClick="GuardarEdicionPublicacion" 
                   Disabled="@(isLoading || string.IsNullOrWhiteSpace(editTitulo) || string.IsNullOrWhiteSpace(editRevista) || string.IsNullOrWhiteSpace(editVolumen) || string.IsNullOrWhiteSpace(editTipo))"
                   StartIcon="@(isLoading ? null : Icons.Material.Filled.Save)">
            @if (isLoading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Guardando...</MudText>
            }
            else
            {
                <MudText>Guardar Cambios</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
*@

@* Diálogo de edición - VERSIÓN COMPLETA CON ARCHIVO *@
@if (showEditModal)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudCard Style="max-width: 700px; margin: auto; margin-top: 50px; max-height: 90vh; overflow-y: auto;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Color="Color.Primary">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                        Editar Publicación Académica
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Dark">
                        Modifica los datos de la publicación seleccionada
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudStack Spacing="4">
                    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info">
                        <strong>Publicación:</strong> @(publicacionEditando?.Titulo ?? "Ninguna seleccionada")
                    </MudAlert>
                    
                    <MudGrid Spacing="3">
                        <MudItem xs="12">
                            <MudTextField T="string" 
                                          Label="Título *" 
                                          @bind-Value="editTitulo" 
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Error="@(string.IsNullOrWhiteSpace(editTitulo))"
                                          ErrorText="El título es obligatorio"
                                          HelperText="Ingresa el título completo de la publicación" />
                        </MudItem>
                        
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" 
                                          Label="Revista *" 
                                          @bind-Value="editRevista" 
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Error="@(string.IsNullOrWhiteSpace(editRevista))"
                                          ErrorText="La revista es obligatoria"
                                          HelperText="Nombre de la revista o conferencia" />
                        </MudItem>
                        
                        <MudItem xs="12" md="3">
                            <MudTextField T="string" 
                                          Label="Volumen *" 
                                          @bind-Value="editVolumen" 
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Error="@(string.IsNullOrWhiteSpace(editVolumen))"
                                          ErrorText="El volumen es obligatorio" />
                        </MudItem>
                        
                        <MudItem xs="12" md="3">
                            <MudNumericField T="int" 
                                             Label="Año *" 
                                             @bind-Value="editAnio" 
                                             Variant="Variant.Outlined"
                                             Min="1900" 
                                             Max="@DateTime.Now.Year"
                                             Required="true"
                                             Error="@(editAnio < 1900 || editAnio > DateTime.Now.Year)"
                                             ErrorText="Año inválido" />
                        </MudItem>
                        
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" 
                                       Label="Tipo de Publicación *" 
                                       @bind-Value="editTipo" 
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       Error="@(string.IsNullOrWhiteSpace(editTipo))"
                                       ErrorText="Selecciona un tipo">
                                <MudSelectItem T="string" Value="@("Artículo")">📄 Artículo</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Libro")">📚 Libro</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Capítulo")">📖 Capítulo de Libro</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Conferencia")">🎤 Conferencia</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Ponencia")">🗣️ Ponencia</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Otro")">📋 Otro</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-1" />
                                Archivo PDF
                            </MudText>
                            
                            @* Estado del archivo actual *@
                            @if (publicacionEditando?.Archivo != null && editArchivoFile == null)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                    Archivo PDF existente en el sistema
                                    <MudButton Size="Size.Small" 
                                               Color="Color.Primary" 
                                               Variant="Variant.Text"
                                               OnClick="@(() => VerArchivo(publicacionEditando.Id))"
                                               StartIcon="@Icons.Material.Filled.Visibility"
                                               Class="ml-2">
                                        Ver archivo actual
                                    </MudButton>
                                </MudAlert>
                            }
                            
                            @* Archivo nuevo seleccionado *@
                            @if (editArchivoFile != null)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.FileUpload" Size="Size.Small" Class="mr-1" />
                                    Nuevo archivo seleccionado: <strong>@editArchivoFile.Name</strong>
                                    <MudButton Size="Size.Small" 
                                               Color="Color.Secondary" 
                                               Variant="Variant.Text"
                                               OnClick="LimpiarArchivoSeleccionado"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               Class="ml-2">
                                        Cancelar cambio
                                    </MudButton>
                                </MudAlert>
                            }
                            
                            @* Selector de archivo *@
                            <MudStack Direction="Row" Spacing="2">
                                <MudFileUpload T="IBrowserFile" 
                                               OnFilesChanged="OnArchivoFileChanged"
                                               Accept="application/pdf"
                                               MaximumFileCount="1"
                                               MaximumFileSize="5242880">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined" 
                                                   Color="@(editArchivoFile != null ? Color.Warning : Color.Primary)"
                                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                                   FullWidth="true">
                                            @if (editArchivoFile != null)
                                            {
                                                <span>Reemplazar archivo PDF</span>
                                            }
                                            else if (publicacionEditando?.Archivo != null)
                                            {
                                                <span>Cambiar archivo PDF</span>
                                            }
                                            else
                                            {
                                                <span>Subir archivo PDF</span>
                                            }
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                
                                @* Botón para eliminar archivo existente *@
                                @if (publicacionEditando?.Archivo != null && editArchivoFile == null)
                                {
                                    <MudButton Variant="Variant.Outlined" 
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.DeleteForever"
                                               OnClick="EliminarArchivoActual">
                                        Eliminar
                                    </MudButton>
                                }
                            </MudStack>
                            
                            <MudText Typo="Typo.caption" Color="Color.Dark" Class="mt-1">
                                Tamaño máximo: 5MB • Formato: PDF únicamente
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudCardContent>
            <MudCardActions Class="d-flex justify-space-between pa-4">
                <MudButton Color="Color.Default" 
                           Variant="Variant.Outlined" 
                           OnClick="CancelarEdicionPublicacion"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           Disabled="@isLoading">
                    Cancelar
                </MudButton>
                <MudButton Color="Color.Primary" 
                           Variant="Variant.Filled" 
                           OnClick="GuardarEdicionPublicacion"
                           StartIcon="@(isLoading ? null : Icons.Material.Filled.Save)"
                           Disabled="@(isLoading || !FormularioValido())">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>Guardando cambios...</span>
                    }
                    else
                    {
                        <span>Guardar Cambios</span>
                    }
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudOverlay>
}

@* SECCIÓN 3: BLOQUE DE CÓDIGO C# *@
@code {
    // Parámetros y Callbacks
    [Parameter]
    public List<PublicacionAcademicaDto> PublicacionesAcademicas { get; set; } = new();
    
    [Parameter]
    public EventCallback OnImportarCompletado { get; set; }

    // Estado para filtros y búsqueda
    private string searchTerm = string.Empty;
