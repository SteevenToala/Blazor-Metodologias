    private void CancelarEdicionPublicacion()
    {
        Console.WriteLine("[DEBUG] Cancelando edición de publicación");
        
        // Limpiar todo el estado de edición
        showEditModal = false;
        publicacionEditando = null;
        editTitulo = string.Empty;
        editRevista = string.Empty;
        editVolumen = string.Empty;
        editAnio = DateTime.Now.Year;
