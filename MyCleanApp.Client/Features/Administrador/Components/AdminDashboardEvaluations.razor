@using MyCleanApp.Client.DTOs
@using MyCleanApp.Client.Features.Docente.Services
@using Microsoft.JSInterop
@using MudBlazor
@inject DocenteService DocenteService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudPaper Class="pa-6 mb-4" Elevation="2">
        <div class="d-flex align-center">
            <MudIcon Icon="Icons.Material.Filled.Assessment" Color="Color.Success" Size="Size.Large" Class="mr-3" />
            <div>
                <MudText Typo="Typo.h5" Class="font-weight-bold">📊 Gestión de Evaluaciones Docentes</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Sistema para administrar y editar las evaluaciones de desempeño docente
                </MudText>
            </div>
        </div>
    </MudPaper>

    @if (isLoading)
    {
        <div class="d-flex justify-center pa-8">
            <div class="d-flex flex-column align-center">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body2" Class="mt-3" Color="Color.Secondary">Cargando evaluaciones...</MudText>
            </div>
        </div>
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="3">
            <MudGrid Class="mb-4">
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h6" Class="font-weight-medium">Lista de Evaluaciones Docentes</MudText>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex justify-end gap-2">
                    <MudTextField @bind-Value="searchTerm" 
                                 @oninput="OnSearchChanged"
                                 Placeholder="Buscar por nombre o cédula..." 
                                 Variant="Variant.Outlined" 
                                 Adornment="Adornment.Start" 
                                 AdornmentIcon="Icons.Material.Filled.Search"
                                 Class="flex-grow-1" />
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Primary" 
                              StartIcon="Icons.Material.Filled.Refresh"
                              OnClick="CargarEvaluaciones"
                              Disabled="isLoading">
                        Actualizar
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudDataGrid T="EvaluacionDocenteDto" 
                         Items="@EvaluacionesFiltradas" 
                         Filterable="true" 
                         FilterMode="DataGridFilterMode.ColumnFilterRow"
                         SortMode="SortMode.Multiple" 
                         Groupable="false"
                         Hover="true"
                         Elevation="2"
                         Class="mud-elevation-4">
                
                <Columns>
                    <PropertyColumn Property="x => x.DocenteNombre" Title="Docente">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-3">
                                    @(context.Item.DocenteNombre?.Split(' ').FirstOrDefault()?.Substring(0, 1).ToUpper())
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body1" Class="font-weight-medium">@context.Item.DocenteNombre</MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.DocenteCedula" Title="Cédula" />

                    <PropertyColumn Property="x => x.NivelAcademico" Title="Nivel Académico">
                        <CellTemplate>
                            <MudChip Color="Color.Info" Size="Size.Small" Text="@context.Item.NivelAcademico" />
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Puntaje" Title="Puntaje">
                        <CellTemplate>
                            <MudChip Color="@GetPuntajeColorMud(context.Item.Puntaje)" 
                                    Size="Size.Small" 
                                    Text="@context.Item.Puntaje.ToString("F1")"
                                    Icon="@GetPuntajeIcon(context.Item.Puntaje)" />
                        </CellTemplate>
                    </PropertyColumn>

                    <TemplateColumn Title="Acciones" Sortable="false">
                        <CellTemplate>
                            <div class="d-flex gap-2">
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Primary" 
                                          Size="Size.Small"
                                          StartIcon="Icons.Material.Filled.Edit"
                                          OnClick="() => AbrirModalEvaluacion(context.Item)">
                                    Editar
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                          Color="Color.Secondary" 
                                          Size="Size.Small"
                                          StartIcon="Icons.Material.Filled.History"
                                          OnClick="() => VerHistorialEvaluaciones(context.Item)">
                                    Historial
                                </MudButton>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>

            @if (!EvaluacionesFiltradas.Any())
            {
                <div class="d-flex justify-center pa-8">
                    <MudAlert Severity="Severity.Info">
                        <div class="d-flex align-center">
                            <MudIcon Icon="Icons.Material.Filled.Info" Class="mr-2" />
                            <span>No se encontraron evaluaciones.</span>
                        </div>
                    </MudAlert>
                </div>
            }
        </MudPaper>
    }
</MudContainer>

@* Modal para editar evaluación *@
@if (showModalEvaluacion)
{
    <MudDialog Visible="showModalEvaluacion" Options="@dialogOptions">
        <TitleContent>
            <div class="d-flex align-center">
                <MudIcon Icon="Icons.Material.Filled.Edit" Color="Color.Primary" Class="mr-3" />
                <MudText Typo="Typo.h6">Editar Evaluación - @evaluacionSeleccionada?.DocenteNombre</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="4">
                <MudNumericField T="double" 
                                Label="Puntaje de Evaluación"
                                @bind-Value="nuevoPuntaje"
                                Variant="Variant.Outlined"
                                Min="0"
                                Max="100"
                                Step="0.1"
                                HelperText="@($"Valor actual: {nuevoPuntaje:F1}")"
                                Placeholder="Ingrese el puntaje (0-100)"
                                FullWidth="true" />
                
                <MudTextField Label="Período"
                             @bind-Value="nuevoPeriodo"
                             Variant="Variant.Outlined"
                             Placeholder="Ej: 2024-1"
                             FullWidth="true" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CerrarModalEvaluacion" 
                      Variant="Variant.Text"
                      Color="Color.Secondary">
                Cancelar
            </MudButton>
            <MudButton OnClick="GuardarEvaluacion" 
                      Variant="Variant.Filled" 
                      Color="Color.Primary"
                      StartIcon="Icons.Material.Filled.Save"
                      Disabled="isSaving">
                @if (isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private List<EvaluacionDocenteDto> evaluaciones = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    
    // Modal variables
    private bool showModalEvaluacion = false;
    private bool isSaving = false;
    private EvaluacionDocenteDto? evaluacionSeleccionada;
    private double nuevoPuntaje = 0;
    private string nuevoPeriodo = string.Empty;

    private DialogOptions dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    private IEnumerable<EvaluacionDocenteDto> EvaluacionesFiltradas =>
        evaluaciones.Where(e =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            (e.DocenteNombre?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (e.DocenteCedula?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
        );

    protected override async Task OnInitializedAsync()
    {
        await CargarEvaluaciones();
    }

    private async Task CargarEvaluaciones()
    {
        isLoading = true;
        try
        {
            evaluaciones = await DocenteService.ObtenerTodasLasEvaluacionesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar evaluaciones: {ex.Message}");
            Snackbar.Add("Error al cargar las evaluaciones", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private void AbrirModalEvaluacion(EvaluacionDocenteDto evaluacion)
    {
        Console.WriteLine($"AbrirModalEvaluacion called for: {evaluacion.DocenteNombre}");
        evaluacionSeleccionada = evaluacion;
        nuevoPuntaje = evaluacion.Puntaje;
        nuevoPeriodo = evaluacion.Periodo;
        showModalEvaluacion = true;
        Console.WriteLine($"Modal opened. Puntaje: {nuevoPuntaje}, Periodo: {nuevoPeriodo}");
        StateHasChanged();
    }

    private void CerrarModalEvaluacion()
    {
        showModalEvaluacion = false;
        evaluacionSeleccionada = null;
    }

    private async Task GuardarEvaluacion()
    {
        Console.WriteLine("GuardarEvaluacion called");
        await JSRuntime.InvokeVoidAsync("console.log", "GuardarEvaluacion called from Blazor");
        
        if (evaluacionSeleccionada == null) 
        {
            Console.WriteLine("evaluacionSeleccionada is null");
            return;
        }

        isSaving = true;
        StateHasChanged();
        
        try
        {
            Console.WriteLine($"Updating evaluation ID: {evaluacionSeleccionada.Id}, Puntaje: {nuevoPuntaje}, Periodo: {nuevoPeriodo}");
            
            var evaluacionUpdate = new EvaluacionDocenteUpdateDto
            {
                Id = evaluacionSeleccionada.Id,
                Puntaje = nuevoPuntaje,
                Periodo = nuevoPeriodo
            };

            Console.WriteLine("Calling DocenteService.ActualizarEvaluacionAsync");
            bool resultado = await DocenteService.ActualizarEvaluacionAsync(evaluacionUpdate);
            Console.WriteLine($"Service call result: {resultado}");

            if (resultado)
            {
                // Actualizar la evaluación en la lista local
                evaluacionSeleccionada.Puntaje = nuevoPuntaje;
                evaluacionSeleccionada.Periodo = nuevoPeriodo;

                Snackbar.Add("Evaluación actualizada exitosamente", Severity.Success);
                CerrarModalEvaluacion();
                
                // Recargar la lista para obtener datos actualizados
                await CargarEvaluaciones();
            }
            else
            {
                Snackbar.Add("Error al actualizar la evaluación - El servicio devolvió false", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar evaluación: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            Snackbar.Add($"Error al guardar la evaluación: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task VerHistorialEvaluaciones(EvaluacionDocenteDto evaluacion)
    {
        try
        {
            var historial = await DocenteService.ObtenerEvaluacionesPorDocenteAsync(evaluacion.DocenteId);
            if (historial.Any())
            {
                var mensaje = $"Historial de evaluaciones para {evaluacion.DocenteNombre}:\n";
                foreach (var eval in historial.OrderByDescending(e => e.Periodo))
                {
                    mensaje += $"- {eval.Periodo}: {eval.Puntaje:F1} puntos\n";
                }
                await JSRuntime.InvokeVoidAsync("alert", mensaje);
            }
            else
            {
                Snackbar.Add($"No se encontraron evaluaciones para {evaluacion.DocenteNombre}", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener historial: {ex.Message}");
            Snackbar.Add("Error al obtener el historial de evaluaciones", Severity.Error);
        }
    }

    private Color GetPuntajeColorMud(double puntaje)
    {
        return puntaje >= 85 ? Color.Success :
               puntaje >= 75 ? Color.Warning :
               Color.Error;
    }

    private string GetPuntajeIcon(double puntaje)
    {
        return puntaje >= 85 ? Icons.Material.Filled.ThumbUp :
               puntaje >= 75 ? Icons.Material.Filled.ThumbsUpDown :
               Icons.Material.Filled.ThumbDown;
    }

    private string GetPuntajeColor(double puntaje)
    {
        return puntaje >= 85 ? "bg-green-100 text-green-800" :
               puntaje >= 75 ? "bg-yellow-100 text-yellow-800" :
               "bg-red-100 text-red-800";
    }
}
