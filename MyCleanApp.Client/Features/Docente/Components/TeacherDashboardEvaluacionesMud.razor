@using System
@using System.Collections.Generic
@using System.IO
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MyCleanApp.Client.DTOs
@using EvaluacionClienteType = MyCleanApp.Client.DTOs.EvaluacionDocenteDto

@inject DocenteService DocenteService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject LocalStorageService LocalStorage

<style>
    .evaluation-card {
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }
    
    .evaluation-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        border-left-color: #1976d2;
    }
    
    .edit-btn {
        background: linear-gradient(45deg, #ff9800, #f57c00) !important;
    }
    
    .delete-btn {
        background: linear-gradient(45deg, #f44336, #d32f2f) !important;
    }
    
    .edit-btn:hover, .delete-btn:hover {
        transform: scale(1.05);
        transition: transform 0.2s ease;
    }
</style>

<MudCard Elevation="1">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Style="Color: #1976d2;">Evaluaciones Docentes</MudText>
            <MudText Typo="Typo.body2" Color="Color.Dark">Tus evaluaciones registradas en el sistema</MudText>
            @if (PromedioEvaluaciones > 0)
            {
                <MudChip T="string" 
                         Color="@(PromedioEvaluaciones >= 75 ? Color.Success : Color.Warning)" 
                         Variant="Variant.Filled" 
                         Size="Size.Medium"
                         Icon="@Icons.Material.Filled.Assessment">
                    Promedio: @PromedioEvaluaciones.ToString("F2")%
                </MudChip>
            }
        </CardHeaderContent>
        <CardHeaderActions>
            <MudStack Direction="Row" Spacing="1">
                 <MudButton Variant="Variant.Filled" 
                           Style="background-color: #1976d2; color: white;"
                           OnClick="IrASubirEvaluacion" 
                           StartIcon="@Icons.Material.Filled.Add">Añadir Nueva</MudButton>
                 <MudButton Variant="Variant.Outlined" 
                           Style="border-color: #1976d2; color: #1976d2;"
                           OnClick="@ImportarEvaluacionesExternas" 
                           StartIcon="@Icons.Material.Filled.CloudDownload">Importar Datos</MudButton>
            </MudStack>
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent>
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center" style="min-height: 300px;">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Class="ml-3" Color="Color.Secondary">Cargando evaluaciones...</MudText>
            </div>
        }
        else
        {
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" Label="Filtrar por Tipo" @bind-Value="selectedTipo" Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value=null>Todos los tipos</MudSelectItem>
                        @foreach (var tipo in TiposDisponibles)
                        {
                            <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" Label="Filtrar por Período" @bind-Value="selectedPeriodo" Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value=null>Todos los períodos</MudSelectItem>
                        @foreach (var periodo in PeriodosDisponibles)
                        {
                            <MudSelectItem T="string" Value="@periodo">@periodo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                     <MudTextField T="string" 
                                  Label="Buscar evaluación..." 
                                  @bind-Value="searchTerm" 
                                  Dense="true" 
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="2" Class="d-flex align-center">
                    <MudButton FullWidth="true" 
                               Variant="Variant.Text" 
                               Style="background-color: #1976d2; color: white;"
                               OnClick="LimpiarFiltros">Limpiar Filtros</MudButton>
                </MudItem>
            </MudGrid>
            
            <MudDivider />

            <MudGrid Class="mt-4" Spacing="3">
                @if (Filtradas != null && Filtradas.Any())
                {
                    foreach (var eval in Filtradas)
                    {
                        <MudItem xs="12">
                            <MudCard Elevation="2" Class="evaluation-card">
                                <MudCardContent>
                                    <MudGrid AlignItems="AlignItems.Center">
                                        
                                        <MudItem xs="12" md="8">
                                            <MudStack Spacing="2">
                                                <MudStack Direction="Row" Spacing="2" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.h6" Color="Color.Primary">@eval.TipoEvaluacion</MudText>
                                                    <MudChip T="string" 
                                                             Color="@(eval.Puntaje >= 75 ? Color.Success : eval.Puntaje >= 60 ? Color.Warning : Color.Error)" 
                                                             Variant="Variant.Filled" 
                                                             Size="Size.Small">
                                                        @eval.Puntaje.ToString("F1")%
                                                    </MudChip>
                                                    @if (eval.Externo == true)
                                                    {
                                                        <MudChip T="string" Label="true" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Cloud">Externo</MudChip>
                                                    }
                                                    else
                                                    {
                                                        <MudChip T="string" Label="true" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Home">Local</MudChip>
                                                    }
                                                </MudStack>

                                                <MudText Typo="Typo.body2" Color="Color.Dark">
                                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1" />
                                                    <strong>Período:</strong> @eval.Periodo • <strong>Fecha:</strong> @eval.FechaEvaluacion.ToString("dd/MM/yyyy")
                                                </MudText>

                                                @if (!string.IsNullOrWhiteSpace(eval.Observaciones))
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Dark">
                                                        <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Class="mr-1" />
                                                        @eval.Observaciones
                                                    </MudText>
                                                }

                                                <MudStack Direction="Row" AlignItems="AlignItems.Start" Spacing="2" Class="mt-1">
                                                    @if (eval.Certificado != null)
                                                    {
                                                        <MudButtonGroup Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">
                                                            <MudButton OnClick="@(() => VerCertificado(eval.Id))" 
                                                                       StartIcon="@Icons.Material.Filled.PictureAsPdf">
                                                                Ver Certificado
                                                            </MudButton>
                                                            <MudButton OnClick="@(() => AbrirPdfEnNuevaPestana(eval.Id))" 
                                                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                                                       Title="Abrir en nueva pestaña">
                                                            </MudButton>
                                                        </MudButtonGroup>
                                                    }
                                                </MudStack>
                                            </MudStack>
                                        </MudItem>

                                        <MudItem xs="12" md="4" Class="d-flex justify-end">
                                            @if (eval.Externo == false)
                                            {
                                                <MudStack Direction="Row" Spacing="1">
                                                    <MudButton Size="Size.Small" 
                                                               Color="Color.Warning"
                                                               Variant="Variant.Filled" 
                                                               OnClick="@(async () => await EditarEvaluacion(eval))" 
                                                               StartIcon="@Icons.Material.Filled.Edit"
                                                               Class="edit-btn">
                                                        Editar
                                                    </MudButton>
                                                    <MudButton Size="Size.Small" 
                                                               Color="Color.Error"
                                                               Variant="Variant.Filled" 
                                                               OnClick="@(() => EliminarEvaluacion(eval.Id))" 
                                                               StartIcon="@Icons.Material.Filled.Delete"
                                                               Class="delete-btn">
                                                        Eliminar
                                                    </MudButton>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Icon="@Icons.Material.Filled.Lock" Color="Color.Default" Variant="Variant.Text" Size="Size.Small">Solo lectura</MudChip>
                                            }
                                        </MudItem>

                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Class="mt-4">
                            <MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                                No tienes evaluaciones registradas o no se encontraron resultados para los filtros aplicados.
                            </MudText>
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudCardContent>
</MudCard>

<MudDialog @bind-Open="showModalImportar" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small })">
    <DialogContent>
        <MudContainer Class="pa-6">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                @if (modalMessageImportar.StartsWith("✅"))
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                }
                else if (modalMessageImportar.StartsWith("❌"))
                {
                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Large" />
                }
                
                <MudText Typo="Typo.h6" Align="Align.Center">
                    @if (modalMessageImportar.StartsWith("✅"))
                    {
                        <span>¡Operación Exitosa!</span>
                    }
                    else if (modalMessageImportar.StartsWith("❌"))
                    {
                        <span>Error en la Operación</span>
                    }
                    else
                    {
                        <span>Información</span>
                    }
                </MudText>
                
                <MudText Align="Align.Center" Class="mb-4">@modalMessageImportar</MudText>
                
                <MudButton Variant="Variant.Filled" 
                           Color="@(modalMessageImportar.StartsWith("✅") ? Color.Success : modalMessageImportar.StartsWith("❌") ? Color.Error : Color.Primary)" 
                           OnClick="CerrarModalImportar"
                           StartIcon="@Icons.Material.Filled.Close">
                    Cerrar
                </MudButton>
            </MudStack>
        </MudContainer>
    </DialogContent>
</MudDialog>

@* Modal de edición - Usando MudOverlay como en TeacherDashboardPapersMud *@
@if (showEditModal)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudCard Style="max-width: 700px; margin: auto; margin-top: 50px; max-height: 90vh; overflow-y: auto;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Color="Color.Primary">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                        Editar Evaluación Docente
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Dark">
                        Modifica los datos de la evaluación seleccionada
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudStack Spacing="4">
                    @if (evaluacionEditando != null)
                    {
                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info">
                            <strong>Evaluación:</strong> @(evaluacionEditando.TipoEvaluacion ?? "Ninguna seleccionada")
                        </MudAlert>
                        
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" 
                                           Label="Tipo de Evaluación *" 
                                           @bind-Value="editTipoEvaluacion" 
                                           Variant="Variant.Outlined" 
                                           Required="true"
                                           Error="@(string.IsNullOrWhiteSpace(editTipoEvaluacion))"
                                           ErrorText="El tipo de evaluación es requerido">
                                    <MudSelectItem Value="@("ESTUDIANTES")">Evaluación por Estudiantes</MudSelectItem>
                                    <MudSelectItem Value="@("PARES")">Evaluación por Pares</MudSelectItem>
                                    <MudSelectItem Value="@("AUTOEVALUACION")">Autoevaluación</MudSelectItem>
                                    <MudSelectItem Value="@("DIRECTIVOS")">Evaluación por Directivos</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" 
                                              Label="Período *" 
                                              @bind-Value="editPeriodo" 
                                              Variant="Variant.Outlined" 
                                              Required="true"
                                              Error="@(string.IsNullOrWhiteSpace(editPeriodo))"
                                              ErrorText="El período es requerido"
                                              Placeholder="Ej: 2024A, 2024B" />
                            </MudItem>
                            
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="double" 
                                                 Label="Puntaje (%) *" 
                                                 @bind-Value="editPuntaje" 
                                                 Variant="Variant.Outlined" 
                                                 Required="true"
                                                 Min="0" 
                                                 Max="100"
                                                 Step="0.1"
                                                 Error="@(editPuntaje < 0 || editPuntaje > 100)"
                                                 ErrorText="El puntaje debe estar entre 0 y 100" />
                            </MudItem>
                            
                            <MudItem xs="12" sm="6">
                                <MudDatePicker Label="Fecha de Evaluación *" 
                                               @bind-Date="editFechaEvaluacion" 
                                               Variant="Variant.Outlined" 
                                               Required="true" />
                            </MudItem>
                            
                            <MudItem xs="12">
                                <MudTextField T="string" 
                                              Label="Observaciones" 
                                              @bind-Value="editObservaciones" 
                                              Variant="Variant.Outlined" 
                                              Lines="3"
                                              Placeholder="Comentarios adicionales sobre la evaluación..." />
                            </MudItem>
                            
                            <MudItem xs="12">
                                <MudText Typo="Typo.h6" Class="mb-2">Certificado</MudText>
                                
                                @if (evaluacionEditando.Certificado != null && evaluacionEditando.Certificado.Length > 0)
                                {
                                    <MudAlert Severity="Severity.Info" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-2" />
                                        Certificado actual: @((evaluacionEditando.Certificado.Length / 1024.0).ToString("F1")) KB
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Warning" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
                                        No hay certificado asociado a esta evaluación
                                    </MudAlert>
                                }
                                
                                <MudStack Direction="Row" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudFileUpload T="IBrowserFile" 
                                                   FilesChanged="OnEditArchivoFileChanged"
                                                   Accept=".pdf">
                                        <ActivatorContent>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.CloudUpload">
                                                @(editArchivoFile != null ? "Cambiar Certificado" : "Subir Certificado") (PDF)
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                    
                                    @if (evaluacionEditando.Certificado != null && evaluacionEditando.Certificado.Length > 0)
                                    {
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   StartIcon="@Icons.Material.Filled.Delete"
                                                   OnClick="EliminarArchivoActual">
                                            Eliminar Actual
                                        </MudButton>
                                    }
                                </MudStack>
                                
                                @if (editArchivoFile != null)
                                {
                                    <MudAlert Severity="Severity.Success" Class="mt-2">
                                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" />
                                        Nuevo archivo seleccionado: @editArchivoFile.Name (@((editArchivoFile.Size / 1024.0).ToString("F1")) KB)
                                        <MudButton Size="Size.Small" 
                                                   Variant="Variant.Text" 
                                                   Color="Color.Error" 
                                                   OnClick="LimpiarArchivoSeleccionado"
                                                   StartIcon="@Icons.Material.Filled.Close"
                                                   Style="margin-left: 10px;">
                                            Cancelar
                                        </MudButton>
                                    </MudAlert>
                                }
                                
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                                    Solo archivos PDF son permitidos. Tamaño máximo: 10MB.
                                </MudText>
                            </MudItem>
                        </MudGrid>
                    }
                </MudStack>
            </MudCardContent>
            <MudCardActions Class="d-flex justify-space-between pa-4">
                <MudButton Variant="Variant.Text" 
                           Color="Color.Default"
                           OnClick="CerrarModalEdicion"
                           StartIcon="@Icons.Material.Filled.Cancel">
                    Cancelar
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           OnClick="GuardarCambiosEvaluacion"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(isLoading || !FormularioValido())">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ml-2">Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Cambios</span>
                    }
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudOverlay>
}

@* Modal de visualización de PDF - Mismo patrón que TeacherDashboardPapersMud *@
@if (showPdfModal)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudCard Style="max-width: 70vw; width: 70vw; height: 90vh; margin: auto; margin-top: 20px;margin-left: 100px;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-2" />
                        Visualizar Certificado PDF
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Dark">
                        Certificado de la evaluación docente
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0" Style="height: calc(90vh - 150px); overflow: hidden;">
                @if (pdfUrl != null)
                {
                    <div style="position: relative, width: 100%, height: 100%">
                        <iframe 
                            src="@pdfUrl" 
                            style="width: 100%; height: 100%; border: none;"
                            title="Certificado PDF"
                            frameborder="0"
                            loading="lazy">
                            <p>Tu navegador no soporta la visualización de PDFs. 
                               <a href="@pdfUrl" target="_blank">Haz clic aquí para descargar el archivo</a>
                            </p>
                        </iframe>
                    </div>
                }
                else
                {
                    <MudContainer Class="pa-4">
                        <MudAlert Severity="Severity.Error">
                            <MudText>No se pudo cargar el certificado PDF.</MudText>
                        </MudAlert>
                    </MudContainer>
                }
            </MudCardContent>
            <MudCardActions Class="d-flex justify-space-between pa-4">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           OnClick="@(() => AbrirPdfEnNuevaPestana(ObtenerIdDesdePdfUrl()))"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           Disabled="@(pdfUrl == null)">
                    Abrir en nueva pestaña
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           OnClick="CerrarPdfModal" 
                           StartIcon="@Icons.Material.Filled.Close">
                    Cerrar
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudOverlay>
}

@code {
    // Estado interno - no parámetros  
    private List<EvaluacionClienteType> EvaluacionesDocentes = new();
    private double PromedioEvaluaciones = 0;
    private bool isInitialized = false;
    private DateTime? fechaInicioNivelActual;
    
    [Parameter]
    public EventCallback OnImportarCompletado { get; set; }

    // Estado para filtros y búsqueda
    private string searchTerm = string.Empty;
    private string selectedTipo = "";
    private string selectedPeriodo = "";

    // Propiedades computadas para filtros
    private IEnumerable<string> TiposDisponibles => EvaluacionesDocentes
        .Select(e => e.TipoEvaluacion)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct()
        .OrderBy(t => t);

    private IEnumerable<string> PeriodosDisponibles => EvaluacionesDocentes
        .Select(e => e.Periodo)
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .Distinct()
        .OrderByDescending(p => p);

    private IEnumerable<EvaluacionClienteType> Filtradas => EvaluacionesDocentes
        .Where(e =>
            (string.IsNullOrWhiteSpace(searchTerm) || 
             (e.TipoEvaluacion?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.Periodo?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.Observaciones?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrWhiteSpace(selectedTipo) || e.TipoEvaluacion == selectedTipo) &&
            (string.IsNullOrWhiteSpace(selectedPeriodo) || e.Periodo == selectedPeriodo)
        );

    // Estado para modales
    private bool showModalImportar = false;
    private string modalMessageImportar = string.Empty;
    private bool showPdfModal = false;
    private string? pdfUrl;
    private bool isLoading = false;
    
    // Variables para modal de edición
    private bool showEditModal = false;
    private EvaluacionClienteType? evaluacionEditando;
    private DateTime? fechaEvaluacionEdit;
    private IBrowserFile? certificadoFile;
    private string nombreCertificadoActual = string.Empty;
    
    // Variables de edición separadas (patrón similar a papers)
    private string editTipoEvaluacion = string.Empty;
    private string editPeriodo = string.Empty;
    private double editPuntaje = 0.0;
    private DateTime? editFechaEvaluacion;
    private string editObservaciones = string.Empty;
    private IBrowserFile? editArchivoFile;
    
    protected override async Task OnInitializedAsync()
    {
        await CargarFechaInicioNivelActual();
        await CargarEvaluaciones();
        await base.OnInitializedAsync();
    }

    private async Task CargarFechaInicioNivelActual()
    {
        try
        {
            var loginResponse = await DocenteService.GetLoginResponseAsync();
            if (loginResponse?.usuario != null)
            {
                var docenteId = await DocenteService.ObtenerDocenteIdPorUsuarioId(loginResponse.usuario.Id);
                if (docenteId.HasValue)
                {
                    fechaInicioNivelActual = await DocenteService.ObtenerFechaInicioNivelActualAsync(docenteId.Value);
                    Console.WriteLine($"[EVALUACIONES] Fecha inicio nivel actual: {fechaInicioNivelActual}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar fecha inicio nivel actual: {ex.Message}");
        }
    }

    private async Task CargarEvaluaciones()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            Console.WriteLine("[EVALUACIONES] Cargando evaluaciones docentes...");
            
            // Si tenemos fecha de inicio del nivel, filtrar las evaluaciones
            if (fechaInicioNivelActual.HasValue)
            {
                var loginResponse = await DocenteService.GetLoginResponseAsync();
                if (loginResponse?.usuario != null)
                {
                    var docenteId = await DocenteService.ObtenerDocenteIdPorUsuarioId(loginResponse.usuario.Id);
                    if (docenteId.HasValue)
                    {
                        Console.WriteLine($"[EVALUACIONES] Filtrando evaluaciones desde: {fechaInicioNivelActual.Value:yyyy-MM-dd}");
                        
                        // Obtener todas las evaluaciones
                        var todasLasEvaluaciones = await DocenteService.getEvaluacionesDocentes();
                        if (todasLasEvaluaciones != null)
                        {
                            // Filtrar solo las evaluaciones posteriores a la fecha de inicio del nivel
                            var evaluacionesFiltradas = todasLasEvaluaciones
                                .Where(e => e.FechaEvaluacion >= fechaInicioNivelActual.Value)
                                .ToList();
                            
                            EvaluacionesDocentes = evaluacionesFiltradas;
                            Console.WriteLine($"[EVALUACIONES] Evaluaciones totales: {todasLasEvaluaciones.Length}, Filtradas: {EvaluacionesDocentes.Count}");
                            
                            // Calcular promedio solo de las evaluaciones filtradas
                            if (EvaluacionesDocentes.Any())
                            {
                                PromedioEvaluaciones = EvaluacionesDocentes.Average(e => e.Puntaje);
                                Console.WriteLine($"[EVALUACIONES] Promedio calculado desde nivel actual: {PromedioEvaluaciones:F1}");
                            }
                            else
                            {
                                PromedioEvaluaciones = 0;
                                Console.WriteLine("[EVALUACIONES] No hay evaluaciones desde el inicio del nivel actual");
                            }
                        }
                        else
                        {
                            EvaluacionesDocentes = new List<EvaluacionClienteType>();
                            PromedioEvaluaciones = 0;
                        }
                    }
                }
            }
            else
            {
                // Si no tenemos fecha de inicio, usar el método original
                Console.WriteLine("[EVALUACIONES] No hay fecha de inicio del nivel, cargando todas las evaluaciones");
                var evaluaciones = await DocenteService.getEvaluacionesDocentes();
                if (evaluaciones != null && evaluaciones.Any())
                {
                    EvaluacionesDocentes = evaluaciones.ToList();
                    var promedio = await DocenteService.ObtenerPromedioEvaluacionesAsync();
                    PromedioEvaluaciones = promedio;
                }
                else
                {
                    EvaluacionesDocentes = new List<EvaluacionClienteType>();
                    PromedioEvaluaciones = 0;
                }
            }

            isInitialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar evaluaciones: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            EvaluacionesDocentes = new List<MyCleanApp.Client.DTOs.EvaluacionDocenteDto>();
            PromedioEvaluaciones = 0;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
