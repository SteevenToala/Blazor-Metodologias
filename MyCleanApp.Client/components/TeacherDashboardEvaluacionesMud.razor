@using System
@using System.Collections.Generic
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MyCleanApp.Client.DTOs
@using EvaluacionClienteType = MyCleanApp.Client.DTOs.EvaluacionDocenteDto

@inject DocenteService DocenteService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject LocalStorageService LocalStorage

<style>
    .evaluation-card {
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }
    
    .evaluation-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        border-left-color: #1976d2;
    }
    
    .edit-btn {
        background: linear-gradient(45deg, #ff9800, #f57c00) !important;
    }
    
    .delete-btn {
        background: linear-gradient(45deg, #f44336, #d32f2f) !important;
    }
    
    .edit-btn:hover, .delete-btn:hover {
        transform: scale(1.05);
        transition: transform 0.2s ease;
    }
</style>

<MudCard Elevation="1">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Style="Color: #1976d2;">Evaluaciones Docentes</MudText>
            <MudText Typo="Typo.body2" Color="Color.Dark">Tus evaluaciones registradas en el sistema</MudText>
            @if (PromedioEvaluaciones > 0)
            {
                <MudChip T="string" 
                         Color="@(PromedioEvaluaciones >= 75 ? Color.Success : Color.Warning)" 
                         Variant="Variant.Filled" 
                         Size="Size.Medium"
                         Icon="@Icons.Material.Filled.Assessment">
                    Promedio: @PromedioEvaluaciones.ToString("F2")%
                </MudChip>
            }
        </CardHeaderContent>
        <CardHeaderActions>
            <MudStack Direction="Row" Spacing="1">
                 <MudButton Variant="Variant.Filled" 
                           Style="background-color: #1976d2; color: white;"
                           OnClick="IrASubirEvaluacion" 
                           StartIcon="@Icons.Material.Filled.Add">Añadir Nueva</MudButton>
                 <MudButton Variant="Variant.Outlined" 
                           Style="border-color: #1976d2; color: #1976d2;"
                           OnClick="ImportarEvaluacionesExternas" 
                           StartIcon="@Icons.Material.Filled.CloudDownload">Importar Datos</MudButton>
            </MudStack>
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent>
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center" style="min-height: 300px;">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Class="ml-3" Color="Color.Secondary">Cargando evaluaciones...</MudText>
            </div>
        }
        else
        {
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" Label="Filtrar por Tipo" @bind-Value="selectedTipo" Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value=null>Todos los tipos</MudSelectItem>
                        @foreach (var tipo in TiposDisponibles)
                        {
                            <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" Label="Filtrar por Período" @bind-Value="selectedPeriodo" Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value=null>Todos los períodos</MudSelectItem>
                        @foreach (var periodo in PeriodosDisponibles)
                        {
                            <MudSelectItem T="string" Value="@periodo">@periodo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                     <MudTextField T="string" 
                                  Label="Buscar evaluación..." 
                                  @bind-Value="searchTerm" 
                                  Dense="true" 
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="2" Class="d-flex align-center">
                    <MudButton FullWidth="true" 
                               Variant="Variant.Text" 
                               Style="background-color: #1976d2; color: white;"
                               OnClick="LimpiarFiltros">Limpiar Filtros</MudButton>
                </MudItem>
            </MudGrid>
            
            <MudDivider />

            <MudGrid Class="mt-4" Spacing="3">
                @if (Filtradas != null && Filtradas.Any())
                {
                    foreach (var eval in Filtradas)
                    {
                        <MudItem xs="12">
                            <MudCard Elevation="2" Class="evaluation-card">
                                <MudCardContent>
                                    <MudGrid AlignItems="AlignItems.Center">
                                        
                                        <MudItem xs="12" md="8">
                                            <MudStack Spacing="2">
                                                <MudStack Direction="Row" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.h6" Color="Color.Primary">@eval.TipoEvaluacion</MudText>
                                                    <MudChip T="string" 
                                                             Color="@(eval.Puntaje >= 75 ? Color.Success : eval.Puntaje >= 60 ? Color.Warning : Color.Error)" 
                                                             Variant="Variant.Filled" 
                                                             Size="Size.Small">
                                                        @eval.Puntaje.ToString("F1")%
                                                    </MudChip>
                                                    @if (eval.Externo == true)
                                                    {
                                                        <MudChip T="string" Label="true" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Cloud">Externo</MudChip>
                                                    }
                                                    else
                                                    {
                                                        <MudChip T="string" Label="true" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Home">Local</MudChip>
                                                    }
                                                </MudStack>

                                                <MudText Typo="Typo.body2" Color="Color.Dark">
                                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1" />
                                                    <strong>Período:</strong> @eval.Periodo • <strong>Fecha:</strong> @eval.FechaEvaluacion.ToString("dd/MM/yyyy")
                                                </MudText>

                                                @if (!string.IsNullOrWhiteSpace(eval.Observaciones))
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Dark">
                                                        <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Class="mr-1" />
                                                        @eval.Observaciones
                                                    </MudText>
                                                }

                                                <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                                                    @if (eval.Certificado != null)
                                                    {
                                                        <MudButton Size="Size.Small" 
                                                                   Color="Color.Primary"
                                                                   Variant="Variant.Text" 
                                                                   OnClick="@(() => VerCertificado(eval.Id))" 
                                                                   StartIcon="@Icons.Material.Filled.PictureAsPdf">Ver Certificado</MudButton>
                                                    }
                                                </MudStack>
                                            </MudStack>
                                        </MudItem>

                                        <MudItem xs="12" md="4" Class="d-flex justify-end">
                                            @if (eval.Externo == false)
                                            {
                                                <MudStack Direction="Row" Spacing="1">
                                                    <MudButton Size="Size.Small" 
                                                               Color="Color.Warning"
                                                               Variant="Variant.Filled" 
                                                               OnClick="@(() => EditarEvaluacion(eval))" 
                                                               StartIcon="@Icons.Material.Filled.Edit"
                                                               Class="edit-btn">
                                                        Editar
                                                    </MudButton>
                                                    <MudButton Size="Size.Small" 
                                                               Color="Color.Error"
                                                               Variant="Variant.Filled" 
                                                               OnClick="@(() => EliminarEvaluacion(eval.Id))" 
                                                               StartIcon="@Icons.Material.Filled.Delete"
                                                               Class="delete-btn">
                                                        Eliminar
                                                    </MudButton>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Icon="@Icons.Material.Filled.Lock" Color="Color.Default" Variant="Variant.Text" Size="Size.Small">Solo lectura</MudChip>
                                            }
                                        </MudItem>

                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Class="mt-4">
                            <MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                                No tienes evaluaciones registradas o no se encontraron resultados para los filtros aplicados.
                            </MudText>
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudCardContent>
</MudCard>

<MudDialog @bind-Open="showModalImportar" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small })">
    <DialogContent>
        <MudContainer Class="pa-6">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                @if (modalMessageImportar.StartsWith("✅"))
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                }
                else if (modalMessageImportar.StartsWith("❌"))
                {
                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Large" />
                }
                
                <MudText Typo="Typo.h6" Align="Align.Center">
                    @if (modalMessageImportar.StartsWith("✅"))
                    {
                        <span>¡Operación Exitosa!</span>
                    }
                    else if (modalMessageImportar.StartsWith("❌"))
                    {
                        <span>Error en la Operación</span>
                    }
                    else
                    {
                        <span>Información</span>
                    }
                </MudText>
                
                <MudText Align="Align.Center" Class="mb-4">@modalMessageImportar</MudText>
                
                <MudButton Variant="Variant.Filled" 
                           Color="@(modalMessageImportar.StartsWith("✅") ? Color.Success : modalMessageImportar.StartsWith("❌") ? Color.Error : Color.Primary)" 
                           OnClick="CerrarModalImportar"
                           StartIcon="@Icons.Material.Filled.Close">
                    Cerrar
                </MudButton>
            </MudStack>
        </MudContainer>
    </DialogContent>
</MudDialog>

<MudDialog @bind-Open="showEditModal" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <DialogContent>
        <MudContainer Class="pa-6">
            <MudText Typo="Typo.h5" Class="mb-4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                Editar Evaluación Docente
            </MudText>
            
            @if (evaluacionEditando != null)
            {
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" 
                                   Label="Tipo de Evaluación" 
                                   @bind-Value="evaluacionEditando.TipoEvaluacion" 
                                   Variant="Variant.Outlined" 
                                   Required="true">
                            <MudSelectItem Value="@("ESTUDIANTES")">Evaluación por Estudiantes</MudSelectItem>
                            <MudSelectItem Value="@("PARES")">Evaluación por Pares</MudSelectItem>
                            <MudSelectItem Value="@("AUTOEVALUACION")">Autoevaluación</MudSelectItem>
                            <MudSelectItem Value="@("DIRECTIVOS")">Evaluación por Directivos</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" 
                                      Label="Período" 
                                      @bind-Value="evaluacionEditando.Periodo" 
                                      Variant="Variant.Outlined" 
                                      Required="true"
                                      Placeholder="Ej: 2024A, 2024B" />
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="double" 
                                         Label="Puntaje (%)" 
                                         @bind-Value="evaluacionEditando.Puntaje" 
                                         Variant="Variant.Outlined" 
                                         Required="true"
                                         Min="0" 
                                         Max="100"
                                         Step="0.1" />
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Fecha de Evaluación" 
                                       @bind-Date="fechaEvaluacionEdit" 
                                       Variant="Variant.Outlined" 
                                       Required="true" />
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MudTextField T="string" 
                                      Label="Observaciones" 
                                      @bind-Value="evaluacionEditando.Observaciones" 
                                      Variant="Variant.Outlined" 
                                      Lines="3"
                                      Placeholder="Comentarios adicionales sobre la evaluación..." />
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                            Los certificados PDF se pueden subir después de guardar los cambios.
                        </MudText>
                    </MudItem>
                </MudGrid>
                
                <MudDivider Class="my-4" />
                
                <MudStack Direction="Row" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" 
                               OnClick="CerrarModalEdicion"
                               StartIcon="@Icons.Material.Filled.Cancel">
                        Cancelar
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               OnClick="GuardarCambiosEvaluacion"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="isLoading">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ml-2">Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Cambios</span>
                        }
                    </MudButton>
                </MudStack>
            }
        </MudContainer>
    </DialogContent>
</MudDialog>

<MudDialog @bind-Open="showPdfModal">
    <DialogContent>
        <MudText Typo="Typo.h6">Certificado de Evaluación</MudText>
        @if (pdfUrl != null)
        {
            <iframe src="@pdfUrl" style="width:100%; height:600px; border:none;"></iframe>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CerrarPdfModal" Class="mt-4">Cerrar</MudButton>
    </DialogContent>
</MudDialog>

@code {
    // Estado interno - no parámetros  
    private List<EvaluacionClienteType> EvaluacionesDocentes = new();
    private double PromedioEvaluaciones = 0;
    private bool isInitialized = false;
    
    [Parameter]
    public EventCallback OnImportarCompletado { get; set; }

    // Estado para filtros y búsqueda
    private string searchTerm = string.Empty;
    private string selectedTipo = "";
    private string selectedPeriodo = "";

    // Propiedades computadas para filtros
    private IEnumerable<string> TiposDisponibles => EvaluacionesDocentes
        .Select(e => e.TipoEvaluacion)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct()
        .OrderBy(t => t);

    private IEnumerable<string> PeriodosDisponibles => EvaluacionesDocentes
        .Select(e => e.Periodo)
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .Distinct()
        .OrderByDescending(p => p);

    private IEnumerable<EvaluacionClienteType> Filtradas => EvaluacionesDocentes
        .Where(e =>
            (string.IsNullOrWhiteSpace(searchTerm) || 
             (e.TipoEvaluacion?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.Periodo?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.Observaciones?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrWhiteSpace(selectedTipo) || e.TipoEvaluacion == selectedTipo) &&
            (string.IsNullOrWhiteSpace(selectedPeriodo) || e.Periodo == selectedPeriodo)
        );

    // Estado para modales
    private bool showModalImportar = false;
    private string modalMessageImportar = string.Empty;
    private bool showPdfModal = false;
    private string? pdfUrl;
    private bool isLoading = false;
    
    // Variables para modal de edición
    private bool showEditModal = false;
    private EvaluacionClienteType? evaluacionEditando;
    private DateTime? fechaEvaluacionEdit;
    
    protected override async Task OnInitializedAsync()
    {
        await CargarEvaluaciones();
        await base.OnInitializedAsync();
    }

    private async Task CargarEvaluaciones()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            Console.WriteLine("Cargando evaluaciones docentes...");
            
            var evaluaciones = await DocenteService.getEvaluacionesDocentes();
            if (evaluaciones != null && evaluaciones.Any())
            {
                // Convertir directamente desde el array del servicio
                EvaluacionesDocentes = evaluaciones.ToList();
                
                Console.WriteLine($"Se cargaron {EvaluacionesDocentes.Count} evaluaciones");
                // Debug: mostrar la primera fecha para verificar
                if (EvaluacionesDocentes.Any())
                {
                    var primerEval = EvaluacionesDocentes.First();
                    Console.WriteLine($"Primera evaluación - Fecha: {primerEval.FechaEvaluacion:yyyy-MM-dd}, Tipo: {primerEval.TipoEvaluacion}");
                }
            }
            else
            {
                EvaluacionesDocentes = new List<EvaluacionClienteType>();
                Console.WriteLine("No se encontraron evaluaciones");
            }

            var promedio = await DocenteService.ObtenerPromedioEvaluacionesAsync();
            PromedioEvaluaciones = promedio;
            Console.WriteLine($"Promedio de evaluaciones: {PromedioEvaluaciones}");

            isInitialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar evaluaciones: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            EvaluacionesDocentes = new List<MyCleanApp.Client.DTOs.EvaluacionDocenteDto>();
            PromedioEvaluaciones = 0;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    // Métodos de navegación y acciones de la UI
    private void IrASubirEvaluacion()
    {
        Navigation.NavigateTo("/subir-evaluacion");
    }

    private void LimpiarFiltros()
    {
        searchTerm = string.Empty;
        selectedTipo = "";
        selectedPeriodo = "";
    }

    private void CerrarModalImportar() => showModalImportar = false;
    private void CerrarPdfModal()
    {
        showPdfModal = false;
        pdfUrl = null;
    }

    // Métodos de lógica de negocio (CRUD)
    private void ImportarEvaluacionesExternas()
    {
        modalMessageImportar = "⚠️ Función de importación externa no implementada aún.";
        showModalImportar = true;
    }

    private void VerCertificado(int evaluacionId)
    {
        pdfUrl = $"http://localhost:5015/api/EvaluacionDocente/archivo/{evaluacionId}";
        showPdfModal = true;
    }

    private void EditarEvaluacion(EvaluacionClienteType eval)
    {
        Console.WriteLine($"[DEBUG] Iniciando edición de evaluación: {eval.TipoEvaluacion}");
        
        // Crear una copia de la evaluación para editar
        evaluacionEditando = new EvaluacionClienteType
        {
            Id = eval.Id,
            TipoEvaluacion = eval.TipoEvaluacion,
            Periodo = eval.Periodo,
            Puntaje = eval.Puntaje,
            FechaEvaluacion = eval.FechaEvaluacion,
            Observaciones = eval.Observaciones,
            Externo = eval.Externo,
            Certificado = eval.Certificado
        };
        
        // Configurar la fecha para el DatePicker
        fechaEvaluacionEdit = eval.FechaEvaluacion != DateTime.MinValue ? eval.FechaEvaluacion : DateTime.Now;
        
        showEditModal = true;
    }

    private void CerrarModalEdicion()
    {
        showEditModal = false;
        evaluacionEditando = null;
        fechaEvaluacionEdit = null;
    }

    private async Task GuardarCambiosEvaluacion()
    {
        if (evaluacionEditando == null)
        {
            modalMessageImportar = "❌ Error: No se pudo obtener la evaluación para editar.";
            showModalImportar = true;
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            // Actualizar la fecha de evaluación desde el DatePicker
            if (fechaEvaluacionEdit.HasValue)
            {
                evaluacionEditando.FechaEvaluacion = fechaEvaluacionEdit.Value;
            }

            // Validaciones básicas
            if (string.IsNullOrWhiteSpace(evaluacionEditando.TipoEvaluacion))
            {
                modalMessageImportar = "❌ Error: El tipo de evaluación es requerido.";
                showModalImportar = true;
                return;
            }

            if (string.IsNullOrWhiteSpace(evaluacionEditando.Periodo))
            {
                modalMessageImportar = "❌ Error: El período es requerido.";
                showModalImportar = true;
                return;
            }

            if (evaluacionEditando.Puntaje < 0 || evaluacionEditando.Puntaje > 100)
            {
                modalMessageImportar = "❌ Error: El puntaje debe estar entre 0 y 100.";
                showModalImportar = true;
                return;
            }

            Console.WriteLine($"[DEBUG] Guardando cambios para evaluación ID: {evaluacionEditando.Id}");

            var response = await DocenteService.EditarEvaluacionAsync(evaluacionEditando);
            if (response)
            {
                modalMessageImportar = $"✅ La evaluación '{evaluacionEditando.TipoEvaluacion}' ha sido actualizada exitosamente.";
                showModalImportar = true;
                
                // Cerrar modal de edición
                CerrarModalEdicion();
                
                // Recargar evaluaciones
                await CargarEvaluaciones();
                
                if (OnImportarCompletado.HasDelegate)
                    await OnImportarCompletado.InvokeAsync();
            }
            else
            {
                modalMessageImportar = "❌ Error: No se pudo actualizar la evaluación. Verifica tu conexión e intenta nuevamente.";
                showModalImportar = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Error al guardar cambios: {ex.Message}");
            modalMessageImportar = $"❌ Error inesperado al guardar: {ex.Message}";
            showModalImportar = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task EliminarEvaluacion(int evaluacionId)
    {
        try
        {
            var evaluacion = EvaluacionesDocentes.FirstOrDefault(e => e.Id == evaluacionId);
            string descripcion = evaluacion?.TipoEvaluacion ?? "la evaluación seleccionada";
            
            bool? result = await DialogService.ShowMessageBox(
                "⚠️ Confirmar eliminación",
                $"¿Estás seguro de que deseas eliminar '{descripcion}'?\n\nEsta acción es irreversible y no se puede deshacer.",
                yesText: "Sí, eliminar", 
                cancelText: "Cancelar",
                options: new DialogOptions { MaxWidth = MaxWidth.Small });
            
            if (result == true)
            {
                isLoading = true;
                StateHasChanged();
                
                var response = await DocenteService.EliminarEvaluacionDocenteAsync(evaluacionId);
                if (response)
                {
                    modalMessageImportar = $"✅ '{descripcion}' ha sido eliminada exitosamente.";
                    showModalImportar = true;
                    
                    // Recargar evaluaciones
                    await CargarEvaluaciones();
                    
                    if (OnImportarCompletado.HasDelegate)
                        await OnImportarCompletado.InvokeAsync();
                }
                else
                {
                    modalMessageImportar = "❌ Error: No se pudo eliminar la evaluación. Verifica tu conexión e intenta nuevamente.";
                    showModalImportar = true;
                }
            }
        }
        catch (Exception ex)
        {
            modalMessageImportar = $"❌ Error inesperado al eliminar: {ex.Message}";
            showModalImportar = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
