@page "/subir-evaluacion"
@using MyCleanApp.Client.DTOs
@inject DocenteService DocenteService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudPaper Class="pa-6" Elevation="3">
        <!-- Header con botón de regreso -->
        <MudGrid>
            <MudItem xs="12">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">
                            Nueva Evaluación Docente
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Primary" 
                              StartIcon="@Icons.Material.Filled.ArrowBack"
                              OnClick="VolverAlDashboard">
                        Volver al Dashboard
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            Completa el formulario para registrar una nueva evaluación en el sistema.
        </MudText>

        <!-- Formulario -->
        <EditForm Model="@evaluacion" OnValidSubmit="SubirEvaluacion">
            <MudGrid Spacing="4">
                <!-- Tipo de Evaluación -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" 
                              Label="Tipo de Evaluación *" 
                              @bind-Value="evaluacion.TipoEvaluacion"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El tipo de evaluación es requerido">
                        <MudSelectItem Value="@("ESTUDIANTES")">Evaluación por Estudiantes</MudSelectItem>
                        <MudSelectItem Value="@("PARES")">Evaluación por Pares</MudSelectItem>
                        <MudSelectItem Value="@("AUTOEVALUACION")">Autoevaluación</MudSelectItem>
                        <MudSelectItem Value="@("DIRECTIVOS")">Evaluación por Directivos</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Período -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="evaluacion.Periodo"
                                 Label="Período *"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 RequiredError="El período es requerido"
                                 Placeholder="Ej: 2024A, 2024B"
                                 HelperText="Formato: Año + Letra (2024A, 2024B)" />
                </MudItem>

                <!-- Puntaje -->
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="evaluacion.Puntaje"
                                    Label="Puntaje (%) *"
                                    Variant="Variant.Outlined"
                                    Required="true"
                                    Min="0"
                                    Max="100"
                                    Step="0.1"
                                    RequiredError="El puntaje es requerido"
                                    HelperText="Valor entre 0 y 100"
                                    Adornment="Adornment.End"
                                    AdornmentText="%" />
                </MudItem>

                <!-- Fecha de Evaluación -->
                <MudItem xs="12" sm="6">
                                    <MudDatePicker @bind-Date="evaluacion.FechaEvaluacion"
                              Label="Fecha de Evaluación *"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La fecha de evaluación es requerida"
                              DateFormat="dd/MM/yyyy"
                              PickerVariant="PickerVariant.Dialog" />
                </MudItem>

                <!-- Observaciones -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="evaluacion.Observaciones"
                                 Label="Observaciones"
                                 Variant="Variant.Outlined"
                                 Lines="3"
                                 Placeholder="Comentarios adicionales sobre la evaluación..."
                                 HelperText="Opcional: Agrega comentarios relevantes sobre la evaluación" />
                </MudItem>

                <!-- Certificado PDF -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="1" Style="border: 2px dashed #ccc;">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" />
                                Certificado PDF
                            </MudText>
                            
                            @if (archivoSeleccionado != null)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Value="@archivoSeleccionado.Name">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" />
                                    @archivoSeleccionado.Name (@FormatFileSize(archivoSeleccionado.Size))
                                </MudChip>
                            }
                            
                            <InputFile OnChange="OnFileChange" class="mud-input-file" accept=".pdf" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Solo archivos PDF son permitidos. Tamaño máximo: 10MB.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <!-- Botones de acción -->
                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="3" Class="mt-4">
                        <MudButton Variant="Variant.Outlined" 
                                  Color="Color.Secondary"
                                  OnClick="VolverAlDashboard">
                            Cancelar
                        </MudButton>
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Primary"
                                  ButtonType="ButtonType.Submit"
                                  StartIcon="@Icons.Material.Filled.Save"
                                  Disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Evaluación</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    EvaluacionDocenteRequest evaluacion = new() { 
        DocenteId = 1,
        FechaEvaluacion = DateTime.Now, // o null si prefieres
        Puntaje = 0.0
    };

    private IBrowserFile? archivoSeleccionado;
    private bool isSubmitting = false;

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        archivoSeleccionado = file;
        
        // Validar que sea un archivo PDF
        if (!file.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("❌ Error: Solo se permiten archivos PDF para el certificado.", Severity.Error);
            archivoSeleccionado = null;
            return;
        }
        
        // Validar tamaño del archivo (máximo 10MB)
        const int maxSizeInBytes = 10 * 1024 * 1024; // 10MB
        if (file.Size > maxSizeInBytes)
        {
            Snackbar.Add("❌ Error: El archivo es demasiado grande. Máximo permitido: 10MB.", Severity.Error);
            archivoSeleccionado = null;
            return;
        }
        
        try
        {
            using var stream = file.OpenReadStream(maxSizeInBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            evaluacion.Certificado = ms.ToArray();
            
            Snackbar.Add("✅ Archivo PDF cargado correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Error al procesar el archivo: {ex.Message}", Severity.Error);
            archivoSeleccionado = null;
        }
    }

    private async Task SubirEvaluacion()
    {
        isSubmitting = true;
        
        try
        {
            // Validaciones básicas
            if (string.IsNullOrWhiteSpace(evaluacion.TipoEvaluacion))
            {
                Snackbar.Add("❌ Error: El tipo de evaluación es requerido.", Severity.Error);
                return;
            }
            
            if (string.IsNullOrWhiteSpace(evaluacion.Periodo))
            {
                Snackbar.Add("❌ Error: El período es requerido.", Severity.Error);
                return;
            }
            
            if (evaluacion.Puntaje < 0 || evaluacion.Puntaje > 100)
            {
                Snackbar.Add("❌ Error: El puntaje debe estar entre 0 y 100.", Severity.Error);
                return;
            }
            
            if (evaluacion.FechaEvaluacion == DateTime.MinValue)
            {
                Snackbar.Add("❌ Error: La fecha de evaluación es requerida.", Severity.Error);
                return;
            }
            
            var ok = await DocenteService.SubirEvaluacionDocenteAsync(evaluacion);
            if (ok)
            {
                Snackbar.Add("✅ Evaluación subida con éxito.", Severity.Success);
                await Task.Delay(1500); // Pequeña pausa para mostrar el mensaje
                VolverAlDashboard();
            }
            else
            {
                Snackbar.Add("❌ Error al subir la evaluación.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
    
    private void VolverAlDashboard()
    {
        Navigation.NavigateTo("/teacher-dashboard");
    }
}
