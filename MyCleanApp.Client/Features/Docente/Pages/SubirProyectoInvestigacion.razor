@page "/subir-proyecto-investigacion"
@using MyCleanApp.Client.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject DocenteService DocenteService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="max-w-xl mx-auto mt-10">
    <div class="bg-white border border-gray-200 rounded-lg shadow-lg p-8">
        <div class="flex justify-end mb-4">
            <button
                class="flex items-center gap-2 bg-gray-100 hover:bg-blue-100 text-blue-700 font-medium py-1.5 px-4 rounded transition-colors border border-gray-200 shadow-sm"
                @onclick="Volver">
                <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Volver al Dashboard
            </button>
        </div>
        <h2 class="text-2xl font-bold text-blue-700 mb-2 flex items-center gap-2">
            <svg class="h-7 w-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nuevo Proyecto de Investigación
        </h2>
        <p class="text-gray-600 mb-6">Completa el formulario para registrar un nuevo proyecto de investigación.</p>

        <EditForm Model="proyecto" OnValidSubmit="RegistrarProyecto" class="space-y-5">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Título</label>
                <InputText @bind-Value="proyecto.Titulo"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Fecha de Inicio</label>
                    <InputDate @bind-Value="proyecto.FechaInicio"
                        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Fecha de Fin</label>
                    <InputDate @bind-Value="proyecto.FechaFin"
                        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Rol en el Proyecto</label>
                <InputText @bind-Value="proyecto.RolEnProyecto"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Documento (opcional, PDF)</label>
                <InputFile OnChange="OnFileChange" class="w-full text-gray-700" />
            </div>
            <div class="flex justify-end">
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
                    Registrar Proyecto
                </button>
            </div>
        </EditForm>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mt-4">@errorMessage</div>
        }
    </div>
</div>

@code {
    private ProyectoInvestigacionRequest proyecto = new ProyectoInvestigacionRequest();
    private string? errorMessage;

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream();
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        // Igual que publicaciones: convertir a base64
        proyecto.Documento = ms.ToArray();
    }

    private async Task RegistrarProyecto()
    {
        errorMessage = null;
        try
        {
            // Igual que publicaciones: DocenteId se setea en el servicio
            var result = await DocenteService.RegistrarProyectoInvestigacionAsync(proyecto);
            if (result)
            {
                await JS.InvokeVoidAsync("alert", "✅ Proyecto registrado con éxito.");
                Navigation.NavigateTo("/teacher-dashboard");
            }
            else
            {
                errorMessage = "No se pudo registrar el proyecto. Intenta nuevamente.";
                await JS.InvokeVoidAsync("alert", "❌ Error al registrar el proyecto. Verifica que tu usuario sea un docente válido.");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/teacher-dashboard");
    }
}
