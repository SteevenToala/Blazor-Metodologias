    private void ProcesarApelacion(ApelacionDto apelacion)
    {
        apelacionSeleccionada = apelacion;
        
        // Limpiar formulario para nueva evaluación
        decisionComision = "";
        fundamentosDecision = "";
        
        mostrarModalProcesamiento = true;
    }

    private void CerrarModalProcesamiento()
    {
        mostrarModalProcesamiento = false;
        apelacionSeleccionada = null;
    }

    private Task GuardarBorrador()
    {
        try
        {
            if (apelacionSeleccionada != null)
            {
                // Guardar progreso como borrador
                apelacionSeleccionada.Estado = "EN_PROCESO";
                
                // Mover de recibidas a en proceso si no estaba ya
                if (apelacionesRecibidas.Contains(apelacionSeleccionada))
                {
                    apelacionesRecibidas.Remove(apelacionSeleccionada);
                    apelacionesEnProceso.Add(apelacionSeleccionada);
                }
                
                // Aquí se haría la llamada real a la API para guardar el borrador
                // await Http.PostAsJsonAsync("/api/Apelaciones/borrador", borradorData);
                
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar borrador: {ex.Message}";
        }
        
        return Task.CompletedTask;
    }

    private async Task FinalizarApelacion()
    {
        try
        {
            if (apelacionSeleccionada != null)
            {
                // Crear objeto de resolución de apelación más simple
                var resolucionApelacion = new
                {
                    Aceptada = decisionComision == "APELACION_ACEPTADA",
                    Resolucion = fundamentosDecision // Solo las observaciones, sin concatenar mucho texto
                };

                // Llamar al endpoint del backend para resolver la apelación
                var endpoint = $"http://localhost:5015/api/SolicitudAvanceRango/{apelacionSeleccionada.Id}/resolver-apelacion";

                var response = await Http.PostAsJsonAsync(endpoint, resolucionApelacion);
                
                if (response.IsSuccessStatusCode)
                {
                    var responseContent = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"[DEBUG] Respuesta exitosa: {responseContent}");
                    
                    // Remover de las listas locales ya que cambiará de estado
                    apelacionesRecibidas.Remove(apelacionSeleccionada);
                    apelacionesEnProceso.Remove(apelacionSeleccionada);
                    
                    // Si la apelación fue rechazada, se mantiene en el sistema como resuelta
                    if (decisionComision == "APELACION_RECHAZADA")
                    {
                        apelacionSeleccionada.Estado = "RESUELTA";
                        apelacionSeleccionada.DecisionFinal = "RECHAZADA";
                        apelacionSeleccionada.FundamentosDecision = fundamentosDecision;
                        apelacionSeleccionada.FechaResolucion = DateTime.Now;
                        apelacionesResueltas.Add(apelacionSeleccionada);
                    }
                    // Si fue aprobada, la solicitud regresa al flujo normal (EN_ANALISIS_COMISION)
                    // y ya no aparece en el sistema de apelaciones
                    
                    // Actualizar lista de críticas
                    apelacionesVenciendo = apelacionesRecibidas
                        .Concat(apelacionesEnProceso)
                        .Where(a => a.EsCritico)
                        .OrderBy(a => a.FechaLimite)
                        .ToList();
                    
                    // Mostrar mensaje de éxito apropiado
                    if (resolucionApelacion.Aceptada)
                    {
                        Snackbar.Add("Apelación APROBADA - La solicitud regresa para reevaluación por la comisión", Severity.Success);
                    }
                    else
                    {
                        Snackbar.Add("Apelación RECHAZADA - Decisión original mantenida", Severity.Info);
                    }
                    
                    CerrarModalProcesamiento();
                    StateHasChanged();
                    
                    // Recargar datos para asegurar sincronización
                    await CargarApelaciones();
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"[DEBUG] Error en respuesta: {response.StatusCode} - {errorContent}");
                    errorMessage = $"Error al procesar la apelación: {response.StatusCode}";
                    Snackbar.Add($"Error al procesar la apelación: {errorContent}", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Excepción: {ex.Message}");
            errorMessage = $"Error al finalizar apelación: {ex.Message}";
            Snackbar.Add($"Error al finalizar apelación: {ex.Message}", Severity.Error);
        }
    }

    private string GetEstadoClasses(string estado)
    {
        return estado switch
        {
            "RECIBIDA" => "bg-blue-100 text-blue-800",
            "EN_PROCESO" => "bg-yellow-100 text-yellow-800",
            "RESUELTA" => "bg-green-100 text-green-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private Color GetEstadoColorMud(string estado)
    {
        return estado switch
        {
            "RECIBIDA" => Color.Primary,
            "EN_PROCESO" => Color.Warning,
            "RESUELTA" => Color.Success,
            _ => Color.Secondary
        };
    }
