@inject HttpClient Http
@using System.Text.Json
@using MyCleanApp.Client.DTOs

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
        <div class="p-4 pb-2">
            <div class="text-sm font-medium text-gray-600">Total de Docentes</div>
        </div>
        <div class="p-4 pt-0">
            @if (loading)
            {
                <div class="text-2xl font-bold text-gray-400">...</div>
            }
            else
            {
                <div class="text-2xl font-bold">@totalDocentes</div>
            }
        </div>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
        <div class="p-4 pb-2">
            <div class="text-sm font-medium text-gray-600">Solicitudes Pendientes</div>
        </div>
        <div class="p-4 pt-0 flex items-end justify-between">
            @if (loading)
            {
                <div class="text-2xl font-bold text-gray-400">...</div>
            }
            else
            {
                <div class="text-2xl font-bold">@solicitudesPendientes</div>
                @if (solicitudesPendientes > 0)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        Revisar
                    </span>
                }
            }
        </div>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
        <div class="p-4 pb-2">
            <div class="text-sm font-medium text-gray-600">Evaluaciones Pendientes</div>
        </div>
        <div class="p-4 pt-0">
            <div class="text-2xl font-bold">3</div>
        </div>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
        <div class="p-4 pb-2">
            <div class="text-sm font-medium text-gray-600">Próximas Revisiones</div>
        </div>
        <div class="p-4 pt-0">
            <div class="text-2xl font-bold">7</div>
        </div>
    </div>
</div>

@code {
    private int totalDocentes = 0;
    private int solicitudesPendientes = 0;
    private bool loading = true;

    public class TotalDocentesResponse
    {
        public int totalDocentes { get; set; }
    }

    public class SolicitudAvanceRangoDto
    {
        public int Id { get; set; }
        public string DocenteNombre { get; set; } = string.Empty;
        public string NivelActual { get; set; } = string.Empty;
        public string NivelSolicitado { get; set; } = string.Empty;
        public DateTime FechaSolicitud { get; set; }
        public string Estado { get; set; } = string.Empty;
        public string Observaciones { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadisticas();
    }

    private async Task CargarEstadisticas()
    {
        try
        {
            loading = true;
            
            // Cargar total de docentes
            var docentesResponse = await Http.GetAsync("http://localhost:5015/api/Docente/total");
            if (docentesResponse.IsSuccessStatusCode)
            {
                var json = await docentesResponse.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<TotalDocentesResponse>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (result != null)
                {
                    totalDocentes = result.totalDocentes;
                }
            }

            // Cargar solicitudes pendientes
            var solicitudesResponse = await Http.GetAsync("http://localhost:5015/api/SolicitudAvanceRango");
            if (solicitudesResponse.IsSuccessStatusCode)
            {
                var solicitudesJson = await solicitudesResponse.Content.ReadAsStringAsync();
                var solicitudes = JsonSerializer.Deserialize<List<SolicitudAvanceRangoDto>>(solicitudesJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                solicitudesPendientes = solicitudes?.Count(s => s.Estado == "PENDIENTE") ?? 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando estadísticas: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }
}
