@using MyCleanApp.Client.DTOs
@using MyCleanApp.Client.Features.Docente.Services
@using MudBlazor
@inject DocenteService DocenteService
@inject ISnackbar Snackbar

<MudPaper Elevation="1" Class="pa-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6" Color="Color.Primary">
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" />
            Seguimiento de Promociones
        </MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" 
                   Color="Color.Primary" 
                   OnClick="CargarSolicitudes">
            Actualizar
        </MudButton>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Class="ml-3">Cargando solicitudes...</MudText>
        </div>
    }
    else if (solicitudes.Any())
    {
        <!-- Estadísticas rápidas -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4">
                    <MudCardContent Class="pb-2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Color="Color.Warning" Size="Size.Large" />
                            <div class="ml-3">
                                <MudText Typo="Typo.h6">@solicitudesPendientes</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Pendientes</MudText>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4">
                    <MudCardContent Class="pb-2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                            <div class="ml-3">
                                <MudText Typo="Typo.h6">@solicitudesAprobadas</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Aprobadas</MudText>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4">
                    <MudCardContent Class="pb-2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Large" />
                            <div class="ml-3">
                                <MudText Typo="Typo.h6">@solicitudesRechazadas</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Rechazadas</MudText>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4">
                    <MudCardContent Class="pb-2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" Size="Size.Large" />
                            <div class="ml-3">
                                <MudText Typo="Typo.h6">@solicitudes.Count</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total</MudText>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Tabla de solicitudes -->
        <MudTable Items="@solicitudes" Dense="true" Hover="true" Striped="true" Loading="@isLoading">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="SolicitudAvanceRangoDto" SortBy="@(x => x.FechaSolicitud)">
                        Fecha Solicitud
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>Promoción Solicitada</MudTh>
                <MudTh>
                    <MudTableSortLabel T="SolicitudAvanceRangoDto" SortBy="@(x => x.Estado)">
                        Estado
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>Progreso</MudTh>
                <MudTh>Fecha Respuesta</MudTh>
                <MudTh>Observaciones</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Fecha Solicitud">
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body2">@context.FechaSolicitud.ToString("dd/MM/yyyy")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.FechaSolicitud.ToString("HH:mm")</MudText>
                    </div>
                </MudTd>
                <MudTd DataLabel="Promoción Solicitada">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                        <div>
                            <MudText Typo="Typo.body2">Promoción a @ObtenerNombreNivelAcademico(context.NuevoNivelAcademicoId)</MudText>
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Color="@GetEstadoColor(context.Estado)" Size="Size.Small" Variant="Variant.Filled">
                        @GetEstadoTexto(context.Estado)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Progreso">
                    <div style="min-width: 280px;">
                        @{
                            var timelineSteps = GetTimelineSteps(context.Estado);
                        }
                        <!-- Timeline mejorado -->
                        <div class="timeline-vertical" style="position: relative; padding-left: 20px;">
                            @for (int i = 0; i < timelineSteps.Count; i++)
                            {
                                var step = timelineSteps[i];
                                <div class="timeline-step mb-2" style="position: relative;">
                                    <!-- Línea vertical conectora -->
                                    @if (i < timelineSteps.Count - 1)
                                    {
                                        <div style="position: absolute; left: -12px; top: 16px; width: 2px; height: 24px; 
                                                    background-color: @(step.IsCompleted ? "#4CAF50" : "#E0E0E0");"></div>
                                    }
                                    
                                    <!-- Marcador del paso -->
                                    <div style="position: absolute; left: -20px; top: 0; width: 16px; height: 16px; 
                                                border-radius: 50%; background: white; border: 2px solid @GetStepBorderColor(step);">
                                        @if (step.IsCompleted)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" 
                                                   Size="Size.Small" 
                                                   Style="font-size: 10px; margin: -2px; color: #4CAF50;" />
                                        }
                                        else if (step.IsCurrent)
                                        {
                                            <div style="width: 8px; height: 8px; border-radius: 50%; background: #2196F3; margin: 2px;"></div>
                                        }
                                    </div>
                                    
                                    <!-- Contenido del paso -->
                                    <div style="margin-left: 8px;">
                                        <MudText Typo="Typo.caption" 
                                               Style="@GetStepTextStyle(step)"
                                               Class="mb-0">
                                            @step.Title
                                        </MudText>
                                        
                                        @if (step.IsCurrent && !string.IsNullOrEmpty(step.ResponsibleEntity))
                                        {
                                            <MudText Typo="Typo.caption" 
                                                   Color="Color.Info" 
                                                   Style="font-size: 0.65rem; font-weight: 500;"
                                                   Class="d-flex align-center mt-1">
                                                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Small" Style="font-size: 12px;" Class="mr-1" />
                                                @step.ResponsibleEntity
                                            </MudText>
                                        }
                                        
                                        @if (step.IsCompleted && !string.IsNullOrEmpty(step.CompletedDate))
                                        {
                                            <MudText Typo="Typo.caption" 
                                                   Color="Color.Success" 
                                                   Style="font-size: 0.65rem;"
                                                   Class="mt-1">
                                                ✓ @step.CompletedDate
                                            </MudText>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Fecha Respuesta">
                    @if (context.FechaRespuesta.HasValue)
                    {
                        <div class="d-flex flex-column">
                            <MudText Typo="Typo.body2">@context.FechaRespuesta.Value.ToString("dd/MM/yyyy")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.FechaRespuesta.Value.ToString("HH:mm")</MudText>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Pendiente</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Observaciones">
                    @if (!string.IsNullOrEmpty(context.Observaciones))
                    {
                        <MudTooltip Text="@context.Observaciones">
                            <MudButton StartIcon="@Icons.Material.Filled.Comment" 
                                     Size="Size.Small" 
                                     Variant="Variant.Text"
                                     Color="Color.Info">
                                Ver
                            </MudButton>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Sin observaciones</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <div class="d-flex gap-2 flex-wrap">
                        <MudButton StartIcon="@Icons.Material.Filled.Visibility" 
                                 Size="Size.Small" 
                                 Color="Color.Primary"
                                 OnClick="@(() => VerDetalle(context))">
                            Detalle
                        </MudButton>
                        
                        @* Acciones para solicitudes decididas por la comisión *@
                        @if ((context.Estado == "DECIDIDO_APROBADA" || context.Estado == "DECIDIDO_RECHAZADA") && PuedeResponderDecision(context))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="ma-1" Style="font-size: 0.7rem;">
                                ⏰ @ObtenerDiasRestantesParaResponder(context) días para responder
                            </MudAlert>
                            
                            @if (context.Estado == "DECIDIDO_APROBADA")
                            {
                                <MudButton StartIcon="@Icons.Material.Filled.CheckCircle" 
                                         Size="Size.Small" 
                                         Color="Color.Success"
                                         OnClick="@(() => AceptarDecision(context))">
                                    Aceptar
                                </MudButton>
                            }
                            
                            @* Solo permitir apelación si fue rechazada *@
                            @if (context.Estado == "DECIDIDO_RECHAZADA")
                            {
                                <MudButton StartIcon="@Icons.Material.Filled.Gavel" 
                                         Size="Size.Small" 
                                         Color="Color.Warning"
                                         OnClick="@(() => AbrirModalApelacion(context))">
                                    Apelar
                                </MudButton>
                            }
                        }
                        
                        @* Apelación para solicitudes ya rechazadas definitivamente *@
                        @if (context.Estado == "RECHAZADA" && PuedeApelar(context))
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Gavel" 
                                     Size="Size.Small" 
                                     Color="Color.Warning"
                                     OnClick="@(() => AbrirModalApelacion(context))">
                                Apelar
                            </MudButton>
                        }
                        
                        @* Mostrar si la solicitud quedó sin efecto *@
                        @if (context.Estado == "SIN_EFECTO")
                        {
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                                Sin Efecto
                            </MudChip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudCard Elevation="0" Class="pa-6 text-center">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Secondary" Size="Size.Large" Class="mb-4" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">No hay solicitudes de promoción</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Aún no has realizado ninguna solicitud de promoción.
                </MudText>
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          StartIcon="@Icons.Material.Filled.Add"
                          OnClick="CrearNuevaSolicitud">
                    Nueva Solicitud
                </MudButton>
            </MudCardContent>
        </MudCard>
    }
</MudPaper>

<!-- Modal de Detalle -->
@if (mostrarModalDetalle && solicitudSeleccionada != null)
{
    <MudDialog IsVisible="@mostrarModalDetalle" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" />
                Detalle de Solicitud #@solicitudSeleccionada.Id
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">📋 Información General</MudText>
                        <div class="d-flex flex-column gap-2">
                            <div><strong>Fecha Solicitud:</strong> @solicitudSeleccionada.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</div>
                            <div><strong>Estado:</strong> 
                                <MudChip T="string" Color="@GetEstadoColor(solicitudSeleccionada.Estado)" Size="Size.Small">
                                    @GetEstadoTexto(solicitudSeleccionada.Estado)
                                </MudChip>
                            </div>
                            <div><strong>Promoción:</strong> Promoción a @ObtenerNombreNivelAcademico(solicitudSeleccionada.NuevoNivelAcademicoId)</div>
                            @if (solicitudSeleccionada.FechaRespuesta.HasValue)
                            {
                                <div><strong>Fecha Respuesta:</strong> @solicitudSeleccionada.FechaRespuesta.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                        </div>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">📈 Estado del Proceso</MudText>
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex flex-column">
                                <MudProgressLinear Color="@GetEstadoColor(solicitudSeleccionada.Estado)" 
                                                 Value="@GetProgresoValue(solicitudSeleccionada.Estado)" 
                                                 Size="Size.Medium" />
                                <MudText Typo="Typo.caption" Class="mt-1" Color="Color.Secondary">
                                    @GetProgresoTexto(solicitudSeleccionada.Estado)
                                </MudText>
                            </div>
                            @{
                                var etapas = GetEtapasProceso(solicitudSeleccionada.Estado);
                            }
                            @foreach (var etapa in etapas)
                            {
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@(etapa.Completada ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" 
                                           Color="@(etapa.Completada ? Color.Success : Color.Secondary)" 
                                           Size="Size.Small" 
                                           Class="mr-2" />
                                    <MudText Typo="Typo.body2" Color="@(etapa.Completada ? Color.Success : Color.Secondary)">
                                        @etapa.Nombre
                                    </MudText>
                                </div>
                            }
                        </div>
                    </MudCard>
                </MudItem>
                @if (!string.IsNullOrEmpty(solicitudSeleccionada.Observaciones))
                {
                    <MudItem xs="12">
                        <MudCard Elevation="1" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="mb-3">💬 Observaciones</MudText>
                            <MudText Typo="Typo.body2">@solicitudSeleccionada.Observaciones</MudText>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CerrarModalDetalle">Cerrar</MudButton>
            @if ((solicitudSeleccionada.Estado == "DECIDIDO_APROBADA" || solicitudSeleccionada.Estado == "DECIDIDO_RECHAZADA") && PuedeResponderDecision(solicitudSeleccionada))
            {
                @if (solicitudSeleccionada.Estado == "DECIDIDO_APROBADA")
                {
                    <MudButton StartIcon="@Icons.Material.Filled.CheckCircle" 
                             Color="Color.Success"
                             OnClick="@(() => AceptarDecision(solicitudSeleccionada))">
                        Aceptar Decisión
                    </MudButton>
                }
                @if (solicitudSeleccionada.Estado == "DECIDIDO_RECHAZADA")
                {
                    <MudButton StartIcon="@Icons.Material.Filled.Gavel" 
                             Color="Color.Warning"
                             OnClick="@(() => AbrirModalApelacion(solicitudSeleccionada))">
                        Presentar Apelación
                    </MudButton>
                }
            }
            @if (solicitudSeleccionada.Estado == "RECHAZADA" && PuedeApelar(solicitudSeleccionada))
            {
                <MudButton StartIcon="@Icons.Material.Filled.Gavel" 
                         Color="Color.Warning"
                         OnClick="@(() => AbrirModalApelacion(solicitudSeleccionada))">
                    Presentar Apelación
                </MudButton>
            }
        </DialogActions>
    </MudDialog>
}

<!-- Modal de Apelación -->
@if (mostrarModalApelacion && solicitudParaApelar != null)
{
    <MudDialog IsVisible="@mostrarModalApelacion" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" />
                Presentar Apelación - Solicitud #@solicitudParaApelar.Id
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        <MudText Typo="Typo.body2">
                            <strong>Tienes @ObtenerDiasRestantesParaResponder(solicitudParaApelar) días restantes</strong> para presentar tu apelación.
                            Una vez presentada, la Comisión tendrá 3 días para resolver y notificar el resultado.
                        </MudText>
                    </MudAlert>
                </MudItem>
                
                <MudItem xs="12">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">📋 Información de la Solicitud</MudText>
                        <div class="d-flex flex-column gap-2">
                            <div><strong>Estado Actual:</strong> 
                                <MudChip T="string" Color="@GetEstadoColor(solicitudParaApelar.Estado)" Size="Size.Small">
                                    @GetEstadoTexto(solicitudParaApelar.Estado)
                                </MudChip>
                            </div>
                            <div><strong>Promoción Solicitada:</strong> @ObtenerNombreNivelAcademico(solicitudParaApelar.NuevoNivelAcademicoId)</div>
                            <div><strong>Fecha de Decisión:</strong> @(solicitudParaApelar.FechaRespuesta?.ToString("dd/MM/yyyy HH:mm") ?? "No disponible")</div>
                            @if (!string.IsNullOrEmpty(solicitudParaApelar.Observaciones))
                            {
                                <div><strong>Observaciones de la Comisión:</strong></div>
                                <MudPaper Elevation="0" Class="pa-3" Style="background-color: #f5f5f5;">
                                    <MudText Typo="Typo.body2">@solicitudParaApelar.Observaciones</MudText>
                                </MudPaper>
                            }
                        </div>
                    </MudCard>
                </MudItem>
                
                <MudItem xs="12">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">📝 Motivos de la Apelación</MudText>
                        <MudTextField @bind-Value="motivosApelacion"
                                    Label="Describe los motivos de tu apelación"
                                    Variant="Variant.Outlined"
                                    Lines="5"
                                    MaxLength="1000"
                                    Counter="1000"
                                    HelperText="Explica claramente por qué consideras que la decisión debe ser reconsiderada"
                                    Required="true" />
                    </MudCard>
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CerrarModalApelacion">Cancelar</MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Send" 
                     Color="Color.Warning"
                     Disabled="@(string.IsNullOrWhiteSpace(motivosApelacion))"
                     OnClick="ConfirmarApelacion">
                Presentar Apelación
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private List<SolicitudAvanceRangoDto> solicitudes = new();
    private List<NivelAcademicoDto> nivelesAcademicos = new();
    private SolicitudAvanceRangoDto? solicitudSeleccionada = null;
    private SolicitudAvanceRangoDto? solicitudParaApelar = null;
    private bool isLoading = true;
    private bool mostrarModalDetalle = false;
    private bool mostrarModalApelacion = false;
    private string motivosApelacion = "";

    // Estadísticas
    private int solicitudesPendientes => solicitudes.Count(s => 
        s.Estado == "PENDIENTE" || s.Estado == "EN_VERIFICACION" || s.Estado == "EN_EVALUACION" || 
        s.Estado == "VERIFICADA" || s.Estado == "ENVIADA_COMISION" || s.Estado == "EN_ANALISIS_COMISION" ||
        s.Estado == "DECIDIDO_APROBADA" || s.Estado == "DECIDIDO_RECHAZADA" || s.Estado == "INFORMES_FINALES" || 
        s.Estado == "ENVIADA_CONSEJO");
    private int solicitudesAprobadas => solicitudes.Count(s => 
        s.Estado == "APROBADA_DOCENTE" || s.Estado == "APROBADA" || s.Estado == "EFECTIVA");
    private int solicitudesRechazadas => solicitudes.Count(s => 
        s.Estado == "RECHAZADA" || s.Estado == "APELACION_RECHAZADA");

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }

    private async Task CargarSolicitudes()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Cargar niveles académicos primero
            nivelesAcademicos = await DocenteService.ObtenerTodosLosNivelesAcademicosAsync() ?? new();

            var loginResponse = await DocenteService.GetLoginResponseAsync();
            if (loginResponse?.usuario != null)
            {
                var docenteId = await DocenteService.ObtenerDocenteIdPorUsuarioId(loginResponse.usuario.Id);
                if (docenteId.HasValue)
                {
                    solicitudes = await DocenteService.ObtenerSolicitudesAvancePorDocenteIdAsync(docenteId.Value) ?? new();
                    
                    // Verificar solicitudes que pueden haber quedado sin efecto
                    VerificarSolicitudesSinEfecto();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar solicitudes: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string ObtenerNombreNivelAcademico(int? nivelId)
    {
        if (!nivelId.HasValue)
            return "No especificado";
        
        var nivel = nivelesAcademicos.FirstOrDefault(n => n.Id == nivelId.Value);
        return nivel?.Nombre ?? $"Nivel ID: {nivelId}";
    }

    private async Task<string> ObtenerNivelActualDocente()
    {
        try
        {
            var loginResponse = await DocenteService.GetLoginResponseAsync();
            if (loginResponse?.usuario != null)
            {
                var docenteId = await DocenteService.ObtenerDocenteIdPorUsuarioId(loginResponse.usuario.Id);
                if (docenteId.HasValue)
                {
                    var dashboardData = await DocenteService.getDataDashBoard();
                    if (dashboardData != null)
                    {
                        // dashboardData.NivelAcademico ya es un string con el nombre del nivel
                        return dashboardData.NivelAcademico;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener nivel actual del docente: {ex.Message}");
        }
        return "No disponible";
    }

    private Color GetEstadoColor(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => Color.Warning,
            "EN_VERIFICACION" => Color.Info,
            "VERIFICADA" => Color.Info,
            "ENVIADA_COMISION" => Color.Info,
            "EN_EVALUACION" => Color.Primary,
