@page "/subir-publicacion"
@using MyCleanApp.Client.DTOs
@inject DocenteService DocenteService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudPaper Class="pa-6" Elevation="3">
        <!-- Header con botón de regreso -->
        <MudGrid>
            <MudItem xs="12">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Article" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">
                            Nueva Publicación Académica
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Primary" 
                              StartIcon="@Icons.Material.Filled.ArrowBack"
                              OnClick="VolverAlDashboard">
                        Volver al Dashboard
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            Completa el formulario para registrar una nueva publicación en el sistema.
        </MudText>

        <!-- Formulario -->
        <EditForm Model="@publicacion" OnValidSubmit="SubirPublicacion">
            <MudGrid Spacing="4">
                <!-- Título -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="publicacion.Titulo"
                                 Label="Título *"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 RequiredError="El título es requerido"
                                 Placeholder="Ej: Avances en Metodologías de Investigación" />
                </MudItem>

                <!-- Revista -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="publicacion.Revista"
                                 Label="Revista *"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 RequiredError="La revista es requerida"
                                 Placeholder="Ej: Revista Científica Internacional" />
                </MudItem>

                <!-- Volumen y Año -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="publicacion.Volumen"
                                 Label="Volumen"
                                 Variant="Variant.Outlined"
                                 Placeholder="Ej: 12(3)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="publicacion.Anio"
                                    Label="Año *"
                                    Variant="Variant.Outlined"
                                    Required="true"
                                    Min="1900"
                                    Max="2100"
                                    Step="1"
                                    RequiredError="El año es requerido"
                                    HelperText="Ej: 2024" />
                </MudItem>

                <!-- Tipo de publicación (MudSelect avanzado) -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                              @bind-Value="tipoSeleccionado"
                              Label="Tipo de Publicación *"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El tipo es requerido"
                              HelperText="Selecciona el tipo de publicación"
                              Dense="true"
                              Clearable="true">
                        <MudSelectItem Value="@("ninguno")">Selecciona un tipo...</MudSelectItem>
                        @foreach (var tipo in tiposPublicacion)
                        {
                            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Archivo PDF -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="1" Style="border: 2px dashed #ccc;">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" />
                                Archivo PDF
                            </MudText>
                            
                            @if (archivoSeleccionado != null)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Value="@archivoSeleccionado.Name">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" />
                                    @archivoSeleccionado.Name (@FormatFileSize(archivoSeleccionado.Size))
                                </MudChip>
                            }
                            
                            <InputFile OnChange="OnFileChange" class="mud-input-file" accept=".pdf" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Solo archivos PDF son permitidos. Tamaño máximo: 10MB.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <!-- Botones de acción -->
                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="3" Class="mt-4">
                        <MudButton Variant="Variant.Outlined" 
                                  Color="Color.Secondary"
                                  OnClick="VolverAlDashboard">
                            Cancelar
                        </MudButton>
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Primary"
                                  ButtonType="ButtonType.Submit"
                                  StartIcon="@Icons.Material.Filled.Save"
                                  Disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Publicación</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    PublicacionAcademicaRequest publicacion = new() { DocenteId = 1 };
    private IBrowserFile? archivoSeleccionado;
    private bool isSubmitting = false;
    private string tipoSeleccionado = "ninguno";
    private readonly string[] tiposPublicacion = new[]
    {
        "Artículo Científico",
        "Artículo de Revisión",
        "Artículo de Divulgación",
        "Ponencia en Congreso",
        "Libro",
        "Capítulo de Libro",
        "Reseña",
        "Informe Técnico",
        "Patente",
        "Tesis",
        "Memoria",
        "Otro"
    };

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        archivoSeleccionado = file;
        
        // Validar que sea un archivo PDF
        if (!file.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("❌ Error: Solo se permiten archivos PDF para el archivo.", Severity.Error);
            archivoSeleccionado = null;
            return;
        }
        
        // Validar tamaño del archivo (máximo 10MB)
        const int maxSizeInBytes = 10 * 1024 * 1024; // 10MB
        if (file.Size > maxSizeInBytes)
        {
            Snackbar.Add("❌ Error: El archivo es demasiado grande. Máximo permitido: 10MB.", Severity.Error);
            archivoSeleccionado = null;
            return;
        }
        
        try
        {
            using var stream = file.OpenReadStream(maxSizeInBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            publicacion.Archivo = Convert.ToBase64String(ms.ToArray());
            Snackbar.Add("✅ Archivo PDF cargado correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Error al procesar el archivo: {ex.Message}", Severity.Error);
            archivoSeleccionado = null;
        }
    }

    private async Task SubirPublicacion()
    {
        isSubmitting = true;
        try
        {
            // Validaciones básicas
            if (string.IsNullOrWhiteSpace(publicacion.Titulo))
            {
                Snackbar.Add("❌ Error: El título es requerido.", Severity.Error);
                return;
            }
            if (string.IsNullOrWhiteSpace(publicacion.Revista))
            {
                Snackbar.Add("❌ Error: La revista es requerida.", Severity.Error);
                return;
            }
            if (publicacion.Anio < 1900 || publicacion.Anio > 2100)
            {
                Snackbar.Add("❌ Error: El año debe estar entre 1900 y 2100.", Severity.Error);
                return;
            }
            if (string.IsNullOrWhiteSpace(tipoSeleccionado) || tipoSeleccionado == "ninguno")
            {
                Snackbar.Add("❌ Error: El tipo de publicación es requerido.", Severity.Error);
                return;
            }
            publicacion.Tipo = tipoSeleccionado;
            var ok = await DocenteService.SubirPublicacionAcademicaAsync(publicacion);
            if (ok)
            {
                Snackbar.Add("✅ Publicación subida con éxito.", Severity.Success);
                await Task.Delay(1500);
                VolverAlDashboard();
            }
            else
            {
                Snackbar.Add("❌ Error al subir la publicación.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
    private void VolverAlDashboard()
    {
        Navigation.NavigateTo("/teacher-dashboard");
    }
}