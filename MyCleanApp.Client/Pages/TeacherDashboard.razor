@using MyCleanApp.Client.components
@using MyCleanApp.Client.DTOs
@inject LocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject EvaluacionService EvaluacionService
@inject DocenteService DocenteService

@page "/teacher-dashboard"

@code {
    private void IrASubirPublicacion()
    {
        Navigation.NavigateTo("/subir-publicacion");
    }
    private LoginResponse? loginResponse;
    private DashBoardDocente? dashBoardDocente;
    private List<PublicacionAcademicaDto> publicacionesAcademicas = new();
    private List<ProyectoInvestigacionDto> proyectosInvestigacion = new();
    private List<Requirement> requirements = new();
    private string nextLevel = string.Empty;
    private string activeTab = "overview";
    private List<(string id, string label)> Tabs = new()
    {
        ("overview", "Resumen"),
        ("requirements", "Requisitos de Promoción"),
        ("papers", "Publicaciones"),
        ("training", "Capacitaciones"),
        ("research", "Investigación")
    };
    private async Task RecargarPublicacionesAcademicas()
    {
        var publicaciones = await DocenteService.getPublicacionesAcademicas();
        if (publicaciones != null)
        {
            publicacionesAcademicas = publicaciones.ToList();
            StateHasChanged();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        loginResponse = await LocalStorage.ObtenerObjetoAsync<LoginResponse>("loginResponse");
        if (loginResponse != null && loginResponse.usuario != null)
        {
            var dashboard = await DocenteService.getDataDashBoard();
            var publicaciones = await DocenteService.getPublicacionesAcademicas();
            var proyectos = await DocenteService.GetProyectosInvestigacionAsync();
            if (dashboard != null)
            {
                dashBoardDocente = dashboard;
                if (publicaciones != null)
                {
                    publicacionesAcademicas = publicaciones.ToList();
                }
                if (proyectos != null)
                {
                    proyectosInvestigacion = proyectos;
                }
                // Calcular meses de investigación sumando los meses de todos los proyectos
                int mesesInvestigacion = 0;
                if (proyectosInvestigacion != null && proyectosInvestigacion.Count > 0)
                {
                    foreach (var proyecto in proyectosInvestigacion)
                    {
                        var inicio = proyecto.FechaInicio;
                        var fin = proyecto.FechaFin;
                        int meses = (fin.Year - inicio.Year) * 12 + (fin.Month - inicio.Month);
                        if (meses < 0) meses = 0;
                        mesesInvestigacion += meses;
                    }
                }
                // Get next academic level ID for requirements calculation
                var nivelActual = dashBoardDocente.NivelAcademico;
                var prefijo = nivelActual.Substring(0, nivelActual.Length - 1);
                var numero = int.TryParse(nivelActual.Substring(nivelActual.Length - 1), out var n) ? n : 1;
                nextLevel = numero < 5 ? $"{prefijo}{numero + 1}" : nivelActual;
                
                Console.WriteLine($"Nivel actual: {nivelActual}, Siguiente nivel: {nextLevel}");
                
                // Get docente ID for requirements calculation
                var docenteId = await DocenteService.ObtenerDocenteIdPorUsuarioId(loginResponse.usuario.Id);
                var siguienteNivelId = await DocenteService.ObtenerNivelAcademicoIdPorNombreAsync(nextLevel);
                
                Console.WriteLine($"DocenteId: {docenteId}, SiguienteNivelId: {siguienteNivelId}");
                
                if (docenteId.HasValue && siguienteNivelId.HasValue)
                {
                    // Calculate requirements dynamically from backend
                    Console.WriteLine($"Llamando CalcularRequisitosPorNivelAsync con docenteId={docenteId.Value}, nivelId={siguienteNivelId.Value}");
                    requirements = await DocenteService.CalcularRequisitosPorNivelAsync(docenteId.Value, siguienteNivelId.Value);
                    Console.WriteLine($"Requisitos calculados: {requirements?.Count ?? 0}");
                    
                    if (requirements != null && requirements.Count > 0)
                    {
                        foreach (var req in requirements)
                        {
                            Console.WriteLine($"Requisito: {req.Name}, Actual: {req.Current}, Requerido: {req.Required}, Cumplido: {req.Completed}");
                        }
                    }
                }
                else
                {
                    Console.WriteLine($"No se pudo obtener docenteId o siguienteNivelId. DocenteId: {docenteId}, SiguienteNivelId: {siguienteNivelId}");
                }
                
                // Si no hay requisitos, crear algunos de fallback para testing
                if (requirements == null || requirements.Count == 0)
                {
                    Console.WriteLine("No se encontraron requisitos, creando fallback...");
                    requirements = new List<Requirement>
                    {
                        new Requirement 
                        { 
                            Name = "Años en nivel actual", 
                            Current = dashBoardDocente.AniosEnNivel, 
                            Required = 3, 
                            Completed = dashBoardDocente.AniosEnNivel >= 3 
                        },
                        new Requirement 
                        { 
                            Name = "Publicaciones académicas", 
                            Current = dashBoardDocente.PublicacionesAcademicas, 
                            Required = 2, 
                            Completed = dashBoardDocente.PublicacionesAcademicas >= 2 
                        },
                        new Requirement 
                        { 
                            Name = "Puntaje de evaluación", 
                            Current = (int)dashBoardDocente.PuntajeEvaluacion, 
                            Required = 85, 
                            Completed = dashBoardDocente.PuntajeEvaluacion >= 85 
                        },
                        new Requirement 
                        { 
                            Name = "Horas de capacitación", 
                            Current = dashBoardDocente.HorasCapacitacion, 
                            Required = 40, 
                            Completed = dashBoardDocente.HorasCapacitacion >= 40 
                        },
                        new Requirement 
                        { 
                            Name = "Meses en investigación", 
                            Current = 0, // Se calculará en el componente
                            Required = 6, 
                            Completed = false 
                        }
                    };
                }
            }
            else
            {
                Console.WriteLine("No se pudo obtener el dashboard.");
            }
        }
        else
        {
            Console.WriteLine("No login, redirigiendo...");
            Navigation.NavigateTo("/login", true);
        }
    }

    private double progressPercentage => requirements.Count == 0 ? 0 : (requirements.Count(r => r.Completed) * 100.0 / requirements.Count);
}

@if (dashBoardDocente == null)
{
    <div class="text-center py-8 text-gray-500">Cargando datos...</div>
}
else
{
<div class="container mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row items-start justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-bold">
                Bienvenido, @(loginResponse?.usuario?.Nombre ?? "Usuario")
            </h1>
            <p class="text-gray-600 mt-1">
                Nivel actual:
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border border-gray-300 bg-blue-50 text-gray-700 ml-1 font-semibold">
                    @dashBoardDocente.NivelAcademico
                </span>
            </p>
        </div>
        <div class="flex gap-2">
            <button class="border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-md transition-colors">
                Mi Perfil
            </button>
            <button class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
                Mis Documentos
            </button>
        </div>
    </div>
    <div class="space-y-4">
        <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8">
                @foreach (var tab in Tabs)
                {
                    <button @onclick="() => activeTab = tab.id"
                            class="py-2 px-1 border-b-2 font-medium text-sm @(activeTab == tab.id ? "border-blue-500 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                        @tab.label
                    </button>
                }
            </nav>
        </div>
        @if (activeTab == "overview")
        {
            <div class="space-y-4">
                <div class="border rounded-lg p-4 @(progressPercentage == 100 ? "border-green-500 bg-green-50" : "border-amber-500 bg-amber-50")">
                    <div class="flex">
                        <svg class="h-5 w-5 @(progressPercentage == 100 ? "text-green-500" : "text-amber-500")"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                        </svg>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium">
                                @{
                                    // Calcular el siguiente nivel
                                    var nivelActual = dashBoardDocente.NivelAcademico;
                                    var prefijo = nivelActual.Substring(0, nivelActual.Length - 1);
                                    var numero = int.TryParse(nivelActual.Substring(nivelActual.Length - 1), out var n) ? n : 1;
                                    var siguienteNivel = numero < 5 ? $"{prefijo}{numero + 1}" : nivelActual;

                                    // Usar la lista unificada de requirements para el conteo
                                    var requisitosCumplidos = requirements.Count(r => r.Completed);
                                    var totalRequisitos = requirements.Count;

                                    var mensaje = requisitosCumplidos == totalRequisitos
                                        ? $"¡Felicidades! Cumples con todos los requisitos para avanzar a {siguienteNivel}"
                                        : $"Progreso hacia {siguienteNivel}";
                                }
                                @mensaje
                            </h3>
                            <div class="mt-2 text-sm">
                                Has completado @requisitosCumplidos de @totalRequisitos requisitos necesarios para avanzar al siguiente nivel.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
                        <div class="p-4 pb-2">
                            <div class="flex items-center text-sm font-medium text-gray-600">
                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                Años en nivel actual
                            </div>
                        </div>
                        <div class="p-4 pt-0">
                            <div class="text-2xl font-bold">
                                @dashBoardDocente.AniosEnNivel / @dashBoardDocente.GetValorRequerido("Años en el rango")
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                                <div class="bg-blue-600 h-2 rounded-full transition-all duration-300"
                                    style="width: @(Math.Min((double)dashBoardDocente.AniosEnNivel / dashBoardDocente.GetValorRequerido("Años en el rango") * 100, 100))%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
                        <div class="p-4 pb-2">
                            <div class="flex items-center text-sm font-medium text-gray-600">
                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                Publicaciones académicas
                            </div>
                        </div>
                        <div class="p-4 pt-0">
                            <div class="text-2xl font-bold">
                                @dashBoardDocente.PublicacionesAcademicas / @dashBoardDocente.GetValorRequerido("Papers")
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                                <div class="bg-blue-600 h-2 rounded-full transition-all duration-300"
                                    style="width: @(Math.Min((double)dashBoardDocente.PublicacionesAcademicas / dashBoardDocente.GetValorRequerido("Papers") * 100, 100))%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
                        <div class="p-4 pb-2">
                            <div class="flex items-center text-sm font-medium text-gray-600">
                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                                </svg>
                                Puntaje de evaluación
                            </div>
                        </div>
                        <div class="p-4 pt-0">
                            @{
                                var puntajeActual = dashBoardDocente.PuntajeEvaluacion==0?1:dashBoardDocente.PuntajeEvaluacion;
                                Console.Write("el puntaje actual es :"+puntajeActual);
                                var puntajeRequerido = dashBoardDocente.GetValorRequerido("Puntaje Evaluación");
                                Console.Write("el puntaje es :"+puntajeRequerido);
                                var porcentaje = puntajeRequerido == 0 ? 1 : Math.Min(puntajeActual / puntajeRequerido* 100, 100);
                            }
                            <div class="text-2xl font-bold">
                                @puntajeActual% / @puntajeRequerido%
                            </div>
                            <div class="w-full bg-green-100 rounded-full h-2 mt-2">
                                <div class="bg-green-600 h-2 rounded-full transition-all duration-300"
                                    style="width: @porcentaje%;"></div>
                            </div>
                       </div>
                    </div>

                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
                        <div class="p-4 pb-2">
                            <div class="flex items-center text-sm font-medium text-gray-600">
                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Horas de capacitación
                            </div>
                        </div>
                        <div class="p-4 pt-0">
                            <div class="text-2xl font-bold">
                                @dashBoardDocente.HorasCapacitacion / @dashBoardDocente.GetValorRequerido("Horas Capacitación")
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                                <div class="bg-blue-600 h-2 rounded-full transition-all duration-300"
                                    style="width: @(Math.Min((double)dashBoardDocente.HorasCapacitacion / dashBoardDocente.GetValorRequerido("Horas Capacitación") * 100, 100))%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
                        <div class="p-4 pb-2">
                            <div class="flex items-center text-sm font-medium text-gray-600">
                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Meses en investigación
                            </div>
                        </div>
                        <div class="p-4 pt-0">
@{
    int mesesInvestigacion = 0;
    if (proyectosInvestigacion != null && proyectosInvestigacion.Count > 0)
    {
        foreach (var proyecto in proyectosInvestigacion)
        {
            var inicio = proyecto.FechaInicio;
            var fin = proyecto.FechaFin;
            int meses = (fin.Year - inicio.Year) * 12 + (fin.Month - inicio.Month);
            if (meses < 0) meses = 0;
            mesesInvestigacion += meses;
        }
    }
    int requerido = dashBoardDocente.GetValorRequerido("Investigaciones");
    if (requerido == -1 || requerido == 0) requerido = 4;
    double porcentajeInvestigacion = 0;
    if (requerido > 0)
    {
        porcentajeInvestigacion = Math.Min((double)mesesInvestigacion / requerido * 100, 100);
    }
    
    <div class="text-2xl font-bold">
        @mesesInvestigacion / @requerido meses
    </div>
    <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
        <div class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: @(porcentajeInvestigacion.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
    </div>
}
    </div>
</div>
                </div>

            </div>  
        }

        @if (activeTab == "requirements")
        {
            <RequisitoPromocion />
        }

       @if (activeTab == "papers")
        {
            <TeacherDashboardPapers PublicacionesAcademicas="publicacionesAcademicas" OnImportarCompletado="RecargarPublicacionesAcademicas" />
        }
        @if (activeTab == "training")
        {
            <TeacherDashboardTraining  
                TrainingHours="@dashBoardDocente.HorasCapacitacion"
                RequiredHours="@dashBoardDocente.GetValorRequerido("Horas Capacitación")" />
        }

        @if (activeTab == "research")
        {
            <div class="flex justify-end mb-4">
        </div>
    <MyCleanApp.Client.components.TeacherDashboardResearch ProyectosInvestigacion="proyectosInvestigacion" />
        }
    </div>
</div>
}