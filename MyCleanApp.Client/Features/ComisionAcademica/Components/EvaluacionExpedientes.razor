@using MudBlazor
@using MyCleanApp.Client.DTOs
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudPaper Elevation="1" Class="pa-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">Expedientes para Análisis</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" 
                   Color="Color.Primary" 
                   OnClick="CargarSolicitudes">
            Actualizar
        </MudButton>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (solicitudes != null && solicitudes.Any(s => s.Estado == "APROBADA_COMICION"))
    {
        <MudTable Items="@(solicitudes.Where(s => s.Estado == "APROBADA_COMICION"))" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Docente</MudTh>
                <MudTh>Nivel Actual</MudTh>
                <MudTh>Nivel Solicitado</MudTh>
                <MudTh>Fecha Solicitud</MudTh>
                <MudTh>Estado</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Docente">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                        @context.DocenteNombre
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Nivel Actual">@context.NivelActual</MudTd>
                <MudTd DataLabel="Nivel Solicitado">@context.NuevoNivel</MudTd>
                <MudTd DataLabel="Fecha Solicitud">@context.FechaSolicitud.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">
                        @context.Estado
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            No hay expedientes pendientes de análisis en este momento.
        </MudAlert>
    }
</MudPaper>

@code {
    private bool isLoading = true;
    private List<SolicitudAvanceRangoDto> solicitudes = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }

    private async Task CargarSolicitudes()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetAsync("http://localhost:5015/api/SolicitudAvanceRango");
            if (response.IsSuccessStatusCode)
            {
                solicitudes = await response.Content.ReadFromJsonAsync<List<SolicitudAvanceRangoDto>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar solicitudes: {ex.Message}", Severity.Error);
        }
        isLoading = false;
        StateHasChanged();
    }
}