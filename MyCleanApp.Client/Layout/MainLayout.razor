@namespace MyCleanApp.Client.Layout
@inherits LayoutComponentBase

<div class="page">
    <main class="main-content">
        <article class="content">
            @Body
        </article>
    </main>
</div>

<style>
    .page {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .main-content {
        flex: 1;
    }

    .content {
        padding: 0;
        width: 100%;
    }
</style>
