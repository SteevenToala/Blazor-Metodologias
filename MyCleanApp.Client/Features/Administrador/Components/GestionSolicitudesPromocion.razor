@using MyCleanApp.Client.Features.Shared.Services
@using MyCleanApp.Client.DTOs
@using MudBlazor
@using MyCleanApp.Client.Features.Administrador.Components
@inject SolicitudPromocionService SolicitudService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Class="pa-6" Elevation="4">
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="8">
            <div class="d-flex align-center">
                <MudIcon Icon="Icons.Material.Filled.Assignment" Color="Color.Primary" Size="Size.Large" Class="mr-3" />
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">Gestión de Solicitudes de Promoción</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Administración de solicitudes de avance académico</MudText>
                </div>
            </div>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      StartIcon="Icons.Material.Filled.Refresh"
                      OnClick="CargarSolicitudes"
                      Disabled="isLoading">
                Actualizar
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudTabs Elevation="4" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Primary">
        <MudTabPanel Text="Lista de Solicitudes" Icon="Icons.Material.Filled.List">
            @if (isLoading)
            {
                <div class="d-flex justify-center pa-8">
                    <div class="d-flex flex-column align-center">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                        <MudText Typo="Typo.body2" Class="mt-3" Color="Color.Secondary">Cargando solicitudes...</MudText>
                    </div>
                </div>
            }
            else if (solicitudes == null || !solicitudes.Any())
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    <div class="d-flex align-center">
                        <MudIcon Icon="Icons.Material.Filled.Info" Class="mr-2" />
                        <span>No hay solicitudes de promoción pendientes.</span>
                    </div>
                </MudAlert>
            }
            else
            {
        <MudDataGrid T="SolicitudPromocionDto" 
                     Items="@solicitudes" 
                     Filterable="true" 
                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                     SortMode="SortMode.Multiple" 
                     Groupable="false"
                     Hover="true"
                     RowStyleFunc="@GetRowStyle"
                     Elevation="2"
                     Class="mud-elevation-4">
            
            <Columns>
                <PropertyColumn Property="x => x.DocenteNombre" Title="Docente">
                    <CellTemplate>
                        <div class="d-flex align-center">
                            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-3">
                                @(context.Item.DocenteNombre.Split(' ').FirstOrDefault()?.Substring(0, 1).ToUpper())
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body1" Class="font-weight-medium">@context.Item.DocenteNombre</MudText>
                            </div>
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.NivelActual" Title="Nivel Actual">
                    <CellTemplate>
                        <MudChip Color="Color.Default" Size="Size.Small" Text="@context.Item.NivelActual" />
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.NuevoNivel" Title="Nivel Solicitado">
                    <CellTemplate>
                        <MudChip Color="Color.Primary" Size="Size.Small" Text="@context.Item.NuevoNivel" />
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.FechaSolicitud" Title="Fecha Solicitud" Format="dd/MM/yyyy" />

                <PropertyColumn Property="x => x.Estado" Title="Estado">
                    <CellTemplate>
                        <MudChip Color="@GetEstadoColor(context.Item.Estado)" 
                                Size="Size.Small" 
                                Text="@context.Item.Estado"
                                Icon="@GetEstadoIcon(context.Item.Estado)" />
                    </CellTemplate>
                </PropertyColumn>

                <TemplateColumn Title="Acciones" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.Estado == "PENDIENTE")
                        {
                            <div class="d-flex gap-2">
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Success" 
                                          Size="Size.Small"
                                          StartIcon="Icons.Material.Filled.Check"
                                          OnClick="() => MostrarModalAprobacion(context.Item)"
                                          Disabled="isProcessing">
                                    Aprobar
                                </MudButton>
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Error" 
                                          Size="Size.Small"
                                          StartIcon="Icons.Material.Filled.Close"
                                          OnClick="() => MostrarModalRechazo(context.Item)"
                                          Disabled="isProcessing">
                                    Rechazar
                                </MudButton>
                            </div>
                        }
                        else
                        {
                            @if (context.Item.FechaRespuesta.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Procesada: @context.Item.FechaRespuesta.Value.ToString("dd/MM/yyyy")
                                </MudText>
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
            }
        </MudTabPanel>
        
        <MudTabPanel Text="Gestión de Workflow" Icon="Icons.Material.Filled.Workflow">
            <WorkflowPromocionPanel />
        </MudTabPanel>
    </MudTabs>
</MudPaper>

<!-- Modal de Aprobación -->
@if (showAprobacionModal && solicitudSeleccionada != null)
{
    <MudDialog Visible="showAprobacionModal" Options="@dialogOptions">
        <TitleContent>
            <div class="d-flex align-center">
                <MudIcon Icon="Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-3" />
                <MudText Typo="Typo.h6">Aprobar Promoción</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <div class="mb-4">
                <MudText><strong>Docente:</strong> @solicitudSeleccionada.DocenteNombre</MudText>
                <MudText><strong>Promoción:</strong> @solicitudSeleccionada.NivelActual → @solicitudSeleccionada.NuevoNivel</MudText>
            </div>
            
            <MudTextField Label="Observaciones (opcional)" 
                         @bind-Value="observacionesAprobacion" 
                         Variant="Variant.Outlined" 
                         Lines="3"
                         Placeholder="Comentarios sobre la aprobación..."
                         FullWidth="true" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CerrarModales" Variant="Variant.Text">Cancelar</MudButton>
            <MudButton OnClick="AprobarSolicitud" 
                      Variant="Variant.Filled" 
                      Color="Color.Success"
                      StartIcon="Icons.Material.Filled.Check"
                      Disabled="isProcessing">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Confirmar Aprobación
            </MudButton>
        </DialogActions>
    </MudDialog>
}

<!-- Modal de Rechazo -->
@if (showRechazoModal && solicitudSeleccionada != null)
{
    <MudDialog Visible="showRechazoModal" Options="@dialogOptions">
        <TitleContent>
            <div class="d-flex align-center">
                <MudIcon Icon="Icons.Material.Filled.Cancel" Color="Color.Error" Class="mr-3" />
                <MudText Typo="Typo.h6">Rechazar Promoción</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <div class="mb-4">
                <MudText><strong>Docente:</strong> @solicitudSeleccionada.DocenteNombre</MudText>
                <MudText><strong>Promoción:</strong> @solicitudSeleccionada.NivelActual → @solicitudSeleccionada.NuevoNivel</MudText>
            </div>
            
            <MudTextField Label="Motivo del rechazo *" 
                         @bind-Value="motivoRechazo" 
                         Variant="Variant.Outlined" 
                         Lines="3"
                         Placeholder="Explique las razones del rechazo..."
                         Required="true"
                         RequiredError="El motivo del rechazo es obligatorio"
                         FullWidth="true" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CerrarModales" Variant="Variant.Text">Cancelar</MudButton>
            <MudButton OnClick="RechazarSolicitud" 
                      Variant="Variant.Filled" 
                      Color="Color.Error"
                      StartIcon="Icons.Material.Filled.Close"
                      Disabled="@(isProcessing || string.IsNullOrWhiteSpace(motivoRechazo))">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Confirmar Rechazo
            </MudButton>
        </DialogActions>
    </MudDialog>
}



@code {
    private List<SolicitudPromocionDto>? solicitudes;
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showAprobacionModal = false;
    private bool showRechazoModal = false;
    private SolicitudPromocionDto? solicitudSeleccionada;
    private string observacionesAprobacion = "";
    private string motivoRechazo = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }

    private async Task CargarSolicitudes()
    {
        isLoading = true;
        try
        {
            solicitudes = await SolicitudService.ObtenerSolicitudesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar solicitudes: {ex.Message}");
            Snackbar.Add("Error al cargar las solicitudes", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void MostrarModalAprobacion(SolicitudPromocionDto solicitud)
    {
        solicitudSeleccionada = solicitud;
        observacionesAprobacion = "";
        showAprobacionModal = true;
    }

    private void MostrarModalRechazo(SolicitudPromocionDto solicitud)
    {
        solicitudSeleccionada = solicitud;
        motivoRechazo = "";
        showRechazoModal = true;
    }

    private void CerrarModales()
    {
        showAprobacionModal = false;
        showRechazoModal = false;
        solicitudSeleccionada = null;
        observacionesAprobacion = "";
        motivoRechazo = "";
    }

    private async Task AprobarSolicitud()
    {
        if (solicitudSeleccionada == null) return;

        isProcessing = true;
        try
        {
            var success = await SolicitudService.AprobarSolicitudAsync(
                solicitudSeleccionada.Id, 
                observacionesAprobacion);

            if (success)
            {
                Snackbar.Add("Solicitud aprobada exitosamente. El docente ha sido promovido y su evaluación ha sido reiniciada.", Severity.Success);
                CerrarModales();
                await CargarSolicitudes();
            }
            else
            {
                Snackbar.Add("Error al aprobar la solicitud", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al aprobar solicitud: {ex.Message}");
            Snackbar.Add("Error al procesar la aprobación", Severity.Error);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RechazarSolicitud()
    {
        if (solicitudSeleccionada == null || string.IsNullOrWhiteSpace(motivoRechazo)) return;

        isProcessing = true;
        try
        {
            var success = await SolicitudService.RechazarSolicitudAsync(
                solicitudSeleccionada.Id, 
                motivoRechazo);

            if (success)
            {
                Snackbar.Add("Solicitud rechazada.", Severity.Success);
                CerrarModales();
                await CargarSolicitudes();
            }
            else
            {
                Snackbar.Add("Error al rechazar la solicitud", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al rechazar solicitud: {ex.Message}");
            Snackbar.Add("Error al procesar el rechazo", Severity.Error);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private string GetRowStyle(SolicitudPromocionDto item, int index)
    {
        return item.Estado switch
        {
            "PENDIENTE" => "background-color: rgba(255, 193, 7, 0.1);",
            "APROBADA" => "background-color: rgba(25, 135, 84, 0.1);",
            "RECHAZADA" => "background-color: rgba(220, 53, 69, 0.1);",
            _ => ""
        };
    }

    private Color GetEstadoColor(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => Color.Warning,
            "APROBADA" => Color.Success,
            "RECHAZADA" => Color.Error,
            _ => Color.Default
        };
    }

    private string GetEstadoIcon(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => Icons.Material.Filled.HourglassEmpty,
            "APROBADA" => Icons.Material.Filled.CheckCircle,
            "RECHAZADA" => Icons.Material.Filled.Cancel,
            _ => Icons.Material.Filled.Help
        };
    }

    private DialogOptions dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    private string GetEstadoBadgeClass(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => "warning",
            "APROBADA" => "success",
            "RECHAZADA" => "danger",
            _ => "secondary"
        };
    }
}
